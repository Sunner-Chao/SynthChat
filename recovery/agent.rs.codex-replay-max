    }
    record_agent_stage(
        store,
        app,
        run,
        "llm_failover",
        json!({
            "phase": phase,
            "iteration": iteration,
            "finalProviderId": reply.provider_id,
            "failedProviders": reply.failover_attempts.iter().map(|failure| json!({
                "providerId": failure.provider_id,
                "kind": failure.kind,
                "message": truncate_for_prompt(&failure.message, 500),
            })).collect::<Vec<_>>(),
        }),
    )
}

fn format_llm_failures(operation: &str, failures: &[LlmFailure]) -> String {
    if failures.is_empty() {
        return format!("{operation} failed: no provider candidates");
    }
    let details = failures
        .iter()
        .map(|failure| {
            format!(
                "{} [{}]: {}",
                failure.provider_id,
                failure.kind,
                truncate_for_prompt(&failure.message, 500)
            )
        })
        .collect::<Vec<_>>()
        .join("; ");
    format!("{operation} failed after {} provider attempt(s): {details}", failures.len())
}

