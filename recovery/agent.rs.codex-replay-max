async fn execute_internal_process(
    store: &AppStore,
    agent: &AgentDefinition,
    payload: &Value,
) -> AppResult<(String, Value)> {
    let action = payload
        .get("action")
        .and_then(Value::as_str)
        .unwrap_or("list")
        .trim()
        .to_ascii_lowercase();
    match action.as_str() {
        "" | "list" => {
            let processes = store.managed_processes()?;
            Ok((
                format_process_tool_text("process list", &json!({"processes": processes})),
                json!({"ok": true, "action": "list", "processes": processes}),
            ))
        }
        "status" | "read" | "logs" => {
            let process_id =
                string_arg(payload, &["processId", "process_id", "id"]).ok_or_else(|| {
                    AppError::BadRequest("process status/read requires processId/id.".into())
                })?;
            let state = store.managed_process_state(&process_id)?;
            Ok((
                format_process_tool_text("process status", &state),
                json!({"ok": true, "action": action, "process": state}),
            ))
        }
        "stop" | "kill" => {
            let process_id =
                string_arg(payload, &["processId", "process_id", "id"]).ok_or_else(|| {
                    AppError::BadRequest("process stop requires processId/id.".into())
                })?;
            let forget = payload
                .get("forget")
                .and_then(Value::as_bool)
                .unwrap_or(false);
            let state = store.stop_managed_process(&process_id, forget)?;
            Ok((
                format_process_tool_text("process stop", &state),
                json!({"ok": true, "action": "stop", "process": state}),
            ))
        }
        "start" | "run" | "spawn" => start_internal_process(store, agent, payload).await,
        other => Err(AppError::BadRequest(format!(
            "unknown process action: {other}"
        ))),
    }
}

async fn start_internal_process(
    store: &AppStore,
    agent: &AgentDefinition,
    payload: &Value,
) -> AppResult<(String, Value)> {
    let command_text = string_arg(payload, &["command", "cmd", "script"]);
    let program = string_arg(payload, &["program", "exe", "binary"]);
    if command_text.is_none() && program.is_none() {
        return Err(AppError::BadRequest(
            "process start requires command/cmd/script or program.".into(),
        ));
    }
    let cwd = Some(resolve_file_workspace(agent, payload)?);
    let mut command = if let Some(program) = program.clone() {
        let mut command = TokioCommand::new(program);
        if let Some(args) = payload.get("args").and_then(Value::as_array) {
            command.args(args.iter().filter_map(Value::as_str));
        }
        command
    } else if cfg!(target_os = "windows") {
        let mut command = TokioCommand::new("powershell");
        command.args(["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]);
        command.arg(command_text.as_deref().unwrap_or_default());
        command
    } else {
        let mut command = TokioCommand::new("sh");
        command.args(["-lc", command_text.as_deref().unwrap_or_default()]);
        command
    };
    if let Some(cwd) = cwd.as_deref() {
        command.current_dir(cwd);
    }
    let mut child = command
        .stdin(Stdio::null())
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .kill_on_drop(false)
        .spawn()
        .map_err(|error| AppError::BadRequest(format!("failed to start process: {error}")))?;
    let stdout = Arc::new(Mutex::new(Vec::new()));
    let stderr = Arc::new(Mutex::new(Vec::new()));
    if let Some(out) = child.stdout.take() {
        let buffer = stdout.clone();
        tokio::spawn(async move {
            let mut lines = BufReader::new(out).lines();
            while let Ok(Some(line)) = lines.next_line().await {
                push_process_log_line(&buffer, line);
            }
        });
    }
    if let Some(err) = child.stderr.take() {
        let buffer = stderr.clone();
        tokio::spawn(async move {
            let mut lines = BufReader::new(err).lines();
            while let Ok(Some(line)) = lines.next_line().await {
                push_process_log_line(&buffer, line);
            }
        });
    }
    let display_command = if let Some(command_text) = command_text {
        command_text
    } else {
        let args = payload
            .get("args")
            .and_then(Value::as_array)
            .map(|args| {
                args.iter()
                    .filter_map(Value::as_str)
                    .collect::<Vec<_>>()
                    .join(" ")
            })
            .unwrap_or_default();
        format!("{} {}", program.unwrap_or_default(), args).trim().to_string()
    };
    let id = string_arg(payload, &["processId", "process_id", "id"])
        .unwrap_or_else(|| new_id("proc"));
    let label = string_arg(payload, &["label", "name"]).unwrap_or_else(|| {
        truncate_for_prompt(
            if display_command.trim().is_empty() {
                "process"
            } else {
                display_command.trim()
            },
            80,
        )
    });
    let pid = child.id();
    let process = ManagedProcess {
        id: id.clone(),
        label,
        command: display_command,
        cwd: cwd.as_ref().map(|path| path.display().to_string()),
        pid,
        started_at: now_iso(),
        stdout,
        stderr,
        child,
    };
    let state = store.register_managed_process(process)?;
    Ok((
        format_process_tool_text("process start", &state),
        json!({"ok": true, "action": "start", "process": state}),
    ))
}

fn push_process_log_line(target: &Arc<Mutex<Vec<String>>>, line: String) {
    let Ok(mut lines) = target.lock() else {
        return;
    };
    lines.push(truncate_for_prompt(&line, 4000));
    let keep_from = lines.len().saturating_sub(400);
    if keep_from > 0 {
        lines.drain(0..keep_from);
    }
}

fn format_process_tool_text(title: &str, raw: &Value) -> String {
    let process = raw.get("process").unwrap_or(raw);
    if let Some(processes) = raw.get("processes").and_then(Value::as_array) {
        if processes.is_empty() {
            return format!("{title}: no managed processes.");
        }
        let rows = processes
            .iter()
            .map(format_process_summary_line)
            .collect::<Vec<_>>()
            .join("\n");
        return format!("{title}:\n{rows}");
    }
    let mut text = format!("{}: {}", title, format_process_summary_line(process));
    if let Some(stdout) = process.get("stdoutTail").and_then(Value::as_array) {
        if !stdout.is_empty() {
            let tail = stdout
                .iter()
                .filter_map(Value::as_str)
                .rev()
                .take(40)
                .collect::<Vec<_>>()
                .into_iter()
                .rev()
                .collect::<Vec<_>>()
                .join("\n");
            text.push_str("\n\nstdout tail:\n");
            text.push_str(&tail);
        }
    }
    if let Some(stderr) = process.get("stderrTail").and_then(Value::as_array) {
        if !stderr.is_empty() {
            let tail = stderr
                .iter()
                .filter_map(Value::as_str)
                .rev()
                .take(40)
                .collect::<Vec<_>>()
                .into_iter()
                .rev()
                .collect::<Vec<_>>()
                .join("\n");
            text.push_str("\n\nstderr tail:\n");
            text.push_str(&tail);
        }
    }
    text
}

fn format_process_summary_line(process: &Value) -> String {
    format!(
        "{} [{}] pid={} cwd={} cmd={}",
        process
            .get("id")
            .and_then(Value::as_str)
            .unwrap_or("unknown"),
        process
            .get("status")
            .and_then(Value::as_str)
            .unwrap_or("unknown"),
        process
            .get("pid")
            .and_then(Value::as_u64)
            .map(|pid| pid.to_string())
            .unwrap_or_else(|| "-".into()),
        process
            .get("cwd")
            .and_then(Value::as_str)
            .unwrap_or("-"),
        process
            .get("command")
            .and_then(Value::as_str)
            .unwrap_or("")
    )
}

