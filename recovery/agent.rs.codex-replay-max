async fn complete_chat_with_failover(
    store: &AppStore,
    preferred_provider: &LlmProvider,
    persona: &Persona,
    system_prompt: String,
    history: Vec<ChatMessage>,
    user_content: &str,
) -> AppResult<crate::llm::LlmReply> {
    let mut failures = Vec::new();
    for provider in failover_candidates(store, preferred_provider)? {
        match complete_chat(&provider, persona, system_prompt.clone(), history.clone(), user_content).await {
            Ok(mut reply) => {
                attach_llm_failover_metadata(&mut reply, &provider, &failures);
                return Ok(reply);
            }
            Err(error) => failures.push(classify_llm_failure(&provider, &error)),
        }
    }
    Err(AppError::Llm(format_llm_failures("chat completion", &failures)))
}

