pub fn list_agent_control_commands() -> Vec<AgentControlCommandView> {
    AGENT_CONTROL_COMMANDS
        .iter()
        .map(|command| AgentControlCommandView {
            name: command.name.to_string(),
            aliases: command.aliases.iter().map(|alias| alias.to_string()).collect(),
            args_hint: command.args_hint.to_string(),
            description: command.description.to_string(),
        })
        .collect()
}

fn resolve_agent_control_command(input: &str) -> Option<&'static AgentControlCommandSpec> {
    let normalized = input.trim().trim_start_matches('/').trim_start_matches('／').to_lowercase();
    if normalized.is_empty() {
        return None;
    }
    AGENT_CONTROL_COMMANDS.iter().find(|command| {
        command.name == normalized || command.aliases.iter().any(|alias| *alias == normalized)
    })
}

fn agent_control_help_text() -> String {
    let mut lines = vec!["Agent 控制命令：".to_string()];
    lines.extend(AGENT_CONTROL_COMMANDS.iter().map(|command| {
        let mut names = vec![format!("/{}", command.name)];
        names.extend(command.aliases.iter().map(|alias| format!("/{alias}")));
        let args = if command.args_hint.is_empty() { String::new() } else { format!(" {}", command.args_hint) };
        format!("- {}{}：{}", names.join(" 或 "), args, command.description)
    }));
    lines.push(String::new());
    lines.push("这些命令会绕过运行中的 agent，不会被加入普通消息队列。".into());
    lines.join("\n")
}

fn handle_history_control_command(
