    parsed_step: &'a str,
    error: Option<String>,
    checkpoint_state: &'a str,
    checkpoint_summary: String,
}

struct ToolResultAssessment {
    kind: String,
    failed: bool,
    summary: String,
    guidance: Option<String>,
}

struct ToolGuardrailDecision {
    action: &'static str,
    code: &'static str,
    message: String,
    count: u32,
}

impl ToolGuardrailDecision {
    fn should_halt(&self) -> bool {
        self.action == "halt" || self.action == "block"
    }
}

struct ToolLoopGuardrails {
    exact_failure_counts: HashMap<String, u32>,
    same_tool_failure_counts: HashMap<String, u32>,
    idempotent_no_progress: HashMap<String, (u64, u32)>,
    exact_failure_limit: u32,
    same_tool_failure_limit: u32,
    no_progress_limit: u32,
}

impl ToolLoopGuardrails {
    fn new(exact_failure_limit: u32, same_tool_failure_limit: u32, no_progress_limit: u32) -> Self {
        Self {
            exact_failure_counts: HashMap::new(),
            same_tool_failure_counts: HashMap::new(),
            idempotent_no_progress: HashMap::new(),
            exact_failure_limit: exact_failure_limit.max(1),
            same_tool_failure_limit: same_tool_failure_limit.max(1),
            no_progress_limit: no_progress_limit.max(1),
        }
    }

    fn before_call(&self, tool_name: &str, signature: &str) -> Option<ToolGuardrailDecision> {
        let exact_failures = self.exact_failure_counts.get(signature).copied().unwrap_or(0);
        if exact_failures >= self.exact_failure_limit {
            return Some(ToolGuardrailDecision {
                action: "block",
                code: "repeated_exact_failure_block",
                message: format!(
                    "{tool_name} failed {exact_failures} times with identical arguments. Stop retrying it unchanged; change strategy or explain the blocker."
                ),
                count: exact_failures,
            });
        }
        if is_idempotent_tool(tool_name) {
            if let Some((_hash, count)) = self.idempotent_no_progress.get(signature) {
                if *count >= self.no_progress_limit {
                    return Some(ToolGuardrailDecision {
                        action: "block",
                        code: "idempotent_no_progress_block",
                        message: format!(
                            "{tool_name} returned the same result {count} times. Use the result already provided or change the query."
                        ),
                        count: *count,
                    });
                }
            }
        }
        None
    }

    fn after_call(
        &mut self,
        tool_name: &str,
        signature: &str,
        result_text: &str,
        failed: bool,
    ) -> Option<ToolGuardrailDecision> {
        if failed {
            let exact_count = self.exact_failure_counts.entry(signature.to_string()).or_insert(0);
            *exact_count += 1;
            self.idempotent_no_progress.remove(signature);
            let same_tool_count = self.same_tool_failure_counts.entry(tool_name.to_string()).or_insert(0);
            *same_tool_count += 1;
            if *same_tool_count >= self.same_tool_failure_limit {
                return Some(ToolGuardrailDecision {
                    action: "halt",
                    code: "same_tool_failure_halt",
                    message: format!(
                        "{tool_name} failed {same_tool_count} times this turn. Diagnose the latest error and use a different approach."
                    ),
                    count: *same_tool_count,
                });
            }
            if *exact_count + 1 >= self.exact_failure_limit {
                return Some(ToolGuardrailDecision {
                    action: "warn",
                    code: "repeated_exact_failure_warning",
                    message: format!(
                        "{tool_name} has failed {exact_count} times with identical arguments. Change arguments or strategy before retrying."
                    ),
                    count: *exact_count,
                });
            }
            if *same_tool_count + 1 >= self.same_tool_failure_limit {
                return Some(ToolGuardrailDecision {
                    action: "warn",
                    code: "same_tool_failure_warning",
                    message: format!(
                        "{tool_name} has failed {same_tool_count} times this turn. Inspect the error before another call."
                    ),
                    count: *same_tool_count,
                });
            }
            return None;
        }

        self.exact_failure_counts.remove(signature);
        self.same_tool_failure_counts.remove(tool_name);
        if !is_idempotent_tool(tool_name) {
            self.idempotent_no_progress.remove(signature);
            return None;
        }
        let hash = stable_hash(result_text);
        let entry = self.idempotent_no_progress.entry(signature.to_string()).or_insert((hash, 0));
        if entry.0 == hash {
            entry.1 += 1;
        } else {
            *entry = (hash, 1);
        }
        if entry.1 >= self.no_progress_limit.saturating_sub(1).max(1) {
            return Some(ToolGuardrailDecision {
                action: "warn",
                code: "idempotent_no_progress_warning",
                message: format!(
                    "{tool_name} returned the same result {} times. Use the result or change the query instead of repeating it.",
                    entry.1
                ),
                count: entry.1,
            });
        }
        None
    }
}

fn record_agent_halt(
    store: &AppStore,
    run: &mut AgentRunRecord,
    conversation: &Conversation,
    persona: &Persona,
    agent: &AgentDefinition,
    halt: HaltRecord<'_>,
) -> AppResult<()> {
    store.append_planner_trace(PlannerTraceRecord {
        id: new_id("planner"),
        run_id: run.run_id.clone(),
        conversation_id: conversation.id.clone(),
        persona_id: persona.id.clone(),
        agent_id: agent.id.clone(),
        iteration: halt.iteration,
        created_at: now_iso(),
        input: halt.input.to_string(),
        output: halt.output,
        parsed_step: halt.parsed_step.to_string(),
        error: halt.error,
    })?;
    push_run_checkpoint(
        run,
        halt.iteration + 1,
        halt.checkpoint_state,
        halt.checkpoint_summary,
        Vec::new(),
        Vec::new(),
    );
    Ok(())
}

fn stable_hash(text: &str) -> u64 {
    let mut hasher = DefaultHasher::new();
    text.hash(&mut hasher);
    hasher.finish()
}

fn is_idempotent_tool(tool_name: &str) -> bool {
    let lower = tool_name.to_ascii_lowercase();
    ["read", "list", "search", "get", "snapshot", "info", "tree", "inspect"]
        .iter()
        .any(|keyword| lower.contains(keyword))
}

fn assess_tool_result(tool: &ToolDefinition, result: &crate::models::McpCallResult) -> ToolResultAssessment {
    let output = if !result.stdout.trim().is_empty() {
        result.stdout.trim()
    } else if let Some(error) = result.error.as_deref() {
        error.trim()
    } else {
        result.stderr.trim()
    };
    let lower = output.chars().take(800).collect::<String>().to_ascii_lowercase();
    let textual_failure = lower.contains("\"error\"")
        || lower.contains("\"failed\"")
        || lower.starts_with("error")
        || lower.contains("traceback")
        || lower.contains("exception");

    if result.timed_out {
        return ToolResultAssessment {
            kind: "timeout".into(),
            failed: true,
            summary: format!("{}.{} timed out after {} ms.", tool.server_id, tool.tool_name, result.elapsed_ms),
            guidance: Some("Do not retry the same call unchanged. Narrow the request, reduce output size, or choose a faster diagnostic tool.".into()),
        };
    }
    if !result.ok {
        return ToolResultAssessment {
            kind: "transport_error".into(),
            failed: true,
            summary: format!(
                "{}.{} failed: {}",
                tool.server_id,
                tool.tool_name,
                result.error.clone().unwrap_or_else(|| truncate_for_prompt(&result.stderr, 500))
            ),
            guidance: Some("Inspect the error, verify server availability and arguments, then change strategy before retrying.".into()),
        };
    }
    if textual_failure {
        return ToolResultAssessment {
            kind: "business_error".into(),
            failed: true,
            summary: format!("{}.{} returned an error-like payload.", tool.server_id, tool.tool_name),
            guidance: Some("Treat this as a failed tool result. Use the error text to adjust arguments or explain the blocker.".into()),
        };
    }
    if output.is_empty() {
        return ToolResultAssessment {
            kind: "empty_success".into(),
            failed: false,
            summary: format!("{}.{} completed with empty output.", tool.server_id, tool.tool_name),
            guidance: Some("If the user needs evidence, run a targeted read/list/status tool before finalizing.".into()),
        };
    }
    if output.chars().count() > 8_000 {
        return ToolResultAssessment {
            kind: "large_result".into(),
            failed: false,
            summary: format!("{}.{} returned a large result; prompt observation is truncated.", tool.server_id, tool.tool_name),
            guidance: Some("Use the truncated summary for planning; request narrower output if exact details are needed.".into()),
        };
    }
    ToolResultAssessment {
        kind: "success".into(),
        failed: false,
        summary: format!("{}.{} completed successfully.", tool.server_id, tool.tool_name),
        guidance: None,
    }
}

fn attach_tool_assessment(event: &mut ToolEvent, assessment: &ToolResultAssessment) {
    if assessment.kind != "success" {
        event.summary = format!("{} [{}]", event.summary, assessment.kind);
    }
    let metadata = json!({
        "kind": assessment.kind,
        "failed": assessment.failed,
        "summary": assessment.summary,
        "guidance": assessment.guidance,
    });
    match event.raw.take() {
        Some(Value::Object(mut map)) => {
            map.insert("synthchatAssessment".into(), metadata);
            event.raw = Some(Value::Object(map));
        }
        Some(raw) => {
            event.raw = Some(json!({
                "result": raw,
                "synthchatAssessment": metadata,
            }));
        }
        None => {
            event.raw = Some(json!({
                "synthchatAssessment": metadata,
            }));
        }
    }
}

fn persist_large_tool_result(
    store: &AppStore,
    run: &AgentRunRecord,
    event: &mut ToolEvent,
    assessment: &ToolResultAssessment,
    result: &crate::models::McpCallResult,
) -> AppResult<()> {
    if assessment.kind != "large_result" || result.stdout.trim().is_empty() {
        return Ok(());
    }
    let path = store.save_tool_artifact(&run.run_id, &event.tool_name, &result.stdout)?;
    event.path = Some(path.to_string_lossy().to_string());
    event.exists = Some(true);
    event.mime_type = Some("text/plain".into());
    event.text = Some(truncate_for_prompt(&result.stdout, 4_000));
    if let Some(Value::Object(map)) = event.raw.as_mut() {
        if let Some(Value::Object(assessment)) = map.get_mut("synthchatAssessment") {
            assessment.insert("artifactPath".into(), json!(event.path));
            assessment.insert("fullOutputSaved".into(), json!(true));
        }
    }
    Ok(())
}

fn planned_tool_requests(decision: &Value) -> Vec<PlannedToolRequest> {
    if let Some(calls) = planner_tool_calls_array(decision) {
        return calls
            .iter()
            .filter_map(|call| {
                let tool_name = planner_tool_name(call)?;
                if tool_name.is_empty() {
                    return None;
                }
                Some(PlannedToolRequest {
                    tool_name,
                    arguments: planner_arguments_value(call),
                })
            })
            .collect();
    }
    let tool_name = planner_tool_name(decision).unwrap_or_default();
    if tool_name.is_empty() {
        vec![]
    } else {
        vec![PlannedToolRequest {
            tool_name: tool_name.to_string(),
            arguments: planner_arguments_value(decision),
        }]
    }
}

fn planner_tool_calls_array(value: &Value) -> Option<&Vec<Value>> {
    value
        .get("toolCalls")
        .or_else(|| value.get("tool_calls"))
        .or_else(|| value.get("tools"))
        .or_else(|| value.get("calls"))
        .or_else(|| value.get("function_calls"))
        .and_then(Value::as_array)
}

fn planner_tool_name(value: &Value) -> Option<String> {
    value
        .get("tool")
        .or_else(|| value.get("toolName"))
        .or_else(|| value.get("tool_name"))
        .or_else(|| value.get("name"))
        .or_else(|| value.get("function"))
        .and_then(Value::as_str)
        .map(str::trim)
        .filter(|tool| !tool.is_empty())
        .map(str::to_string)
}

fn planner_action(value: &Value) -> String {
    value
        .get("action")
        .or_else(|| value.get("type"))
        .or_else(|| value.get("decision"))
        .and_then(Value::as_str)
        .unwrap_or("")
        .trim()
        .to_lowercase()
}

fn planner_action_is_tool(action: &str) -> bool {
    matches!(action, "tool" | "use_tool" | "call_tool" | "tools" | "tool_call")
}

fn planner_action_is_final(action: &str) -> bool {
    matches!(action, "final" | "answer" | "respond" | "finish" | "done")
}

fn planner_arguments_value(value: &Value) -> Value {
    value
        .get("arguments")
        .or_else(|| value.get("args"))
        .or_else(|| value.get("input"))
        .or_else(|| value.get("parameters"))
        .cloned()
        .unwrap_or_else(|| json!({}))
}

fn prepare_tool_call(
    store: &AppStore,
    available_tools: &[ToolDefinition],
    request: &PlannedToolRequest,
) -> AppResult<Option<PreparedToolCall>> {
    let Some(tool) = resolve_tool(&request.tool_name, available_tools) else {
        return Ok(None);
    };
    let payload = tool_payload_for_definition(store, &tool, request.arguments.clone())?;
    let signature = format!("{}.{}:{}", tool.server_id, tool.tool_name, compact_json(&request.arguments));
    Ok(Some(PreparedToolCall { tool, arguments: request.arguments.clone(), payload, signature }))
}

async fn try_execute_parallel_tool_batch(
    store: &AppStore,
    conversation: &Conversation,
    run: &mut AgentRunRecord,
    available_tools: &[ToolDefinition],
    guardrails: &mut ToolLoopGuardrails,
    tool_messages: &mut Vec<ChatMessage>,
    requests: &[PlannedToolRequest],
    iteration: u32,
    limit: usize,
    approval_mode: &str,
    trusted_tool_patterns: &[String],
    retry_count: usize,
    retry_backoff_ms: usize,
    persist_tool_messages: bool,
    app: Option<&AppHandle>,
) -> AppResult<Option<Vec<String>>> {
    if requests.len() < 2 {
        return Ok(None);
    }
    let mut prepared = Vec::new();
    let mut seen = HashSet::new();
    for request in requests.iter().take(limit.max(1)) {
        let Some(call) = prepare_tool_call(store, available_tools, request)? else {
            return Ok(None);
        };
        if call.tool.source == "internal" || tool_call_requires_approval_for_policy(&call.tool, &call.payload, approval_mode, trusted_tool_patterns) {
            return Ok(None);
        }
        if !seen.insert(format!("{}.{}", call.tool.server_id, call.tool.tool_name)) {
            return Ok(None);
        }
        if guardrails.before_call(&call.tool.tool_name, &call.signature).is_some() {
            return Ok(None);
        }
        prepared.push(call);
    }
    if prepared.len() < 2 {
        return Ok(None);
    }
    record_agent_stage(
        store,
        app,
        run,
        "tool_batch_started",
        json!({
            "iteration": iteration + 1,
            "count": prepared.len(),
            "tools": prepared.iter().map(|call| format!("{}.{}", call.tool.server_id, call.tool.tool_name)).collect::<Vec<_>>(),
        }),
    )?;
    let mut pre_tool_snapshots = Vec::new();
    for call in &prepared {
        pre_tool_snapshots.push(maybe_checkpoint_before_tool_mutation(
            store,
            run,
            iteration,
            &call.tool,
            &call.payload,
        )?);
    }

    let results = futures::future::join_all(prepared.iter().map(|call| async move {
        call_mcp_tool_with_retry(
            store,
            call.tool.server_id.clone(),
            call.tool.tool_name.clone(),
            call.payload.clone(),
            None,
            retry_count,
            retry_backoff_ms,
        )
        .await
    }))
    .await;

    let mut observations = Vec::new();
    for (index, ((call, result), pre_tool_snapshot)) in prepared
        .into_iter()
        .zip(results.into_iter())
        .zip(pre_tool_snapshots.into_iter())
        .enumerate()
    {
        let call_result = result?;
        let assessment = assess_tool_result(&call.tool, &call_result);
        let mut event = tool_event_from_call_result(&call.tool, &call.payload, &call_result);
        attach_pre_tool_checkpoint(&mut event, pre_tool_snapshot);
        attach_tool_assessment(&mut event, &assessment);
        let result_text_for_guardrail = if !call_result.stdout.trim().is_empty() {
            call_result.stdout.as_str()
        } else if let Some(error) = call_result.error.as_deref() {
            error
        } else {
            call_result.stderr.as_str()
        };
        let guardrail_decision = guardrails.after_call(
            &call.tool.tool_name,
            &call.signature,
            result_text_for_guardrail,
            assessment.failed,
        );
        if let Some(decision) = &guardrail_decision {
            event.summary = format!("{} [{}]", event.summary, decision.code);
            if let Some(Value::Object(map)) = event.raw.as_mut() {
                map.insert(
                    "toolGuardrail".into(),
                    json!({
                        "action": decision.action,
                        "code": decision.code,
                        "message": decision.message,
                        "count": decision.count,
                    }),
                );
            }
        }
        persist_large_tool_result(store, run, &mut event, &assessment, &call_result)?;
        let checkpoint_id = push_run_checkpoint(
            run,
            iteration + 1,
            if assessment.failed { "parallel_tool_failed" } else { "parallel_tool_completed" },
            format!(
                "Parallel call {}.{}; kind={}; ok={}. {}",
                call.tool.server_id, call.tool.tool_name, assessment.kind, event.ok, assessment.summary
            ),
            tool_event_call_ids(&event),
            tool_event_refs(&event),
        );
        event.checkpoint_id = Some(checkpoint_id);
        store.replace_latest_tool_trace_event(&call.tool.server_id, &call.tool.tool_name, event.clone())?;
        run.tool_events.push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));
        let tool_message = ChatMessage::new(
            conversation.id.clone(),
            "tool",
            json!({"type": "toolEvent", "event": event}).to_string(),
            "desktop",
        );
        record_tool_message(
            store,
            tool_messages,
            tool_message,
            persist_tool_messages,
        )?;
        emit_agent_run_event(app, run, "running", None, Some(&event), None);
        let guidance = assessment
            .guidance
            .as_ref()
            .map(|value| format!("; guidance={value}"))
            .unwrap_or_default();
        let guardrail_guidance = guardrail_decision
            .as_ref()
            .map(|decision| {
                format!(
                    "; guardrailAction={}; guardrailCode={}; guardrailMessage={}",
                    decision.action, decision.code, decision.message
                )
            })
            .unwrap_or_default();
        observations.push(format!(
            "Iteration {} parallel call {}: called {}.{} with args={}; kind={}; failed={}; ok={}; stdout/result={}; stderr/error={}{}{}",
            iteration + 1,
            index + 1,
            call.tool.server_id,
            call.tool.tool_name,
            compact_json(&call.arguments),
            assessment.kind,
            assessment.failed,
            call_result.ok,
            truncate_for_prompt(&call_result.stdout, 4000),
            truncate_for_prompt(&call_result.error.clone().unwrap_or(call_result.stderr), 2000),
            guidance,
            guardrail_guidance,
        ));
        if guardrail_decision.as_ref().is_some_and(|decision| decision.should_halt()) {
            observations.push("Parallel batch stopped early because a guardrail requested halt.".into());
            break;
        }
    }
    Ok(Some(observations))
}

fn tool_event_from_call_result(
    tool: &ToolDefinition,
    payload: &Value,
    result: &crate::models::McpCallResult,
) -> ToolEvent {
    ToolEvent {
        status: Some("completed".into()),
        reference_id: None,
        call_id: Some(new_id("call")),
        run_id: None,
        checkpoint_id: None,
        event_type: "mcp_tool".into(),
        server_id: tool.server_id.clone(),
        tool_name: tool.tool_name.clone(),
        ok: result.ok,
        timed_out: result.timed_out,
        elapsed_ms: result.elapsed_ms,
        title: format!("{} · {}", tool.server_id, tool.tool_name),
        summary: if result.ok {
            "工具调用完成".into()
        } else {
            result.error.clone().unwrap_or_else(|| "工具调用失败".into())
        },
        path: None,
        exists: None,
        mime_type: None,
        text: if result.stdout.is_empty() { None } else { Some(result.stdout.clone()) },
        error: result.error.clone(),
        raw: Some(json!({"payload": payload, "stdout": result.stdout, "stderr": result.stderr})),
    }
}

fn record_tool_message(
    store: &AppStore,
    tool_messages: &mut Vec<ChatMessage>,
    tool_message: ChatMessage,
    persist_tool_messages: bool,
) -> AppResult<()> {
    if persist_tool_messages {
        store.append_message(tool_message.clone())?;
        tool_messages.push(tool_message);
    }
    Ok(())
}

