#[derive(Debug, Clone)]
struct DiagnosticCommand {
    family: &'static str,
    program: String,
    args: Vec<String>,
    display: String,
}

async fn execute_internal_workspace_diagnostics(
    agent: &AgentDefinition,
    payload: &Value,
) -> AppResult<(String, Value)> {
    let root = resolve_diagnostics_workspace(agent, payload)?;
    let mode = payload
        .get("mode")
        .and_then(Value::as_str)
        .unwrap_or("auto")
        .trim()
        .to_lowercase()
        .replace('-', "_");
    let mode = match mode.as_str() {
        "rust" | "rs" | "cargo" => "rust",
        "typescript" | "ts" | "typecheck" | "tsc" => "typescript",
        "all" => "all",
        _ => "auto",
    };
    let timeout_secs = payload
        .get("timeoutSeconds")
        .or_else(|| payload.get("timeout_seconds"))
        .and_then(Value::as_u64)
        .unwrap_or(90)
        .clamp(5, 240);
    let max_commands = payload
        .get("maxCommands")
        .or_else(|| payload.get("max_commands"))
        .and_then(Value::as_u64)
        .unwrap_or(2)
        .clamp(1, 4) as usize;
    let commands = diagnostic_commands_for_workspace(&root, mode)
        .into_iter()
        .take(max_commands)
        .collect::<Vec<_>>();

    if commands.is_empty() {
        let text = format!(
            "未发现可运行的工作区诊断。workspace={} mode={}。需要 Cargo.toml 或 tsconfig.json。",
            root.display(),
            mode
        );
        return Ok((
            text,
            json!({
                "workspace": root.display().to_string(),
                "mode": mode,
                "ok": true,
                "commands": [],
                "message": "No supported diagnostics detected."
            }),
        ));
    }

    let mut lines = Vec::new();
    let mut raw_commands = Vec::new();
    let mut all_ok = true;
    for command in commands {
        let started = Instant::now();
        let result = run_diagnostic_command(&root, &command, timeout_secs).await;
        let elapsed_ms = started.elapsed().as_millis();
        match result {
            Ok(output) => {
                let stdout = String::from_utf8_lossy(&output.stdout).to_string();
                let stderr = String::from_utf8_lossy(&output.stderr).to_string();
                let exit_code = output.status.code();
                let ok = output.status.success();
                all_ok &= ok;
                lines.push(format!(
                    "$ {}\nstatus={} elapsedMs={}\nstdout:\n{}\nstderr:\n{}",
                    command.display,
                    exit_code
                        .map(|code| code.to_string())
                        .unwrap_or_else(|| "terminated".into()),
                    elapsed_ms,
                    truncate_for_prompt(&stdout, 5000),
                    truncate_for_prompt(&stderr, 5000),
                ));
                raw_commands.push(json!({
                    "family": command.family,
                    "command": command.display,
                    "ok": ok,
                    "timedOut": false,
                    "exitCode": exit_code,
                    "elapsedMs": elapsed_ms,
                    "stdout": truncate_for_prompt(&stdout, 12000),
                    "stderr": truncate_for_prompt(&stderr, 12000),
                }));
            }
            Err(error) => {
                all_ok = false;
                lines.push(format!(
                    "$ {}\nstatus=error elapsedMs={}\nerror={}",
                    command.display, elapsed_ms, error
                ));
                raw_commands.push(json!({
                    "family": command.family,
                    "command": command.display,
                    "ok": false,
                    "timedOut": error.contains("timed out"),
                    "elapsedMs": elapsed_ms,
                    "error": error,
                }));
            }
        }
    }

    Ok((
        format!(
            "workspace={} mode={} ok={}\n\n{}",
            root.display(),
            mode,
            all_ok,
            lines.join("\n\n---\n\n")
        ),
        json!({
            "workspace": root.display().to_string(),
            "mode": mode,
            "ok": all_ok,
            "timeoutSeconds": timeout_secs,
            "commands": raw_commands,
        }),
    ))
}

fn resolve_diagnostics_workspace(
    agent: &AgentDefinition,
    payload: &Value,
) -> AppResult<PathBuf> {
    let raw = payload
        .get("workspaceDir")
        .or_else(|| payload.get("workspace_dir"))
        .and_then(Value::as_str)
        .map(str::trim)
        .filter(|value| !value.is_empty())
        .or_else(|| {
            let workspace = agent.workspace_dir.trim();
            (!workspace.is_empty()).then_some(workspace)
        });
    let base = match raw {
        Some(path) => PathBuf::from(path),
        None => std::env::current_dir().map_err(AppError::Io)?,
    };
    let path = if base.is_relative() {
        std::env::current_dir().map_err(AppError::Io)?.join(base)
    } else {
        base
    };
    if !path.exists() {
        return Err(AppError::NotFound(format!(
            "workspace diagnostics path not found: {}",
            path.display()
        )));
    }
    if !path.is_dir() {
        return Err(AppError::BadRequest(format!(
            "workspace diagnostics path is not a directory: {}",
            path.display()
        )));
    }
    Ok(path.canonicalize().unwrap_or(path))
}

fn diagnostic_commands_for_workspace(root: &Path, mode: &str) -> Vec<DiagnosticCommand> {
    let mut commands = Vec::new();
    if matches!(mode, "auto" | "all" | "rust") && root.join("Cargo.toml").exists() {
        commands.push(DiagnosticCommand {
            family: "rust",
            program: platform_command("cargo"),
            args: vec!["check".into(), "--tests".into()],
            display: "cargo check --tests".into(),
        });
    }
    if matches!(mode, "auto" | "all" | "typescript") && root.join("tsconfig.json").exists() {
        commands.push(DiagnosticCommand {
            family: "typescript",
            program: platform_command("npx"),
            args: vec!["--no-install".into(), "tsc".into(), "--noEmit".into()],
            display: "npx --no-install tsc --noEmit".into(),
        });
    }
    commands
}

fn platform_command(name: &str) -> String {
    if cfg!(target_os = "windows") && name == "npx" {
        "npx.cmd".into()
    } else {
        name.into()
    }
}

async fn run_diagnostic_command(
    root: &Path,
    command: &DiagnosticCommand,
    timeout_secs: u64,
) -> Result<std::process::Output, String> {
    let child = TokioCommand::new(&command.program)
        .args(&command.args)
        .current_dir(root)
        .stdin(Stdio::null())
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .kill_on_drop(true)
        .spawn()
        .map_err(|error| format!("failed to start {}: {}", command.display, error))?;
    match timeout(Duration::from_secs(timeout_secs), child.wait_with_output()).await {
        Ok(result) => result.map_err(|error| format!("failed to read {}: {}", command.display, error)),
        Err(_) => Err(format!(
            "timed out after {}s while running {}",
            timeout_secs, command.display
        )),
    }
}

async fn execute_internal_execute_code(
    agent: &AgentDefinition,
    payload: &Value,
    timeout_seconds: Option<u64>,
) -> AppResult<crate::models::McpCallResult> {
    let code = string_arg(payload, &["code", "script", "source"]).ok_or_else(|| {
        AppError::BadRequest("execute_code requires code/script/source.".into())
    })?;
    let language = payload
        .get("language")
        .or_else(|| payload.get("lang"))
        .and_then(Value::as_str)
        .unwrap_or("python")
        .trim()
        .to_ascii_lowercase();
    let timeout_secs = payload
        .get("timeoutSeconds")
        .or_else(|| payload.get("timeout_seconds"))
        .and_then(Value::as_u64)
        .or(timeout_seconds)
        .unwrap_or(60)
        .clamp(1, 300);
    let cwd = resolve_file_workspace(agent, payload)?;
    let started = Instant::now();
    let mut command = match language.as_str() {
        "python" | "py" | "python3" => {
            let mut command = TokioCommand::new(python_command());
            command.args(["-c", code.as_str()]);
            command
        }
        "javascript" | "js" | "node" | "nodejs" => {
            let mut command = TokioCommand::new(platform_command("node"));
            command.args(["-e", code.as_str()]);
            command
        }
        "powershell" | "pwsh" | "ps1" => {
            let program = if language == "pwsh" { "pwsh" } else { "powershell" };
            let mut command = TokioCommand::new(program);
            command.args(["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]);
            command.arg(code.as_str());
            command
        }
        other => {
            return Err(AppError::BadRequest(format!(
                "execute_code unsupported language: {other}"
            )));
        }
    };
    command
        .current_dir(&cwd)
        .stdin(Stdio::null())
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .kill_on_drop(true);
    let child = command
        .spawn()
        .map_err(|error| AppError::BadRequest(format!("failed to start execute_code: {error}")))?;
    match timeout(Duration::from_secs(timeout_secs), child.wait_with_output()).await {
        Ok(result) => {
            let output = result.map_err(|error| {
                AppError::BadRequest(format!("failed to read execute_code output: {error}"))
            })?;
            let stdout = truncate_for_prompt(&String::from_utf8_lossy(&output.stdout), 50000);
            let stderr = truncate_for_prompt(&String::from_utf8_lossy(&output.stderr), 10000);
            let ok = output.status.success();
            Ok(crate::models::McpCallResult {
                ok,
                timed_out: false,
                elapsed_ms: started.elapsed().as_millis(),
                stdout,
                stderr,
                error: if ok {
                    None
                } else {
                    Some(format!("execute_code exited with status {}", output.status))
                },
            })
        }
        Err(_) => Ok(crate::models::McpCallResult {
            ok: false,
            timed_out: true,
            elapsed_ms: started.elapsed().as_millis(),
            stdout: String::new(),
            stderr: String::new(),
            error: Some(format!("execute_code timed out after {timeout_secs}s")),
        }),
    }
}

