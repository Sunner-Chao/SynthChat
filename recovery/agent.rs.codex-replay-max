pub fn deny_tool_call_and_update_run(
    store: &AppStore,
    approval_id: String,
    reason: Option<String>,
    app: Option<&AppHandle>,
) -> AppResult<ToolApprovalRequest> {
    let approval = store.update_tool_approval(&approval_id, "denied", None, reason.clone())?;
    let Some(run_id) = approval.run_id.as_deref() else {
        return Ok(approval);
    };
    let mut run = store.agent_run(run_id)?;
    let message_text = format!(
        "工具调用 `{}`.`{}` 已被拒绝，agent run 已停止。{}",
        approval.server_id,
        approval.tool_name,
        reason.as_deref().unwrap_or("")
    );
    let next_iteration = run.checkpoints.len() as u32 + 1;
    push_run_checkpoint(
        &mut run,
        next_iteration,
        "approval_denied",
        message_text.clone(),
        Vec::new(),
        vec![approval.id.clone()],
    );
    run.state = "aborted".into();
    run.error = Some(message_text.clone());
    run.updated_at = now_iso();
    run.completed_at = Some(run.updated_at.clone());
    let saved = store.save_agent_run(run.clone())?;
    if let Ok(conversation) = store.conversation(&saved.conversation_id) {
        let conversation_id = conversation.id.clone();
        let assistant = ChatMessage::new(conversation.id, "assistant", message_text, "desktop");
        store.append_message(assistant.clone())?;
        emit_agent_run_event(app, &saved, "aborted", Some(&assistant), None, saved.error.as_deref());
        if let Some(app_handle) = app.cloned() {
            spawn_conversation_queue_drain(app_handle, conversation_id);
        }
    } else {
        emit_agent_run_event(app, &saved, "aborted", None, None, saved.error.as_deref());
    }
    Ok(approval)
}

pub async fn resume_agent_run(
    store: &AppStore,
    run_id: String,
    checkpoint_id: Option<String>,
    app: Option<&AppHandle>,
) -> AppResult<AgentRunRecord> {
    let mut run = store.agent_run(&run_id)?;
    validate_run_resume_allowed(store, &run, checkpoint_id.as_deref())?;

    let conversation = store.conversation(&run.conversation_id)?;
    let persona = store.persona(Some(&run.persona_id))?;
    let agent = store.agent(Some(&run.agent_id))?;
    let config = store.config()?;
    let provider_id = selected_provider_id(&persona, &agent);
    let provider = store.provider(provider_id)?;
    let effective_persona = effective_llm_persona(&persona, &agent);
    let messages = store.messages(&conversation.id, None)?;
    let original_request = if run.user_request.trim().is_empty() {
        latest_user_request(&messages)
    } else {
        run.user_request.clone()
    };
    let short_context = prepare_short_context(
        store,
        &conversation,
        &effective_persona,
        &provider,
        &messages,
        config.chat.max_context_rounds,
        config.chat.short_context_token_budget,
        &config.chat.short_context_mode,
    )
    .await?;
    let history = context_window_messages(&messages, &short_context, config.chat.max_context_rounds * 2 + 1);
    let memories = prompt_memories(store, &persona)?;
    let skill_blocks = skills::prompt_blocks_for_request(store, &agent, &original_request)?;
    let worldbook_blocks = matching_worldbook_blocks(store, &persona, &original_request)?;
    let system_prompt = build_system_prompt(
        &conversation,
        &persona,
        &memories,
        &skill_blocks,
        &worldbook_blocks,
        &short_context,
    );
    let observations = resume_observations(&run, checkpoint_id.as_deref())?;
    run.state = "running".into();
    run.error = None;
    run.completed_at = None;
    run.updated_at = now_iso();
    store.save_agent_run(run.clone())?;
    emit_agent_run_event(app, &run, "running", None, None, None);

    let resumed = maybe_run_auto_tool(
        store,
        &conversation,
        &effective_persona,
        &agent,
        &mut run,
        &provider,
        &system_prompt,
        &original_request,
        &history,
        observations.clone(),
        vec![],
        app,
    )
    .await;

    match resumed {
        Ok(Some(AgentTurn::WithTools { prompt_tokens, completion_tokens, run_state, .. })) => {
            store.add_usage(prompt_tokens, completion_tokens)?;
            run.state = run_state.unwrap_or_else(|| "completed".into());
        }
        Ok(Some(AgentTurn::Plain(reply))) => {
            store.add_usage(reply.prompt_tokens, reply.completion_tokens)?;
            let assistant = ChatMessage::new(conversation.id.clone(), "assistant", reply.content, "desktop-stream");
            store.append_message(assistant.clone())?;
            emit_agent_run_event(app, &run, "completed", Some(&assistant), None, None);
            run.state = "completed".into();
        }
        Ok(None) => {
            let reply = build_checkpoint_resume_reply(
                store,
                &conversation,
                &persona,
                &agent,
                &provider,
                &system_prompt,
                &history,
                &original_request,
                &observations,
            )
            .await?;
            store.add_usage(reply.prompt_tokens, reply.completion_tokens)?;
            let assistant = ChatMessage::new(conversation.id.clone(), "assistant", reply.content, "desktop-stream");
            store.append_message(assistant.clone())?;
            emit_agent_run_event(app, &run, "completed", Some(&assistant), None, None);
            run.state = "completed".into();
        }
        Err(error) => {
            let assistant = ChatMessage::new(
                conversation.id.clone(),
                "assistant",
                format!("恢复 agent run 失败：{error}"),
                "desktop",
            );
            store.append_message(assistant.clone())?;
            emit_agent_run_event(app, &run, "failed", Some(&assistant), None, Some(&error.to_string()));
            run.state = "failed".into();
            run.error = Some(error.to_string());
        }
    }

    run.updated_at = now_iso();
    if run.state == "completed" || run.state == "failed" {
        run.completed_at = Some(run.updated_at.clone());
    }
    let saved = store.save_agent_run(run.clone())?;
    emit_agent_run_event(app, &saved, &saved.state, None, None, saved.error.as_deref());
    Ok(saved)
}

fn validate_run_resume_allowed(store: &AppStore, run: &AgentRunRecord, checkpoint_id: Option<&str>) -> AppResult<()> {
    match run.state.as_str() {
        "completed" => {
            return Err(AppError::BadRequest("completed agent run cannot be resumed; start a new request instead".into()));
        }
        "running" | "started" => {
            return Err(AppError::BadRequest(format!("agent run is already active: {}", run.state)));
        }
        "aborted" => {
            return Err(AppError::BadRequest("aborted agent run cannot be resumed safely".into()));
        }
        "pendingApproval" => {
            let has_pending_approval = store
                .tool_approvals()?
                .iter()
                .any(|approval| approval.run_id.as_deref() == Some(run.run_id.as_str()) && approval.status == "pending");
            if has_pending_approval {
                return Err(AppError::BadRequest("agent run is waiting for tool approval; approve or deny the pending tool call first".into()));
            }
        }
        _ => {}
    }

    if let Some(id) = checkpoint_id {
        let checkpoint = run
            .checkpoints
            .iter()
            .find(|checkpoint| checkpoint.checkpoint_id == id)
            .ok_or_else(|| AppError::NotFound(format!("checkpoint {id}")))?;
        if checkpoint.state == "completed" {
            return Err(AppError::BadRequest("completed checkpoint is not a resumable interruption point".into()));
        }
    }
    Ok(())
}

