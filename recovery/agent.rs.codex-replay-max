            emit_agent_run_event(app, run, "running", None, Some(&event), None);
            observations.push(format!(
                "Iteration {}: stored durable memory fact {}; remainingBudget={}; summary={}",
                iteration + 1,
                memory.id,
                budget.remaining(),
                truncate_for_prompt(&summary, 1000),
            ));
            continue;
        }

        if tool.source == "internal" && tool.tool_name == "manage_memory" {
            store.append_planner_trace(PlannerTraceRecord {
                id: new_id("planner"),
                run_id: run.run_id.clone(),
                conversation_id: conversation.id.clone(),
                persona_id: persona.id.clone(),
                agent_id: agent.id.clone(),
                iteration,
                created_at: now_iso(),
                input: user_request.to_string(),
                output: output.clone(),
                parsed_step: "manage_memory".into(),
                error: None,
            })?;
            let (text, raw, ok) = execute_internal_manage_memory(store, persona, &call_payload)?;
            let mut event = ToolEvent {
                status: Some("completed".into()),
                reference_id: raw
                    .get("memoryId")
                    .and_then(Value::as_str)
                    .map(|value| value.to_string())
                    .or_else(|| Some(format!("memory-manage-{}", iteration + 1))),
                call_id: Some(new_id("call")),
                run_id: Some(run.run_id.clone()),
                checkpoint_id: None,
                event_type: "internal_memory".into(),
                server_id: "__internal".into(),
                tool_name: "manage_memory".into(),
                ok,
                timed_out: false,
                elapsed_ms: 0,
                title: "Manage Memory".into(),
                summary: truncate_for_prompt(&text.replace('\n', " "), 180),
                path: None,
                exists: None,
                mime_type: None,
                text: Some(text.clone()),
                error: if ok { None } else { Some(text.clone()) },
                raw: Some(raw),
            };
            let checkpoint_id = push_run_checkpoint(
                run,
                iteration + 1,
                if ok { "tool_completed" } else { "tool_failed" },
                format!("Managed long-term memory; ok={ok}."),
                tool_event_call_ids(&event),
                tool_event_refs(&event),
            );
            event.checkpoint_id = Some(checkpoint_id);
            store.append_tool_trace(ToolTraceEntry {
                id: new_id("trace"),
                created_at: now_iso(),
                server_id: "__internal".into(),
                tool_name: "manage_memory".into(),
                ok,
                timed_out: false,
                elapsed_ms: 0,
                payload: call_payload,
                event: event.clone(),
                error: if ok { None } else { Some(text.clone()) },
            })?;
            run.tool_events
                .push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));
            let tool_message = ChatMessage::new(
                conversation.id.clone(),
                "tool",
                json!({"type": "toolEvent", "event": event}).to_string(),
                "desktop",
            );
            store.append_message(tool_message.clone())?;
            emit_agent_run_event(app, run, "running", None, Some(&event), None);
            tool_messages.push(tool_message);
            observations.push(format!(
                "Iteration {}: managed long-term memory; ok={}; remainingBudget={}; result={}",
                iteration + 1,
                ok,
                budget.remaining(),
                truncate_for_prompt(&text, 2000),
            ));
            continue;
        }

        if tool.source == "internal" && tool.tool_name == "delegate_task" {
            let delegate_payloads = expand_delegate_payloads(&call_payload);
            let remaining_subagents = agent.max_subagents.saturating_sub(delegated_count);
            if delegate_payloads.is_empty() || delegate_payloads.len() > remaining_subagents as usize {
                record_agent_halt(
                    store,
                    run,
                    conversation,
                    persona,
                    agent,
                    HaltRecord {
                        iteration,
                        input: user_request,
                        output,
                        parsed_step: "subagent_limit_reached",
                        error: Some(format!(
                            "delegate_task requested {} subtask(s), remainingSubagents={}",
                            delegate_payloads.len(),
                            remaining_subagents
                        )),
                        checkpoint_state: "subagent_limit_reached",
                        checkpoint_summary: format!(
                            "Subagent delegation unavailable; requested {}, remaining {}.",
                            delegate_payloads.len(),
                            remaining_subagents
                        ),
                    },
                )?;
                observations.push(format!(
                    "Iteration {}: subagent delegation blocked; requested {} subtask(s), remainingSubagents={}.",
                    iteration + 1,
                    delegate_payloads.len(),
                    remaining_subagents
                ));
                break;
            }
            store.append_planner_trace(PlannerTraceRecord {
                id: new_id("planner"),
                run_id: run.run_id.clone(),
                conversation_id: conversation.id.clone(),
                persona_id: persona.id.clone(),
                agent_id: agent.id.clone(),
                iteration,
                created_at: now_iso(),
                input: user_request.to_string(),
                output: output.clone(),
                parsed_step: "delegate_task".into(),
                error: None,
            })?;

            let mut delegate_results = Vec::new();
            for payload in &delegate_payloads {
                delegated_count += 1;
                let delegate_reply = run_delegate_task(store, provider, persona, user_request, payload).await?;
                prompt_tokens += delegate_reply.prompt_tokens;
                completion_tokens += delegate_reply.completion_tokens;
                delegate_results.push(format!(
                    "Subagent {}:\n{}",
                    delegated_count,
                    delegate_reply.content
                ));
            }
            let delegate_text = delegate_results.join("\n\n");
            let mut event = ToolEvent {
                status: Some("completed".into()),
                reference_id: Some(format!("subagent-batch-{}", iteration + 1)),
                call_id: Some(new_id("call")),
                run_id: Some(run.run_id.clone()),
                checkpoint_id: None,
                event_type: "subagent_delegate".into(),
                server_id: "__internal".into(),
                tool_name: "delegate_task".into(),
                ok: true,
                timed_out: false,
                elapsed_ms: 0,
                title: format!("Subagent Batch · {} task(s)", delegate_payloads.len()),
                summary: delegate_text.chars().take(180).collect(),
                path: None,
                exists: None,
                mime_type: None,
                text: Some(delegate_text.clone()),
                error: None,
                raw: Some(json!({"delegatedCount": delegate_payloads.len(), "payload": call_payload})),
            };
            let checkpoint_id = push_run_checkpoint(
                run,
                iteration + 1,
                "tool_completed",
                format!("Delegated {} subtask(s) to internal subagent(s).", delegate_payloads.len()),
                tool_event_call_ids(&event),
                tool_event_refs(&event),
            );
            event.checkpoint_id = Some(checkpoint_id);
            store.append_tool_trace(ToolTraceEntry {
                id: new_id("trace"),
                created_at: now_iso(),
                server_id: "__internal".into(),
                tool_name: "delegate_task".into(),
                ok: true,
                timed_out: false,
                elapsed_ms: 0,
                payload: call_payload,
                event: event.clone(),
                error: None,
            })?;
            run.tool_events.push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));
            let tool_message = ChatMessage::new(
                conversation.id.clone(),
                "tool",
                json!({"type": "toolEvent", "event": event}).to_string(),
                "desktop",
            );
            store.append_message(tool_message.clone())?;
            emit_agent_run_event(app, run, "running", None, Some(&event), None);
            tool_messages.push(tool_message);
            observations.push(format!(
                "Iteration {}: delegated {} subtask(s); remainingBudget={}; result={}",
                iteration + 1,
                delegate_payloads.len(),
                budget.remaining(),
                truncate_for_prompt(&delegate_text, 4000),
            ));
            continue;
        }

        store.append_planner_trace(PlannerTraceRecord {
            id: new_id("planner"),
            run_id: run.run_id.clone(),
            conversation_id: conversation.id.clone(),
            persona_id: persona.id.clone(),
            agent_id: agent.id.clone(),
            iteration,
            created_at: now_iso(),
            input: user_request.to_string(),
            output: output.clone(),
            parsed_step: format!("call {}.{}", tool.server_id, tool.tool_name),
            error: None,
        })?;

        record_agent_stage(
            store,
            app,
            run,
            "tool_started",
            json!({"iteration": iteration + 1, "tool": format!("{}.{}", tool.server_id, tool.tool_name)}),
        )?;
        let pre_tool_snapshot = maybe_checkpoint_before_tool_mutation(
            store,
            run,
            iteration,
            &tool,
            &call_payload,
        )?;
        let call_result = call_mcp_tool_with_retry(
            store,
            tool.server_id.clone(),
            tool.tool_name.clone(),
            call_payload,
            None,
            chat_config.tool_call_retry_count,
            chat_config.tool_call_retry_backoff_ms,
        )
        .await?;
        let latest_event = store
            .tool_traces()?
            .iter()
            .rev()
            .find(|trace| trace.server_id == tool.server_id && trace.tool_name == tool.tool_name)
            .map(|trace| trace.event.clone());
        let Some(mut event) = latest_event else {
            break;
        };
        let assessment = assess_tool_result(&tool, &call_result);
        attach_pre_tool_checkpoint(&mut event, pre_tool_snapshot);
        attach_tool_assessment(&mut event, &assessment);
        let result_text_for_guardrail = if !call_result.stdout.trim().is_empty() {
            call_result.stdout.as_str()
        } else if let Some(error) = call_result.error.as_deref() {
            error
        } else {
            call_result.stderr.as_str()
        };
        let guardrail_decision = guardrails.after_call(
            &tool.tool_name,
            &call_signature,
            result_text_for_guardrail,
            assessment.failed,
        );
        if let Some(decision) = &guardrail_decision {
            event.summary = format!("{} [{}]", event.summary, decision.code);
            if let Some(Value::Object(map)) = event.raw.as_mut() {
                map.insert(
                    "toolGuardrail".into(),
                    json!({
                        "action": decision.action,
                        "code": decision.code,
                        "message": decision.message,
                        "count": decision.count,
                    }),
                );
            }
        }
        persist_large_tool_result(store, run, &mut event, &assessment, &call_result)?;
        let checkpoint_id = push_run_checkpoint(
            run,
            iteration + 1,
            if assessment.failed { "tool_failed" } else { "tool_completed" },
            format!(
                "Called {}.{}; kind={}; ok={}. {}",
                tool.server_id, tool.tool_name, assessment.kind, event.ok, assessment.summary
            ),
            tool_event_call_ids(&event),
            tool_event_refs(&event),
        );
        event.checkpoint_id = Some(checkpoint_id);
        store.replace_latest_tool_trace_event(&tool.server_id, &tool.tool_name, event.clone())?;

        run.tool_events.push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));
        let tool_message = ChatMessage::new(
            conversation.id.clone(),
            "tool",
            json!({"type": "toolEvent", "event": event}).to_string(),
            "desktop",
        );
        record_tool_message(
            store,
            &mut tool_messages,
            tool_message,
            persist_tool_messages,
        )?;
        emit_agent_run_event(app, run, "running", None, Some(&event), None);
        let guidance = assessment
            .guidance
            .as_ref()
            .map(|value| format!("; guidance={value}"))
            .unwrap_or_default();
        let guardrail_guidance = guardrail_decision
            .as_ref()
            .map(|decision| {
                format!(
                    "; guardrailAction={}; guardrailCode={}; guardrailMessage={}",
                    decision.action, decision.code, decision.message
                )
            })
            .unwrap_or_default();
        observations.push(format!(
            "Iteration {}: called {}.{}; kind={}; failed={}; ok={}; remainingBudget={}; stdout/result={}; stderr/error={}{}{}",
            iteration + 1,
            tool.server_id,
            tool.tool_name,
            assessment.kind,
            assessment.failed,
            call_result.ok,
            budget.remaining(),
            truncate_for_prompt(&call_result.stdout, 4000),
            truncate_for_prompt(&call_result.error.clone().unwrap_or(call_result.stderr), 2000),
            guidance,
            guardrail_guidance,
        ));
        if let Some(decision) = guardrail_decision.as_ref().filter(|decision| decision.should_halt()) {
            record_agent_halt(
                store,
                run,
                conversation,
                persona,
                agent,
                HaltRecord {
                    iteration,
                    input: user_request,
                    output: output.clone(),
                    parsed_step: decision.code,
                    error: Some(decision.message.clone()),
                    checkpoint_state: "tool_guardrail_halt",
                    checkpoint_summary: decision.message.clone(),
                },
            )?;
            break;
        }
    }

    if observations.is_empty() {
        return Ok(None);
    }

    if agent_run_aborted(store, run)? {
        return Ok(Some(aborted_agent_turn(
            store,
            conversation,
            run,
            tool_messages,
            prompt_tokens,
            completion_tokens,
            app,
        )?));
    }

    let final_prompt = format!(
        "用户请求：\n{}\n\n工具执行观察：\n{}\n\n请基于这些观察直接回答用户。如果仍有缺口，明确说明缺口和下一步建议。",
        user_request,
        observations.join("\n\n"),
    );
    record_agent_stage(
        store,
        app,
        run,
        "finalizing",
        json!({"observationCount": observations.len(), "toolMessageCount": tool_messages.len()}),
    )?;
    let mut final_history = history.to_vec();
    final_history.push(ChatMessage::new(conversation.id.clone(), "user", final_prompt, "internal"));
    let final_reply = complete_chat_with_failover(
        store,
        provider,
        persona,
        system_prompt.to_string(),
        final_history,
        user_request,
    )
    .await?;
    record_llm_failover_stage_if_any(store, app, run, "final_answer", None, &final_reply)?;
    if agent_run_aborted(store, run)? {
        return Ok(Some(aborted_agent_turn(
            store,
            conversation,
            run,
            tool_messages,
            prompt_tokens + final_reply.prompt_tokens,
            completion_tokens + final_reply.completion_tokens,
            app,
        )?));
    }

    let assistant = ChatMessage::new(conversation.id.clone(), "assistant", final_reply.content, "desktop-stream");
    store.append_message(assistant.clone())?;
    prompt_tokens += final_reply.prompt_tokens;
    completion_tokens += final_reply.completion_tokens;

    Ok(Some(AgentTurn::WithTools {
        tool_messages,
        assistant,
        prompt_tokens,
        completion_tokens,
        run_state: None,
    }))
}

fn agent_run_aborted(store: &AppStore, run: &AgentRunRecord) -> AppResult<bool> {
    let saved = store.agent_run(&run.run_id)?;
    Ok(saved.state == "aborted")
}

fn drain_agent_steers_into_observations(
    store: &AppStore,
    app: Option<&AppHandle>,
    run: &mut AgentRunRecord,
    observations: &mut Vec<String>,
) -> AppResult<()> {
    let pending = store.drain_agent_run_steers(&run.run_id)?;
    if pending.is_empty() {
        return Ok(());
    }
    run.pending_steers.clear();
    for steer in &pending {
        observations.push(format!(
            "User steer injected before this planner step: {}",
            truncate_for_prompt(steer, 4000)
        ));
    }
    record_agent_stage(
        store,
        app,
        run,
        "steer_injected",
        json!({
            "count": pending.len(),
            "previews": pending
                .iter()
                .map(|steer| truncate_for_prompt(steer, 180))
                .collect::<Vec<_>>()
        }),
    )
}

fn aborted_agent_turn(
    store: &AppStore,
    conversation: &Conversation,
    run: &mut AgentRunRecord,
    tool_messages: Vec<ChatMessage>,
    prompt_tokens: usize,
    completion_tokens: usize,
    app: Option<&AppHandle>,
) -> AppResult<AgentTurn> {
    let saved = store.agent_run(&run.run_id)?;
    run.state = "aborted".into();
    run.error = saved.error.clone().or_else(|| Some("Agent run aborted by user.".into()));
    run.checkpoints = saved.checkpoints.clone();
    run.completed_at = saved.completed_at.clone().or_else(|| Some(now_iso()));
    record_agent_stage(
        store,
        app,
        run,
        "aborted",
        json!({"reason": run.error, "toolMessageCount": tool_messages.len()}),
    )?;
    let assistant = ChatMessage::new(
        conversation.id.clone(),
        "assistant",
        "已中止当前 agent run，后续规划和工具调用不会继续执行。".into(),
        "desktop",
    );
    store.append_message(assistant.clone())?;
    emit_agent_run_event(app, run, "aborted", Some(&assistant), None, run.error.as_deref());
    Ok(AgentTurn::WithTools {
        tool_messages,
        assistant,
        prompt_tokens,
        completion_tokens,
        run_state: Some("aborted".into()),
    })
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum ToolExecutionContext {
    Interactive,
    ScheduledJob,
    #[allow(dead_code)]
    SubagentLeaf,
}

impl ToolExecutionContext {
    fn from_user_request(user_request: &str) -> Self {
        if user_request.starts_with("Scheduled agent job runtime policy:") {
            Self::ScheduledJob
        } else {
            Self::Interactive
        }
    }
}

fn available_tools_for_agent(
    store: &AppStore,
    agent: &AgentDefinition,
    context: ToolExecutionContext,
) -> AppResult<Vec<ToolDefinition>> {
    let enabled_servers = store
        .static_list("mcpServers")?
        .into_iter()
        .filter_map(|value| serde_json::from_value::<crate::models::McpServer>(value).ok())
        .filter(|server| server.enabled)
        .map(|server| server.id)
        .collect::<std::collections::HashSet<_>>();
    let configured_servers = agent.enabled_mcp_servers.iter().cloned().collect::<std::collections::HashSet<_>>();
    let mut tools = store
        .tool_definitions()?
        .into_iter()
        .filter(|tool| {
            if tool.source == "internal" {
                return true;
            }
            if !configured_servers.is_empty() {
                configured_servers.contains(&tool.server_id)
            } else {
                enabled_servers.contains(&tool.server_id)
            }
        })
        .collect::<Vec<_>>();
    if agent.max_subagents > 0 {
        tools.push(delegate_tool_definition());
    }
    tools.push(clarify_tool_definition());
    tools.push(cronjob_tool_definition());
    tools.push(session_search_tool_definition());
    tools.push(update_todo_tool_definition());
    tools.push(recall_memory_tool_definition());
    tools.push(remember_fact_tool_definition());
    tools.push(manage_memory_tool_definition());
    tools = apply_agent_toolset_policy(tools, agent);
    tools = apply_tool_context_policy(tools, context);
    tools.sort_by(|left, right| {
        tool_prompt_priority(left)
            .cmp(&tool_prompt_priority(right))
            .then_with(|| left.name.cmp(&right.name))
    });
    Ok(tools)
}

fn apply_agent_toolset_policy(tools: Vec<ToolDefinition>, agent: &AgentDefinition) -> Vec<ToolDefinition> {
    let enabled = normalized_toolset_names(&agent.enabled_toolsets);
    let disabled = normalized_toolset_names(&agent.disabled_toolsets);
    if enabled.is_empty() && disabled.is_empty() {
        return tools;
    }
    tools
        .into_iter()
        .filter(|tool| {
            let toolsets = tool_toolsets(tool);
            let explicitly_enabled = enabled.is_empty() || toolsets.iter().any(|name| enabled.contains(name));
            let explicitly_disabled = toolsets.iter().any(|name| disabled.contains(name));
            explicitly_enabled && !explicitly_disabled
        })
        .collect()
}

fn normalized_toolset_names(names: &[String]) -> std::collections::HashSet<String> {
    names
        .iter()
        .map(|name| normalize_toolset_name(name))
        .filter(|name| !name.is_empty())
        .collect()
}

fn normalize_toolset_name(name: &str) -> String {
    name.trim().to_lowercase().replace('-', "_")
}

fn tool_toolsets(tool: &ToolDefinition) -> std::collections::HashSet<String> {
    let mut names = std::collections::HashSet::new();
    names.insert("all".into());
    names.insert(normalize_toolset_name(&tool.source));
    names.insert(format!("server:{}", normalize_toolset_name(&tool.server_id)));
    names.insert(format!("tool:{}", normalize_toolset_name(&tool.tool_name)));
    let text = format!(
        "{} {} {} {} {}",
        tool.name.to_lowercase(),
        tool.display_name.to_lowercase(),
        tool.tool_name.to_lowercase(),
        tool.server_id.to_lowercase(),
        tool.description.to_lowercase()
    );
    for toolset in semantic_toolsets_for_tool(tool, &text) {
        names.insert(toolset.to_string());
    }
    names
}

fn semantic_toolsets_for_tool(tool: &ToolDefinition, text: &str) -> Vec<&'static str> {
    if tool.source == "internal" {
        return match tool.tool_name.as_str() {
            "delegate_task" => vec!["delegation"],
            "clarify" => vec!["clarify"],
            "cronjob" => vec!["cronjob"],
            "session_search" => vec!["session_search", "search"],
            "update_todo" => vec!["todo", "planning"],
            "recall_memory" | "remember_fact" => vec!["memory"],
            _ => vec!["internal"],
        };
    }
    let mut toolsets = Vec::new();
    if contains_any(text, &["browser", "page", "dom", "snapshot", "click", "scroll"]) {
        toolsets.push("browser");
    }
    if contains_any(text, &["web", "http", "url", "search", "extract", "fetch"]) {
        toolsets.push("web");
    }
    if contains_any(text, &["search", "query", "find"]) {
        toolsets.push("search");
    }
    if contains_any(text, &["file", "read", "write", "patch", "directory", "path"]) {
        toolsets.push("file");
    }
    if contains_any(text, &["terminal", "shell", "command", "process", "exec"]) {
        toolsets.push("terminal");
    }
    if contains_any(text, &["image", "vision", "screenshot", "ocr"]) {
        toolsets.push("vision");
    }
    if contains_any(text, &["audio", "speech", "tts", "voice"]) {
        toolsets.push("tts");
    }
    if toolsets.is_empty() {
        toolsets.push("mcp");
    }
    toolsets
}

fn apply_tool_context_policy(tools: Vec<ToolDefinition>, context: ToolExecutionContext) -> Vec<ToolDefinition> {
    tools
        .into_iter()
        .filter(|tool| tool_allowed_in_context(tool, context))
        .collect()
}

fn tool_allowed_in_context(tool: &ToolDefinition, context: ToolExecutionContext) -> bool {
    match context {
        ToolExecutionContext::Interactive => true,
        ToolExecutionContext::ScheduledJob => {
            !(tool.source == "internal" && matches!(tool.tool_name.as_str(), "cronjob" | "clarify" | "remember_fact" | "recall_memory"))
        }
        ToolExecutionContext::SubagentLeaf => {
            !(tool.source == "internal"
                && matches!(
                    tool.tool_name.as_str(),
                    "delegate_task" | "clarify" | "cronjob" | "remember_fact" | "recall_memory"
                ))
        }
    }
}

fn tool_prompt_priority(tool: &ToolDefinition) -> u8 {
    let text = format!(
        "{} {} {} {}",
        tool.name.to_lowercase(),
        tool.display_name.to_lowercase(),
        tool.tool_name.to_lowercase(),
        tool.description.to_lowercase()
    );
    if contains_any(&text, &["snapshot", "accessibility", "page_state", "page state", "dom", "inspect"]) {
        return 0;
    }
    if contains_any(&text, &["list", "read", "get", "search", "query", "find", "status", "metadata", "schema"]) {
        return 1;
    }
    if tool.source == "internal" {
        return 2;
    }
    if contains_any(&text, &["click", "type", "fill", "press", "select", "navigate", "open"]) {
        return 3;
    }
    if contains_any(&text, &["write", "delete", "remove", "submit", "send", "post", "patch", "exec", "shell"]) {
        return 4;
    }
    2
}

fn clarify_tool_definition() -> ToolDefinition {
    ToolDefinition {
        name: "clarify".into(),
