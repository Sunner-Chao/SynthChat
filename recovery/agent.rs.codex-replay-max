fn handle_usage_control_command(store: &AppStore) -> AppResult<String> {
    let usage = store.token_usage()?;
    let prompt = usage
        .get("promptTokens")
        .and_then(Value::as_u64)
        .unwrap_or(0);
    let completion = usage
        .get("completionTokens")
        .and_then(Value::as_u64)
        .unwrap_or(0);
    let total = usage
        .get("totalTokens")
        .and_then(Value::as_u64)
        .unwrap_or(prompt + completion);
    let calls = usage.get("callCount").and_then(Value::as_u64).unwrap_or(0);
    Ok(format!(
        "Token 使用统计：\n- promptTokens: {}\n- completionTokens: {}\n- totalTokens: {}\n- callCount: {}",
        prompt, completion, total, calls
    ))
}

fn handle_doctor_control_command(
    store: &AppStore,
    conversation: &Conversation,
    persona: &Persona,
) -> AppResult<String> {
    let agent = store.agent(Some(&conversation.agent_id))?;
    let providers = store.providers()?;
    let enabled_providers = providers
        .iter()
        .filter(|provider| provider.enabled)
        .collect::<Vec<_>>();
    let selected_provider = store.provider(selected_provider_id(persona, &agent)).ok();
    let failover_candidates = if let Some(provider) = selected_provider.as_ref() {
        failover_candidates(store, provider).unwrap_or_default()
    } else {
        Vec::new()
    };
    let real_failover_candidates = failover_candidates
        .iter()
        .filter(|provider| provider.provider_type != "echo" && !provider.base_url.trim().is_empty())
        .count();
    let mcp_servers = store.static_list("mcpServers")?;
    let enabled_mcp_servers = mcp_servers
        .iter()
        .filter(|server| {
            server
                .get("enabled")
                .and_then(Value::as_bool)
                .unwrap_or(false)
        })
        .collect::<Vec<_>>();
    let enabled_mcp_server_ids = enabled_mcp_servers
        .iter()
        .filter_map(|server| server.get("id").and_then(Value::as_str))
        .collect::<HashSet<_>>();
    let adapters = store.capability_adapters()?;
    let enabled_adapters = adapters.iter().filter(|adapter| adapter.enabled).count();
    let registered_tools = store.tool_definitions()?;
    let tools = available_tools_for_agent(store, &agent, ToolExecutionContext::Interactive)?;
    let approvals = store.tool_approvals()?;
    let pending_approvals = approvals
        .iter()
        .filter(|approval| approval.status == "pending")
        .count();
    let runs = store.agent_runs()?;
    let active_runs = runs
        .iter()
        .filter(|run| matches!(run.state.as_str(), "started" | "running" | "pendingApproval"))
        .count();
    let child_runs = runs.iter().filter(|run| run.parent_run_id.is_some()).count();
    let queue = store.agent_queue()?;
    let queued_active = queue
        .iter()
        .filter(|item| matches!(item.status.as_str(), "pending" | "running"))
        .count();
    let scheduled_jobs = store.scheduled_agent_jobs()?;
    let enabled_jobs = scheduled_jobs.iter().filter(|job| job.enabled).count();
    let maintenance = store.config()?.chat;
    let mut issues = Vec::new();
    if enabled_providers.is_empty() {
        issues.push("没有启用的 LLM provider".to_string());
    }
    if enabled_providers.len() == 1 && enabled_providers[0].provider_type == "echo" {
        issues.push("当前仅启用 echo provider，复杂任务不会调用真实模型".to_string());
    } else if real_failover_candidates < 2 {
        issues.push("真实 LLM provider fallback 少于 2 个，首选 provider 故障时缺少冗余".to_string());
    }
    for provider in &enabled_providers {
        issues.extend(provider_doctor_issues(provider));
    }
    if !mcp_servers.is_empty() && enabled_mcp_servers.is_empty() {
        issues.push("已配置 MCP servers 但全部未启用".to_string());
    }
    for server_id in &agent.enabled_mcp_servers {
        if !enabled_mcp_server_ids.contains(server_id.as_str()) {
            issues.push(format!("agent 引用的 MCP server 未启用或不存在：{server_id}"));
        }
    }
    if !adapters.is_empty() && enabled_adapters == 0 {
        issues.push("已配置 capability adapters 但全部未启用".to_string());
    }
    if registered_tools.is_empty() && (!enabled_mcp_servers.is_empty() || enabled_adapters > 0) {
        issues.push("MCP/adapter 已启用但工具注册表为空，请刷新工具注册表".to_string());
    }
    if tools.is_empty() {
        issues.push("当前 agent 没有可用工具".to_string());
    }
    if pending_approvals > 0 {
        issues.push("存在待审批工具调用".to_string());
    }
    if active_runs > 1 {
        issues.push("存在多个活跃 agent run".to_string());
    }
    if queued_active > 0 && maintenance.busy_input_mode == "queue" {
        issues.push("队列中仍有待处理请求".to_string());
    }
    let status = if issues.is_empty() { "OK" } else { "WARN" };
    let issue_text = if issues.is_empty() {
        "- issues: none".to_string()
    } else {
        format!(
            "- issues:\n{}",
            issues
                .iter()
                .map(|issue| format!("  - {issue}"))
                .collect::<Vec<_>>()
                .join("\n")
        )
    };
    Ok(format!(
        "Agent Doctor：{}\n- conversation: {} ({})\n- persona: {} ({})\n- agent: {} ({})\n- providers: {} enabled / {} total\n- providerFailover: {} candidate(s), {} real ({})\n- mcpServers: {} enabled / {} total\n- capabilityAdapters: {} enabled / {} total\n- registeredTools: {}\n- tools: {}\n- activeRuns: {} (subagents {})\n- pendingApprovals: {}\n- queueActive: {}\n- scheduledJobs: {} enabled / {} total\n- maintenance: {} ({} days)\n{}",
        status,
        conversation.title,
        conversation.id,
        persona.name,
        persona.id,
        agent.name,
        agent.id,
        enabled_providers.len(),
        providers.len(),
        failover_candidates.len(),
        real_failover_candidates,
        format_provider_failover_candidates(&failover_candidates),
        enabled_mcp_servers.len(),
        mcp_servers.len(),
        enabled_adapters,
        adapters.len(),
        registered_tools.len(),
        tools.len(),
        active_runs,
        child_runs,
        pending_approvals,
        queued_active,
        enabled_jobs,
        scheduled_jobs.len(),
        if maintenance.history_cleanup_enabled { "enabled" } else { "disabled" },
        maintenance.history_retention_days,
        issue_text
    ))
}

fn provider_doctor_issues(provider: &LlmProvider) -> Vec<String> {
    if !provider.enabled || provider.provider_type.eq_ignore_ascii_case("echo") {
        return Vec::new();
    }
    let mut issues = Vec::new();
    if provider.model.trim().is_empty() && !provider_is_gemini_compatible(provider) {
        issues.push(format!("provider {} 未配置 model", provider.name));
    }
    if provider.base_url.trim().is_empty() && !provider_is_gemini_compatible(provider) {
        issues.push(format!("provider {} 未配置 baseUrl", provider.name));
    }
    if provider.api_key.as_deref().unwrap_or("").trim().is_empty()
        && provider.api_key_env.trim().is_empty()
        && !provider_is_local_compatible(provider)
    {
        issues.push(format!("provider {} 未配置 apiKey/apiKeyEnv", provider.name));
    }
    issues
}

fn format_provider_failover_candidates(providers: &[LlmProvider]) -> String {
    if providers.is_empty() {
        return "-".into();
    }
    let mut labels = providers
        .iter()
        .take(4)
        .map(|provider| {
            let kind = if provider.provider_type == "echo" || provider.base_url.trim().is_empty() {
                "mock"
            } else {
                "real"
            };
            format!("{}:{kind}", provider.id)
        })
        .collect::<Vec<_>>();
    if providers.len() > labels.len() {
        labels.push(format!("+{}", providers.len() - labels.len()));
    }
    labels.join(" -> ")
}

fn provider_is_gemini_compatible(provider: &LlmProvider) -> bool {
    let provider_type = provider.provider_type.to_lowercase();
    let preset = provider
        .preset
        .as_deref()
        .unwrap_or_default()
        .to_lowercase();
    let base_url = provider.base_url.to_lowercase();
    provider_type == "gemini"
        || preset.contains("google")
        || preset.contains("gemini")
        || base_url.contains("generativelanguage.googleapis.com")
        || base_url.ends_with(":generatecontent")
}

fn provider_is_local_compatible(provider: &LlmProvider) -> bool {
    let provider_type = provider.provider_type.to_lowercase();
    let preset = provider
        .preset
        .as_deref()
        .unwrap_or_default()
        .to_lowercase();
    let base_url = provider.base_url.to_lowercase();
    provider_type.contains("ollama")
        || preset.contains("ollama")
        || base_url.contains("127.0.0.1")
        || base_url.contains("localhost")
        || base_url.contains("[::1]")
}

