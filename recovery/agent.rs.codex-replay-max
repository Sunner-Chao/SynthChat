fn extract_request_clues(html: &str, base_url: &str, limit: usize) -> Vec<Value> {
    let mut clues = Vec::new();
    for form in extract_static_forms(html, base_url, limit) {
        clues.push(json!({
            "kind": "form",
            "method": form.get("method").and_then(Value::as_str).unwrap_or("GET"),
            "url": form.get("absoluteAction").and_then(Value::as_str).unwrap_or(""),
            "source": form,
        }));
        if clues.len() >= limit {
            return clues;
        }
    }
    for script in extract_static_scripts(html, base_url, limit) {
        clues.push(script);
        if clues.len() >= limit {
            return clues;
        }
    }
    let lower = html.to_lowercase();
    for needle in ["fetch(", ".open(", "xmlhttprequest", "method:", "method="] {
        let mut offset = 0usize;
        while let Some(index_rel) = lower[offset..].find(needle) {
            let index = offset + index_rel;
            let start = index.saturating_sub(160);
            let end = (index + 320).min(html.len());
            let snippet = &html[start..end];
            let mut clue = json!({
                "kind": needle,
                "method": infer_request_method(snippet),
                "snippet": html_to_text(snippet),
            });
            if let Some(raw_url) = infer_request_url(snippet) {
                clue["url"] = json!(resolve_url(base_url, &raw_url));
                clue["rawUrl"] = json!(raw_url);
            }
            clues.push(clue);
            if clues.len() >= limit {
                return clues;
            }
            offset = index + needle.len();
        }
    }
    clues
}

fn extract_static_scripts(html: &str, base_url: &str, limit: usize) -> Vec<Value> {
    let mut scripts = Vec::new();
