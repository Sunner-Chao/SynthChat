async fn wait_for_conversation_slot(store: &AppStore, conversation_id: &str) -> AppResult<Option<AgentRunRecord>> {
    let wait_seconds = store.config()?.chat.queue_wait_seconds.max(0) as u64;
    let mut waited_ms = 0u64;
    let max_wait_ms = wait_seconds.saturating_mul(1000);
    loop {
        let active = store.active_agent_run_for_conversation(conversation_id)?;
        if active.is_none() || waited_ms >= max_wait_ms {
            return Ok(active);
        }
        let step_ms = 250u64;
        sleep(Duration::from_millis(step_ms)).await;
        waited_ms = waited_ms.saturating_add(step_ms);
    }
}

async fn drain_agent_queue(store: &AppStore, conversation_id: &str, app: Option<&AppHandle>) -> AppResult<()> {
    loop {
        if store.active_agent_run_for_conversation(conversation_id)?.is_some() {
            return Ok(());
        }
        let Some(item) = store.claim_next_agent_request(conversation_id)? else {
            return Ok(());
        };
        store.remove_message(&item.conversation_id, &item.user_message_id)?;
        let result = Pin::from(Box::new(run_chat_turn(
            store,
            SendChatRequest {
                conversation_id: Some(item.conversation_id.clone()),
                persona_id: Some(item.persona_id.clone()),
                content: item.content.clone(),
            },
            app,
        )))
        .await;
        match result {
            Ok(_) => store.complete_agent_queue_item(&item.id, "completed", None)?,
            Err(error) => {
                store.complete_agent_queue_item(&item.id, "failed", Some(error.to_string()))?;
                return Err(error);
            }
        }
    }
}

async fn handle_agent_control_command(
    store: &AppStore,
    conversation: &Conversation,
    persona: &Persona,
    clean: &str,
    app: Option<&AppHandle>,
) -> AppResult<Option<ChatMessage>> {
    let raw_body = clean
        .trim()
        .strip_prefix('/')
        .or_else(|| clean.trim().strip_prefix('／'))
        .unwrap_or("");
    let mut raw_parts = raw_body.splitn(2, char::is_whitespace);
    let command_input = raw_parts.next().unwrap_or("").to_lowercase();
    let argument_raw = raw_parts.next().unwrap_or("").trim();
    let argument = argument_raw.to_lowercase();
    let argument = argument.trim();
    let Some(command_spec) = resolve_agent_control_command(&command_input) else {
        return Ok(None);
    };
    let command = command_spec.name;

    let reply = match command {
        "help" => agent_control_help_text(),
        "doctor" => handle_doctor_control_command(store, conversation, persona)?,
        "approve" | "always" | "trust-server" => {
            let Some(approval) = select_pending_approval(store, &conversation.id, argument)? else {
                return Ok(Some(ChatMessage::new(
                    conversation.id.clone(),
                    "assistant",
                    "当前会话没有待审批工具调用。".into(),
                    "desktop-control",
                )));
            };
            let saved = match command {
                "always" => approve_tool_call_always_and_resume(store, approval.id.clone(), None, app).await?,
                "trust-server" => approve_tool_call_server_and_resume(store, approval.id.clone(), None, app).await?,
                _ => approve_tool_call_and_resume(store, approval.id.clone(), None, app).await?,
            };
            match command {
                "always" => format!("已批准并记住工具调用：{}.{}。审批状态：{}。", saved.server_id, saved.tool_name, saved.status),
                "trust-server" => format!("已批准并信任服务器：{}.*。审批状态：{}。", saved.server_id, saved.status),
                _ => format!("已批准工具调用：{}.{}。审批状态：{}。", saved.server_id, saved.tool_name, saved.status),
            }
        }
        "deny" => {
            let Some(approval) = select_pending_approval(store, &conversation.id, argument)? else {
                return Ok(Some(ChatMessage::new(
                    conversation.id.clone(),
                    "assistant",
                    "当前会话没有待拒绝工具调用。".into(),
                    "desktop-control",
                )));
            };
            let saved = deny_tool_call_and_update_run(
                store,
                approval.id.clone(),
                Some("Denied by control command.".into()),
                app,
            )?;
            format!("已拒绝工具调用：{}.{}。审批状态：{}。", saved.server_id, saved.tool_name, saved.status)
        }
        "export" => {
            let Some(run) = select_agent_run_for_conversation(store, &conversation.id, argument)? else {
                return Ok(Some(ChatMessage::new(
                    conversation.id.clone(),
                    "assistant",
                    "当前会话没有可导出的 agent run。".into(),
                    "desktop-control",
                )));
            };
            let path = export_agent_run_bundle(store, run.run_id.clone())?;
            format!("已导出 agent run 轨迹：{}\n{}", run.run_id, path)
        }
        "diagnose" => {
            let Some(run) = select_agent_run_for_conversation(store, &conversation.id, argument)? else {
                return Ok(Some(ChatMessage::new(
                    conversation.id.clone(),
                    "assistant",
                    "当前会话没有可诊断的 agent run。".into(),
                    "desktop-control",
                )));
            };
            let (_conversation, reply) = generate_agent_run_diagnosis_reply(store, &run.run_id).await?;
            store.add_usage(reply.prompt_tokens, reply.completion_tokens)?;
            reply.content
        }
        "background" => {
            let prompt = argument_raw.trim();
            if prompt.is_empty() {
                return Ok(Some(ChatMessage::new(
                    conversation.id.clone(),
                    "assistant",
                    "用法：/background <prompt>".into(),
                    "desktop-control",
                )));
            }
            let Some(app_handle) = app.cloned() else {
                return Ok(Some(ChatMessage::new(
                    conversation.id.clone(),
                    "assistant",
                    "当前运行环境不支持后台任务。".into(),
                    "desktop-control",
                )));
            };
            let conversation_id = conversation.id.clone();
            let persona_id = persona.id.clone();
            let prompt = prompt.to_string();
            spawn_background_chat_turn(app_handle, conversation_id, persona_id, prompt);
            "后台任务已启动；结果会写回当前会话。如果当前会话正忙，该任务会进入 agent 队列。".into()
        }
        "agents" => handle_agents_control_command(store)?,
        "subagents" => handle_subagents_control_command(store, argument_raw, app)?,
        "abort" => {
            if let Some(active) = store.active_agent_run_for_conversation(&conversation.id)? {
                let saved = abort_agent_run(
                    store,
                    active.run_id.clone(),
                    Some("Agent run stopped by control command.".into()),
                    app,
                )?;
                format!("已中止当前 agent run：{}。状态：{}。", saved.run_id, saved.state)
            } else {
                "当前会话没有运行中的 agent run。".into()
            }
        }
        "queue" => {
            let queue_action = argument_raw.trim().to_lowercase();
            if matches!(queue_action.as_str(), "drain" | "run" | "start") {
                let pending_before = store
                    .agent_queue()?
                    .into_iter()
                    .filter(|item| item.conversation_id == conversation.id && item.status == "pending")
                    .count();
                if pending_before == 0 {
                    "当前会话没有 pending 队列可执行。".into()
                } else if let Some(active) = store.active_agent_run_for_conversation(&conversation.id)? {
                    format!("当前会话已有运行中的 agent run：{}，暂不 drain 队列。", active.run_id)
                } else {
                    drain_agent_queue(store, &conversation.id, app).await?;
                    let pending_after = store
                        .agent_queue()?
                        .into_iter()
                        .filter(|item| item.conversation_id == conversation.id && item.status == "pending")
                        .count();
                    format!("已触发当前会话队列执行。pending：{} -> {}。", pending_before, pending_after)
                }
            } else {
                handle_agent_queue_control_command(store, conversation, persona, argument_raw)?
            }
        }
        "todo" => {
            let Some(run) = select_agent_run_for_conversation(store, &conversation.id, argument)? else {
                return Ok(Some(ChatMessage::new(
                    conversation.id.clone(),
                    "assistant",
                    "当前会话没有 agent run。".into(),
                    "desktop-control",
                )));
            };
            let todos = store.agent_todos_for_run(&run.run_id)?;
            if todos.is_empty() {
                format!("agent run {} 暂无 todo。", run.run_id)
            } else {
                let rows = todos
                    .iter()
                    .map(|todo| format!("- [{}] {}", todo.status, todo.content))
                    .collect::<Vec<_>>()
                    .join("\n");
                format!("agent run {} Todo：\n{}", run.run_id, rows)
            }
        }
        "search" => {
            let (text, _raw) = execute_internal_session_search(
                store,
                conversation,
                &json!({"query": argument_raw, "limit": 12}),
            )?;
            text
        }
        "cron" => handle_scheduled_jobs_control_command(store, conversation, persona, command, argument_raw, app)?,
        _ => {
            let active = store.active_agent_run_for_conversation(&conversation.id)?;
            let pending_queue = store
                .agent_queue()?
                .into_iter()
                .filter(|item| item.conversation_id == conversation.id && item.status == "pending")
                .count();
            let pending_approvals = store
                .tool_approvals()?
                .into_iter()
                .filter(|approval| approval.conversation_id.as_deref() == Some(conversation.id.as_str()) && approval.status == "pending")
                .count();
            format!(
                "Agent 状态：{}\n队列：{} 条 pending\n待审批工具：{} 条\n角色：{}",
                active
                    .as_ref()
                    .map(|run| format!("{} ({})", run.run_id, run.state))
                    .unwrap_or_else(|| "idle".into()),
                pending_queue,
                pending_approvals,
                persona.name
            )
        }
    };

    Ok(Some(ChatMessage::new(
        conversation.id.clone(),
        "assistant",
        reply,
        "desktop-control",
    )))
}

#[derive(Debug)]
