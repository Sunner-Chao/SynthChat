    fn session_search_candidate_sort_supports_temporal_modes() {
        let mut candidates = vec![
            SessionSearchCandidate {
                kind: "message".into(),
                conversation_id: "conv-old".into(),
                message_id: Some("msg-old".into()),
                source: "old".into(),
                content: "old".into(),
                metadata: None,
                score: 20,
                recency: 9,
            },
            SessionSearchCandidate {
                kind: "message".into(),
                conversation_id: "conv-new".into(),
                message_id: Some("msg-new".into()),
                source: "new".into(),
                content: "new".into(),
                metadata: None,
                score: 10,
                recency: 0,
            },
            SessionSearchCandidate {
                kind: "message".into(),
                conversation_id: "conv-best".into(),
                message_id: Some("msg-best".into()),
                source: "best".into(),
                content: "best".into(),
                metadata: None,
                score: 100,
                recency: 5,
            },
