    )
    .await
}

pub async fn diagnose_agent_run(
    store: &AppStore,
    run_id: String,
    app: Option<&AppHandle>,
) -> AppResult<ChatMessage> {
    let (conversation, reply) = generate_agent_run_diagnosis_reply(store, &run_id).await?;
    store.add_usage(reply.prompt_tokens, reply.completion_tokens)?;
    let message = ChatMessage::new(conversation.id.clone(), "assistant", reply.content, "desktop-diagnosis");
    store.append_message(message.clone())?;
    emit_agent_run_event(app, &store.agent_run(&run_id)?, "diagnosed", Some(&message), None, None);
    Ok(message)
}

async fn generate_agent_run_diagnosis_reply(
    store: &AppStore,
    run_id: &str,
) -> AppResult<(Conversation, crate::llm::LlmReply)> {
    let run = store.agent_run(run_id)?;
    let conversation = store.conversation(&run.conversation_id)?;
    let persona = store.persona(Some(&run.persona_id))?;
    let agent = store.agent(Some(&run.agent_id))?;
    let provider_id = selected_provider_id(&persona, &agent);
    let provider = store.provider(provider_id)?;
    let effective_persona = effective_llm_persona(&persona, &agent);
    let planner_traces = store
        .planner_traces()?
        .into_iter()
        .filter(|trace| trace.run_id == run_id)
        .rev()
        .take(8)
        .collect::<Vec<_>>();
    let router_traces = store
        .tool_router_traces()?
        .into_iter()
        .filter(|trace| {
            trace.conversation_id == run.conversation_id
                && trace.agent_id == run.agent_id
                && trace.created_at.as_str() >= run.started_at.as_str()
                && run
                    .completed_at
                    .as_deref()
                    .map(|completed_at| trace.created_at.as_str() <= completed_at)
                    .unwrap_or(true)
        })
        .rev()
        .take(8)
        .collect::<Vec<_>>();
    let tool_traces = store
        .tool_traces()?
        .into_iter()
        .filter(|trace| trace.event.run_id.as_deref() == Some(run_id))
        .rev()
        .take(12)
        .collect::<Vec<_>>();
    let approvals = store
        .tool_approvals()?
        .into_iter()
        .filter(|approval| approval.run_id.as_deref() == Some(run_id))
        .collect::<Vec<_>>();
    let todos = store.agent_todos_for_run(run_id)?;
    let scheduled_jobs = store
        .scheduled_agent_jobs()?
        .into_iter()
        .filter(|job| job.conversation_id.as_deref() == Some(run.conversation_id.as_str()))
        .collect::<Vec<_>>();
    let scheduled_job_outputs = scheduled_job_output_evidence(&scheduled_jobs);
    let evidence = json!({
        "run": run,
        "plannerTracesRecent": planner_traces,
        "routerTracesRecent": router_traces,
        "toolTracesRecent": tool_traces,
        "toolApprovals": approvals,
        "agentTodos": todos,
        "scheduledAgentJobs": scheduled_jobs,
        "scheduledJobOutputs": scheduled_job_outputs,
    });
    let evidence_text = truncate_for_prompt(&serde_json::to_string_pretty(&evidence).unwrap_or_else(|_| evidence.to_string()), 24000);
    let prompt = format!(
        "Analyze this SynthChat agent run and explain why it did or did not complete the user's task.\n\nEvidence JSON:\n{}\n\nReturn Chinese. Structure the answer with: 1) 结论, 2) 关键证据, 3) 根因, 4) 下一步修复建议. Be concrete and reference run states, checkpoints, tool calls, approvals, scheduled jobs, queues, or planner decisions from the evidence.",
        evidence_text
    );
    let reply = complete_text_prompt_with_failover(
        store,
        &provider,
        &effective_persona,
        "You are an agent runtime failure analyst. Use only the provided evidence. Do not invent missing logs.".into(),
        prompt,
    )
    .await?;
    Ok((conversation, reply))
}

pub fn export_agent_run_bundle(store: &AppStore, run_id: String) -> AppResult<String> {
    let run = store.agent_run(&run_id)?;
    let related_runs = related_agent_runs_for_export(store, &run)?;
    let export_window_started_at = related_runs
        .iter()
        .map(|run| run.started_at.as_str())
        .min()
        .unwrap_or(run.started_at.as_str())
        .to_string();
    let export_window_completed_at = if related_runs.iter().any(|run| run.completed_at.is_none()) {
        None
    } else {
        related_runs
            .iter()
            .filter_map(|run| run.completed_at.as_deref().or(Some(run.updated_at.as_str())))
            .max()
            .map(str::to_string)
    };
    let related_run_ids = related_runs
        .iter()
        .map(|run| run.run_id.clone())
        .collect::<BTreeSet<_>>();
    let (state_snapshot_ids, workspace_snapshot_ids) =
        snapshot_refs_for_run_bundle(&related_runs);
    let state_snapshots = store
        .state_snapshots()?
        .into_iter()
        .filter(|snapshot| {
            snapshot
                .get("id")
                .and_then(Value::as_str)
                .map(|id| state_snapshot_ids.contains(id))
                .unwrap_or(false)
        })
        .collect::<Vec<_>>();
    let workspace_snapshots = store
        .workspace_snapshots()?
        .into_iter()
        .filter(|snapshot| {
            snapshot
                .get("id")
                .and_then(Value::as_str)
                .map(|id| workspace_snapshot_ids.contains(id))
                .unwrap_or(false)
        })
        .collect::<Vec<_>>();
    let mut messages = store.messages(&run.conversation_id, None)?;
    if matches!(mode, AgentRunEvidenceMode::Recent) && messages.len() > 20 {
        let keep_from = messages.len() - 20;
        messages.drain(0..keep_from);
    }
    let planner_traces = store
        .planner_traces()?
        .into_iter()
        .filter(|trace| related_run_ids.contains(trace.run_id.as_str()))
        .collect::<Vec<_>>();
    let tool_router_traces = store
        .tool_router_traces()?
        .into_iter()
        .filter(|trace| {
            trace.conversation_id == run.conversation_id
                && trace.agent_id == run.agent_id
                && trace.created_at.as_str() >= export_window_started_at.as_str()
                && export_window_completed_at
                    .as_deref()
                    .map(|completed_at| trace.created_at.as_str() <= completed_at)
                    .unwrap_or(true)
        })
        .collect::<Vec<_>>();
    let tool_traces = store
        .tool_traces()?
        .into_iter()
        .filter(|trace| {
            trace
                .event
                .run_id
                .as_deref()
                .map(|id| related_run_ids.contains(id))
                .unwrap_or(false)
        })
        .collect::<Vec<_>>();
    let approvals = store
        .tool_approvals()?
        .into_iter()
        .filter(|approval| {
            approval
                .run_id
                .as_deref()
                .map(|id| related_run_ids.contains(id))
                .unwrap_or(false)
        })
        .collect::<Vec<_>>();
    let todos = related_run_ids
        .iter()
        .filter_map(|run_id| store.agent_todos_for_run(run_id).ok())
        .flatten()
        .collect::<Vec<_>>();
    let queue = store
        .agent_queue()?
        .into_iter()
        .filter(|item| item.conversation_id == run.conversation_id)
        .collect::<Vec<_>>();
    let scheduled_jobs = store
        .scheduled_agent_jobs()?
        .into_iter()
        .filter(|job| job.conversation_id.as_deref() == Some(run.conversation_id.as_str()))
        .collect::<Vec<_>>();
    let scheduled_job_outputs = scheduled_job_output_evidence(&scheduled_jobs);
    let bundle = json!({
        "exportedAt": now_iso(),
        "primaryRunId": run_id,
        "relatedRunIds": related_run_ids.iter().cloned().collect::<Vec<_>>(),
        "run": run,
        "relatedAgentRuns": related_runs,
        "messages": messages,
        "plannerTraces": planner_traces,
        "toolRouterTraces": tool_router_traces,
        "toolTraces": tool_traces,
        "toolApprovals": approvals,
        "agentTodos": todos,
        "stateSnapshots": state_snapshots,
        "workspaceSnapshots": workspace_snapshots,
        "agentQueue": queue,
        "scheduledAgentJobs": scheduled_jobs,
        "scheduledJobOutputs": scheduled_job_outputs,
    });
    let content = serde_json::to_string_pretty(&bundle).unwrap_or_else(|_| bundle.to_string());
    let path = store.save_tool_artifact(&run_id, "agent_run_bundle", &content)?;
    Ok(path.to_string_lossy().to_string())
}

fn related_agent_runs_for_export(
    store: &AppStore,
    run: &AgentRunRecord,
) -> AppResult<Vec<AgentRunRecord>> {
    let all_runs = store.agent_runs()?;
    let mut root_id = run.run_id.clone();
    let mut visited = BTreeSet::new();
    while let Some(parent_id) = all_runs
        .iter()
        .find(|candidate| candidate.run_id == root_id)
        .and_then(|candidate| candidate.parent_run_id.clone())
    {
        if !visited.insert(parent_id.clone()) {
            break;
        }
        root_id = parent_id;
    }

    let mut related_ids = BTreeSet::new();
    collect_descendant_run_ids(&all_runs, &root_id, &mut related_ids);
    if related_ids.is_empty() {
        related_ids.insert(run.run_id.clone());
    }

    let mut related_runs = all_runs
        .into_iter()
        .filter(|candidate| related_ids.contains(&candidate.run_id))
        .collect::<Vec<_>>();
    related_runs.sort_by(|left, right| {
        left.started_at
            .cmp(&right.started_at)
            .then_with(|| left.run_id.cmp(&right.run_id))
    });
    Ok(related_runs)
}

fn collect_descendant_run_ids(
    runs: &[AgentRunRecord],
    run_id: &str,
    related_ids: &mut BTreeSet<String>,
) {
    if !related_ids.insert(run_id.to_string()) {
        return;
    }
    for child in runs
        .iter()
        .filter(|candidate| candidate.parent_run_id.as_deref() == Some(run_id))
    {
        collect_descendant_run_ids(runs, &child.run_id, related_ids);
    }
}

fn snapshot_refs_for_run_bundle(
    runs: &[AgentRunRecord],
) -> (BTreeSet<String>, BTreeSet<String>) {
    let mut state_ids = BTreeSet::new();
    let mut workspace_ids = BTreeSet::new();
    for run in runs {
        for checkpoint in &run.checkpoints {
            for event_ref in &checkpoint.event_refs {
                collect_snapshot_ref_from_str(event_ref, &mut state_ids, &mut workspace_ids);
            }
            collect_snapshot_ref_from_str(&checkpoint.summary, &mut state_ids, &mut workspace_ids);
        }
        for event in &run.tool_events {
            collect_snapshot_refs_from_value(event, &mut state_ids, &mut workspace_ids);
        }
        for phase in &run.phase_events {
            collect_snapshot_refs_from_value(&phase.detail, &mut state_ids, &mut workspace_ids);
        }
    }
    (state_ids, workspace_ids)
}

fn collect_snapshot_refs_from_value(
    value: &Value,
    state_ids: &mut BTreeSet<String>,
    workspace_ids: &mut BTreeSet<String>,
) {
    match value {
        Value::String(text) => collect_snapshot_ref_from_str(text, state_ids, workspace_ids),
        Value::Array(items) => {
            for item in items {
                collect_snapshot_refs_from_value(item, state_ids, workspace_ids);
            }
        }
        Value::Object(map) => {
            let mut key_context = SnapshotRefContext::Any;
            if map
                .keys()
                .any(|key| key.to_ascii_lowercase().contains("workspace"))
            {
                key_context = SnapshotRefContext::Workspace;
            } else if map
                .keys()
                .any(|key| key.to_ascii_lowercase().contains("state"))
            {
                key_context = SnapshotRefContext::State;
            }
            for (key, item) in map {
                collect_snapshot_ref_from_key_value(key, item, key_context, state_ids, workspace_ids);
                collect_snapshot_refs_from_value(item, state_ids, workspace_ids);
            }
        }
        _ => {}
    }
}

#[derive(Debug, Clone, Copy)]
enum SnapshotRefContext {
    Any,
    State,
    Workspace,
}

fn collect_snapshot_ref_from_key_value(
    key: &str,
    value: &Value,
    parent_context: SnapshotRefContext,
    state_ids: &mut BTreeSet<String>,
    workspace_ids: &mut BTreeSet<String>,
) {
    let key = key.to_ascii_lowercase();
    let context = if key.contains("workspace") {
        SnapshotRefContext::Workspace
    } else if key.contains("state") {
        SnapshotRefContext::State
    } else {
        parent_context
    };
    if matches!(key.as_str(), "id" | "snapshotid" | "snapshot_id") {
        if let Some(id) = value.as_str() {
            match context {
                SnapshotRefContext::State => {
                    if id.starts_with("snap-") {
                        state_ids.insert(id.to_string());
                    }
                }
                SnapshotRefContext::Workspace => {
                    if id.starts_with("wsnap-") {
                        workspace_ids.insert(id.to_string());
                    }
                }
                SnapshotRefContext::Any => {
                    collect_snapshot_ref_from_str(id, state_ids, workspace_ids);
                }
            }
        }
    }
}

fn collect_snapshot_ref_from_str(
    text: &str,
    state_ids: &mut BTreeSet<String>,
    workspace_ids: &mut BTreeSet<String>,
) {
    for token in text.split(|ch: char| {
        !(ch.is_ascii_alphanumeric() || matches!(ch, '-' | '_' | ':'))
    }) {
        let token = token.trim();
        let candidate = token
            .strip_prefix("stateSnapshot:")
            .or_else(|| token.strip_prefix("state_snapshot:"))
            .unwrap_or(token);
        if candidate.starts_with("snap-") {
            state_ids.insert(candidate.to_string());
            continue;
        }
        let candidate = token
            .strip_prefix("workspaceSnapshot:")
            .or_else(|| token.strip_prefix("workspace_snapshot:"))
            .unwrap_or(token);
        if candidate.starts_with("wsnap-") {
            workspace_ids.insert(candidate.to_string());
        }
    }
}

pub fn export_conversation_snapshot(
    store: &AppStore,
    conversation_id: &str,
    label: &str,
) -> AppResult<String> {
    let conversation = store.conversation(conversation_id)?;
    let messages = store.messages(conversation_id, None)?;
    let persona = conversation
        .persona_id
        .as_deref()
        .and_then(|persona_id| store.persona(Some(persona_id)).ok());
    let agent = store.agent(Some(&conversation.agent_id)).ok();
    let short_context = store.short_context(conversation_id)?;
    let runs = store
        .agent_runs()?
        .into_iter()
        .filter(|run| run.conversation_id == conversation_id)
        .collect::<Vec<_>>();
    let run_ids = runs
        .iter()
        .map(|run| run.run_id.clone())
        .collect::<std::collections::BTreeSet<_>>();
    let planner_traces = store
        .planner_traces()?
        .into_iter()
        .filter(|trace| trace.conversation_id == conversation_id)
        .collect::<Vec<_>>();
    let tool_router_traces = store
        .tool_router_traces()?
        .into_iter()
        .filter(|trace| trace.conversation_id == conversation_id)
        .collect::<Vec<_>>();
    let tool_traces = store
        .tool_traces()?
        .into_iter()
        .filter(|trace| {
            trace
                .event
                .run_id
                .as_deref()
                .map(|run_id| run_ids.contains(run_id))
                .unwrap_or(false)
        })
        .collect::<Vec<_>>();
    let approvals = store
        .tool_approvals()?
        .into_iter()
        .filter(|approval| approval.conversation_id.as_deref() == Some(conversation_id))
        .collect::<Vec<_>>();
    let queue = store
        .agent_queue()?
        .into_iter()
        .filter(|item| item.conversation_id == conversation_id)
        .collect::<Vec<_>>();
    let todos = runs
        .iter()
        .flat_map(|run| store.agent_todos_for_run(&run.run_id).unwrap_or_default())
        .collect::<Vec<_>>();
    let scheduled_jobs = store
        .scheduled_agent_jobs()?
        .into_iter()
        .filter(|job| job.conversation_id.as_deref() == Some(conversation_id))
        .collect::<Vec<_>>();
    let scheduled_job_outputs = scheduled_job_output_evidence(&scheduled_jobs);
    let label = label.trim();
    let snapshot = json!({
        "exportedAt": now_iso(),
        "label": if label.is_empty() { Value::Null } else { json!(label) },
        "kind": "conversation_snapshot",
        "conversation": conversation,
        "persona": persona,
        "agent": agent,
        "messages": messages,
        "shortContext": short_context,
        "agentRuns": runs,
        "plannerTraces": planner_traces,
        "toolRouterTraces": tool_router_traces,
        "toolTraces": tool_traces,
        "toolApprovals": approvals,
        "agentQueue": queue,
        "agentTodos": todos,
        "scheduledAgentJobs": scheduled_jobs,
        "scheduledJobOutputs": scheduled_job_outputs,
    });
    let content = serde_json::to_string_pretty(&snapshot).unwrap_or_else(|_| snapshot.to_string());
    let path = store.save_tool_artifact(conversation_id, "conversation_snapshot", &content)?;
    Ok(path.to_string_lossy().to_string())
}

fn scheduled_job_output_evidence(jobs: &[ScheduledAgentJob]) -> Vec<Value> {
    jobs.iter()
        .filter_map(|job| {
            let path = job.last_output_path.as_deref()?;
            let content = fs::read_to_string(path).ok()?;
            Some(json!({
                "jobId": job.id,
                "path": path,
                "content": truncate_for_prompt(&content, 8000),
            }))
        })
        .collect()
}

pub fn abort_agent_run(
    store: &AppStore,
    run_id: String,
    reason: Option<String>,
    app: Option<&AppHandle>,
) -> AppResult<AgentRunRecord> {
    let saved = store.abort_agent_run(&run_id, reason.clone())?;
    for approval in store
        .tool_approvals()?
        .into_iter()
        .filter(|approval| approval.run_id.as_deref() == Some(saved.run_id.as_str()) && approval.status == "pending")
    {
        let _ = store.update_tool_approval(
            &approval.id,
            "denied",
            None,
            Some(reason.clone().unwrap_or_else(|| "Agent run aborted by user.".into())),
        );
    }
    emit_agent_run_event(app, &saved, "aborted", None, None, saved.error.as_deref());
    Ok(saved)
}

