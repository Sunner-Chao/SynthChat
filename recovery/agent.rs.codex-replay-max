pub async fn run_chat_turn(store: &AppStore, request: SendChatRequest, app: Option<&AppHandle>) -> AppResult<Vec<ChatMessage>> {
    run_chat_turn_with_options(store, request, app, AgentRuntimeOptions::default()).await
}

#[derive(Debug, Clone, Default)]
struct AgentRuntimeOptions {
    enabled_toolsets: Option<Vec<String>>,
    disabled_toolsets: Vec<String>,
}

impl AgentRuntimeOptions {
    fn apply_to_agent(&self, agent: &mut AgentDefinition) {
        if let Some(enabled) = &self.enabled_toolsets {
            agent.enabled_toolsets = enabled.clone();
        }
        for toolset in &self.disabled_toolsets {
            if !agent.disabled_toolsets.iter().any(|item| item == toolset) {
                agent.disabled_toolsets.push(toolset.clone());
            }
        }
    }
}

async fn run_chat_turn_with_options(
    store: &AppStore,
    request: SendChatRequest,
    app: Option<&AppHandle>,
    runtime_options: AgentRuntimeOptions,
) -> AppResult<Vec<ChatMessage>> {
    let clean = request.content.trim().to_string();
    if clean.is_empty() {
        return Ok(vec![]);
    }

    let persona = store.persona(request.persona_id.as_deref())?;
    let conversation = match request.conversation_id.as_deref() {
        Some(id) if !id.trim().is_empty() => {
            let existing = store.conversation(id)?;
            if existing.persona_id.as_deref() == Some(persona.id.as_str()) {
                existing
            } else {
                store.create_conversation(None, Some(persona.id.clone()))?
            }
        }
        _ => store.create_conversation(None, Some(persona.id.clone()))?,
    };
    let mut agent = store.agent(Some(&conversation.agent_id))?;
    runtime_options.apply_to_agent(&mut agent);

    if let Some(control_reply) = handle_agent_control_command(store, &conversation, &persona, &clean, app).await? {
        let user_message = ChatMessage::new(conversation.id.clone(), "user", clean.clone(), "desktop");
        store.append_message(user_message.clone())?;
        store.append_message(control_reply.clone())?;
        return Ok(vec![user_message, control_reply]);
    }

    let user_message = ChatMessage::new(conversation.id.clone(), "user", clean.clone(), "desktop");
    store.append_message(user_message.clone())?;

    if let Some(active_run) = wait_for_conversation_slot(store, &conversation.id).await? {
        let queued = store.enqueue_agent_request(conversation.id.clone(), persona.id.clone(), &user_message)?;
        let assistant = ChatMessage::new(
            conversation.id.clone(),
            "assistant",
            format!(
                "当前会话已有运行中的 agent run：{}，已将这条请求加入队列：{}。当前 run 完成后会自动继续。",
                active_run.run_id, queued.id
            ),
            "desktop",
        );
        store.append_message(assistant.clone())?;
        return Ok(vec![user_message, assistant]);
    }

    if let Some(summary) = parse_remember_command(&clean) {
        let memory = store.save_memory(crate::models::MemoryEntry {
            id: String::new(),
            persona_id: persona.id.clone(),
            summary: summary.to_string(),
            importance: 4,
            created_at: String::new(),
            updated_at: String::new(),
        })?;
        let assistant = ChatMessage::new(
            conversation.id,
            "assistant",
            format!("已写入 `{}` 的长期记忆：{}", persona.name, memory.summary),
            "desktop",
        );
        store.append_message(assistant.clone())?;
        return Ok(vec![user_message, assistant]);
    }

    let mut run = AgentRunRecord::new(conversation.id.clone(), persona.id.clone(), agent.id.clone());
    run.user_request = clean.clone();
    store.save_agent_run(run.clone())?;
    emit_agent_run_event(app, &run, "running", None, None, None);

    if let Some((server_id, tool_name, payload)) = parse_tool_command(&clean) {
        let retry_config = store.config()?.chat;
        let result = call_mcp_tool_with_retry(
            store,
            server_id.clone(),
            tool_name.clone(),
            payload,
            None,
            retry_config.tool_call_retry_count,
            retry_config.tool_call_retry_backoff_ms,
        ).await?;
        let traces = store.tool_traces()?;
        let latest_event = traces
            .iter()
            .rev()
            .find(|trace| trace.server_id == server_id && trace.tool_name == tool_name)
            .map(|trace| trace.event.clone());
        if let Some(event) = latest_event {
            let tool_message = ChatMessage::new(
                conversation.id.clone(),
                "tool",
                json!({"type": "toolEvent", "event": event}).to_string(),
                "desktop",
            );
            store.append_message(tool_message.clone())?;
            run.tool_events.push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));
            run.state = if result.ok { "completed".into() } else { "failed".into() };
            run.error = result.error.clone();
            run.updated_at = now_iso();
            run.completed_at = Some(run.updated_at.clone());
            store.save_agent_run(run.clone())?;
            let assistant = ChatMessage::new(
                conversation.id.clone(),
                "assistant",
                if result.ok {
                    format!("工具 `{server_id}.{tool_name}` 调用完成。")
                } else {
                    format!("工具 `{server_id}.{tool_name}` 调用失败：{}", result.error.unwrap_or_else(|| result.stderr))
                },
                "desktop",
            );
            store.append_message(assistant.clone())?;
            drain_agent_queue(store, &conversation.id, app).await?;
            return Ok(vec![user_message, tool_message, assistant]);
        }
    }

    let result: Result<AgentTurn, AppError> = async {
        let config = store.config()?;
        let provider_id = if !persona.llm_provider.trim().is_empty() {
            Some(persona.llm_provider.as_str())
        } else if !agent.llm_provider.trim().is_empty() {
            Some(agent.llm_provider.as_str())
        } else {
            None
        };
        let provider = store.provider(provider_id)?;
        let all_history = store.messages(&conversation.id, None)?;
        let short_context = prepare_short_context(
            store,
            &conversation,
            &persona,
            &provider,
            &all_history,
            config.chat.max_context_rounds,
            config.chat.short_context_token_budget,
            &config.chat.short_context_mode,
        ).await?;
        let history = context_window_messages(
            &all_history,
            &short_context,
            config.chat.max_context_rounds * 2 + 1,
        );
        let memories = if persona
            .memory
            .get("enabled")
            .and_then(Value::as_bool)
            .unwrap_or(true)
            && persona
                .memory
                .get("includeInPrompt")
                .and_then(Value::as_bool)
                .unwrap_or(true)
        {
            let max = persona.memory.get("maxMemories").and_then(Value::as_u64).unwrap_or(50) as usize;
            let mut items = store.memories(Some(&persona.id))?;
            items.truncate(max.max(1));
            items
        } else {
            vec![]
        };
        let skill_blocks = skills::prompt_blocks_for_request(store, &agent, &clean)?;
        let worldbook_blocks = matching_worldbook_blocks(store, &persona, &clean)?;
        let system_prompt = build_system_prompt(
            &conversation,
            &persona,
            &memories,
            &skill_blocks,
            &worldbook_blocks,
            &short_context,
        );
        if let Some(tool_turn) = maybe_run_auto_tool(
            store,
            &conversation,
            &persona,
            &agent,
            &mut run,
            &provider,
            &system_prompt,
            &clean,
            &history,
            vec![],
            vec![],
            app,
        ).await? {
            Ok(tool_turn)
        } else {
            let reply = complete_chat_with_failover(store, &provider, &persona, system_prompt, history, &clean).await?;
            Ok(AgentTurn::Plain(reply))
        }
    }
    .await;

    if agent_run_aborted(store, &run)?
        && !matches!(&result, Ok(AgentTurn::WithTools { run_state: Some(state), .. }) if state == "aborted")
    {
        let saved = store.agent_run(&run.run_id)?;
        run.state = "aborted".into();
        run.error = saved.error.clone().or_else(|| Some("Agent run aborted by user.".into()));
        run.checkpoints = saved.checkpoints.clone();
        run.completed_at = saved.completed_at.clone().or_else(|| Some(now_iso()));
        run.updated_at = now_iso();
        let message = ChatMessage::new(
            conversation.id.clone(),
            "assistant",
            "已中止当前 agent run，结果不会继续落为完成态。".into(),
            "desktop",
        );
        store.append_message(message.clone())?;
        store.save_agent_run(run.clone())?;
        emit_agent_run_event(app, &run, "aborted", Some(&message), None, run.error.as_deref());
        drain_agent_queue(store, &conversation.id, app).await?;
        return Ok(vec![user_message, message]);
    }

    match result {
        Ok(AgentTurn::Plain(reply)) => {
            store.add_usage(reply.prompt_tokens, reply.completion_tokens)?;
            let assistant = ChatMessage::new(conversation.id.clone(), "assistant", reply.content, "desktop-stream");
            store.append_message(assistant.clone())?;
            run.state = "completed".into();
            run.updated_at = now_iso();
            run.completed_at = Some(run.updated_at.clone());
            push_run_checkpoint(&mut run, 1, "completed", "LLM reply generated", Vec::new(), Vec::new());
            store.save_agent_run(run.clone())?;
            emit_agent_run_event(app, &run, "completed", Some(&assistant), None, None);
            drain_agent_queue(store, &conversation.id, app).await?;
            Ok(vec![user_message, assistant])
        }
        Ok(AgentTurn::WithTools { tool_messages, assistant, prompt_tokens, completion_tokens, run_state }) => {
            store.add_usage(prompt_tokens, completion_tokens)?;
            run.state = run_state.unwrap_or_else(|| "completed".into());
            run.updated_at = now_iso();
            if matches!(run.state.as_str(), "completed" | "failed" | "aborted" | "needsClarification") {
                run.completed_at = Some(run.updated_at.clone());
            }
            if run.state == "completed" {
                push_run_checkpoint(&mut run, 1, "completed", "Tool routed and final reply generated", Vec::new(), Vec::new());
            }
            store.save_agent_run(run.clone())?;
            emit_agent_run_event(app, &run, &run.state, Some(&assistant), None, run.error.as_deref());
            drain_agent_queue(store, &conversation.id, app).await?;
            let mut messages = vec![user_message];
            messages.extend(tool_messages);
            messages.push(assistant);
            Ok(messages)
        }
        Err(error) => {
            let message = ChatMessage::new(
                conversation.id.clone(),
                "assistant",
                format!("对话链执行失败：{error}"),
                "desktop",
            );
            store.append_message(message.clone())?;
            run.state = "failed".into();
            run.error = Some(error.to_string());
            run.updated_at = now_iso();
            run.completed_at = Some(run.updated_at.clone());
            store.save_agent_run(run.clone())?;
            emit_agent_run_event(app, &run, "failed", Some(&message), None, run.error.as_deref());
            drain_agent_queue(store, &conversation.id, app).await?;
            Ok(vec![user_message, message])
        }
    }
}

pub fn spawn_background_chat_turn(
    app_handle: AppHandle,
    conversation_id: String,
    persona_id: String,
    prompt: String,
) {
    spawn_background_chat_turn_for_job(app_handle, conversation_id, persona_id, prompt, None);
}

pub fn spawn_background_chat_turn_for_job(
    app_handle: AppHandle,
    conversation_id: String,
    persona_id: String,
    prompt: String,
    scheduled_job: Option<ScheduledAgentJob>,
) {
    std::thread::spawn(move || {
        let error_conversation_id = conversation_id.clone();
        let store = app_handle.state::<AppStore>();
        let job_id = scheduled_job.as_ref().map(|job| job.id.clone());
        let runtime_options = scheduled_job
            .as_ref()
            .map(|job| AgentRuntimeOptions {
                enabled_toolsets: if job.enabled_toolsets.is_empty() { None } else { Some(job.enabled_toolsets.clone()) },
                disabled_toolsets: job.disabled_toolsets.clone(),
            })
            .unwrap_or_default();
        let content = if job_id.is_some() {
            scheduled_job_runtime_prompt(&prompt)
        } else {
            prompt
        };
        let result = tauri::async_runtime::block_on(run_chat_turn_with_options(
            store.inner(),
            SendChatRequest {
                conversation_id: Some(conversation_id),
                persona_id: Some(persona_id),
                content,
            },
            Some(&app_handle),
            runtime_options,
        ));
        match result {
            Ok(messages) => {
                if let Some(job_id) = job_id.as_deref() {
                    let output = messages
                        .iter()
                        .rev()
                        .find(|message| message.role == "assistant")
                        .map(|message| message.content.clone())
                        .or_else(|| messages.last().map(|message| message.content.clone()));
                    let _ = store.record_scheduled_agent_job_result(job_id, "completed", output, None);
                }
            }
            Err(error) => {
                let error_text = error.to_string();
                let message = ChatMessage::new(
                    error_conversation_id,
                    "assistant",
                    format!("后台任务执行失败：{}", error_text),
                    "desktop-control",
                );
                let _ = store.append_message(message);
                if let Some(job_id) = job_id.as_deref() {
                    let _ = store.record_scheduled_agent_job_result(job_id, "failed", None, Some(error_text));
                }
            }
        }
    });
}

fn maybe_spawn_background_memory_review(
    store: &AppStore,
    app: Option<&AppHandle>,
    conversation_id: &str,
    persona_id: &str,
    run_id: &str,
) {
    let Ok(config) = store.config() else {
        return;
    };
    if !config.chat.background_memory_review_enabled
        && !config.chat.background_skill_review_enabled
        && !config.chat.background_skill_curator_enabled
    {
        return;
    }
    let Some(app_handle) = app.cloned() else {
        return;
    };
    let conversation_id = conversation_id.to_string();
    let persona_id = persona_id.to_string();
    let run_id = run_id.to_string();
    std::thread::spawn(move || {
        let store = app_handle.state::<AppStore>();
        let memory_result = tauri::async_runtime::block_on(run_background_memory_review(
            store.inner(),
            &app_handle,
            &conversation_id,
            &persona_id,
            &run_id,
        ));
        if let Err(error) = memory_result {
            if let Ok(mut run) = store.agent_run(&run_id) {
                let _ = record_agent_stage(
                    store.inner(),
                    Some(&app_handle),
                    &mut run,
                    "background_memory_review_failed",
                    json!({"error": error.to_string()}),
                );
            }
        }
        let skill_result = tauri::async_runtime::block_on(run_background_skill_review(
            store.inner(),
            &app_handle,
            &conversation_id,
            &persona_id,
            &run_id,
        ));
        if let Err(error) = skill_result {
            if let Ok(mut run) = store.agent_run(&run_id) {
                let _ = record_agent_stage(
                    store.inner(),
                    Some(&app_handle),
                    &mut run,
                    "background_skill_review_failed",
                    json!({"error": error.to_string()}),
                );
            }
        }
        let curator_result = maybe_run_background_skill_curator(
            store.inner(),
            Some(&app_handle),
            &run_id,
        );
        if let Err(error) = curator_result {
            if let Ok(mut run) = store.agent_run(&run_id) {
                let _ = record_agent_stage(
                    store.inner(),
                    Some(&app_handle),
                    &mut run,
                    "background_skill_curator_failed",
                    json!({"error": error.to_string()}),
                );
            }
        }
    });
}

fn maybe_run_background_skill_curator(
    store: &AppStore,
    app: Option<&AppHandle>,
    run_id: &str,
) -> AppResult<()> {
    let config = store.config()?.chat;
    if !config.background_skill_curator_enabled {
        return Ok(());
    }
    let state = skills::skill_curator_state(store)?;
    if state.paused {
        return Ok(());
    }
    let interval_hours = config.background_skill_curator_interval_hours.max(1) as i64;
    if let Some(last_run_at) = state.last_run_at.as_deref() {
        if let Ok(last_run_at) = DateTime::parse_from_rfc3339(last_run_at) {
            let elapsed = Utc::now().signed_duration_since(last_run_at.with_timezone(&Utc));
            if elapsed < ChronoDuration::hours(interval_hours) {
                return Ok(());
            }
        }
    }
    let report = skills::curate_skills_report(store)?;
    if let Ok(mut run) = store.agent_run(run_id) {
        record_agent_stage(
            store,
            app,
            &mut run,
            "background_skill_curator",
            json!({
                "reportPath": report.report_path,
                "totalSkills": report.total_skills,
                "externalSkills": report.external_skills,
                "overlapClusters": report.overlap_clusters.len(),
                "archiveCandidates": report.archive_candidates.len(),
                "auditAttention": report.audit_attention
            }),
        )?;
    }
    Ok(())
}

async fn run_background_memory_review(
    store: &AppStore,
    app: &AppHandle,
    conversation_id: &str,
    persona_id: &str,
    run_id: &str,
) -> AppResult<()> {
    let config = store.config()?.chat;
    let messages = store.messages(conversation_id, None)?;
    if messages.len() < config.background_memory_review_min_messages.max(1) {
        return Ok(());
    }

    let persona = store.persona(Some(persona_id))?;
    if !persona
        .memory
        .get("enabled")
        .and_then(Value::as_bool)
        .unwrap_or(true)
    {
        return Ok(());
    }
    let conversation = store.conversation(conversation_id)?;
    let agent = store.agent(Some(&conversation.agent_id))?;
    let provider = store.provider(selected_provider_id(&persona, &agent))?;
    if provider.provider_type == "echo" || provider.base_url.trim().is_empty() {
        return Ok(());
    }

    let recent = messages
        .iter()
        .rev()
        .take(16)
        .cloned()
        .collect::<Vec<_>>()
        .into_iter()
        .rev()
        .collect::<Vec<_>>();
    let transcript = render_messages_for_summary(&recent);
    if transcript.trim().is_empty() {
        return Ok(());
    }

    let existing = store.memories(Some(&persona.id))?;
    let existing_text = if existing.is_empty() {
        "(none)".into()
    } else {
        existing
            .iter()
            .take(30)
            .map(|memory| format!("- {} [{}] {}", memory.id, memory.importance, memory.summary))
            .collect::<Vec<_>>()
            .join("\n")
    };
    let system_prompt = [
        "You are a background memory reviewer for SynthChat.",
        "Review the conversation snapshot and decide whether durable user facts or preferences should be saved.",
        "Only save stable facts about the user, their preferences, work style, or expectations for the assistant.",
        "Do not save transient task details, temporary errors, environment-specific failures, or facts already present in existing memories.",
        "Return JSON only.",
    ]
    .join("\n");
    let user_prompt = format!(
        "Persona: {} ({})\n\nExisting memories:\n{}\n\nRecent conversation:\n{}\n\nReturn exactly this JSON shape:\n{{\"memories\":[{{\"summary\":\"durable memory to save\",\"importance\":1-5,\"reason\":\"short reason\"}}]}}\nIf nothing should be saved, return {{\"memories\":[]}}.",
        persona.name,
        persona.id,
        existing_text,
        transcript
    );
    let review_persona = effective_llm_persona(&persona, &agent);
    let reply =
        complete_text_prompt_with_failover(store, &provider, &review_persona, system_prompt, user_prompt)
            .await?;
    let candidates = memory_review_candidates_from_reply(&reply.content);
    let existing_keys = existing
        .iter()
        .map(|memory| normalize_memory_dedupe_key(&memory.summary))
        .collect::<HashSet<_>>();
    let mut saved = Vec::new();
    let mut skipped_duplicates = 0usize;
    for candidate in candidates {
        let key = normalize_memory_dedupe_key(&candidate.summary);
        if key.is_empty() || existing_keys.contains(&key) || saved.iter().any(|item: &Value| {
            item.get("summary")
                .and_then(Value::as_str)
                .map(normalize_memory_dedupe_key)
                .as_deref()
                == Some(key.as_str())
        }) {
            skipped_duplicates += 1;
            continue;
        }
        let memory = store.save_memory(crate::models::MemoryEntry {
            id: String::new(),
            persona_id: persona.id.clone(),
            summary: candidate.summary,
            importance: candidate.importance,
            created_at: String::new(),
            updated_at: String::new(),
        })?;
        saved.push(json!({
            "memoryId": memory.id,
            "summary": memory.summary,
            "importance": memory.importance,
            "reason": candidate.reason
        }));
    }

    let mut run = store.agent_run(run_id)?;
    record_agent_stage(
        store,
        Some(app),
        &mut run,
        "background_memory_review",
        json!({
            "candidateCount": saved.len() + skipped_duplicates,
            "savedCount": saved.len(),
            "skippedDuplicates": skipped_duplicates,
            "saved": saved
        }),
    )?;
    Ok(())
}

async fn run_background_skill_review(
    store: &AppStore,
    app: &AppHandle,
    conversation_id: &str,
    persona_id: &str,
    run_id: &str,
) -> AppResult<()> {
    let config = store.config()?.chat;
    if !config.background_skill_review_enabled {
        return Ok(());
    }
    let messages = store.messages(conversation_id, None)?;
    if messages.len() < config.background_memory_review_min_messages.max(1) {
        return Ok(());
    }
    let persona = store.persona(Some(persona_id))?;
    let conversation = store.conversation(conversation_id)?;
    let agent = store.agent(Some(&conversation.agent_id))?;
    if !agent.skills_enabled {
        return Ok(());
    }
    let provider = store.provider(selected_provider_id(&persona, &agent))?;
    if provider.provider_type == "echo" || provider.base_url.trim().is_empty() {
        return Ok(());
    }
    let recent = messages
        .iter()
        .rev()
        .take(16)
        .cloned()
        .collect::<Vec<_>>()
        .into_iter()
        .rev()
        .collect::<Vec<_>>();
    let transcript = render_messages_for_summary(&recent);
    if transcript.trim().is_empty() {
        return Ok(());
    }

    let skill_summaries = skills::list_skills_for_agent(store, &agent.id)?
        .into_iter()
        .take(40)
        .map(|skill| {
            format!(
                "- {} ({}) enabled={} source={} bundled={} path={} description={}",
                skill.name,
                skill.id,
                skill.enabled,
                skill.source,
                skill.is_bundled,
                skill.path,
                truncate_for_prompt(&skill.description.replace('\n', " "), 220)
            )
        })
        .collect::<Vec<_>>()
        .join("\n");
    let system_prompt = [
        "You are a background skill reviewer for SynthChat.",
        "Review the conversation snapshot and identify durable workflow lessons that should update the skill library.",
        "Do not ask to edit protected/bundled skills directly. Prefer existing non-bundled umbrella skills; otherwise recommend a new class-level skill.",
        "Do not record transient setup failures, one-off task narratives, or negative claims that a tool is broken.",
        "Return JSON only. You are reporting recommendations, not editing files.",
    ]
    .join("\n");
    let user_prompt = format!(
        "Agent: {} ({})\nPersona: {} ({})\n\nKnown skills:\n{}\n\nRecent conversation:\n{}\n\nReturn exactly this JSON shape:\n{{\"recommendations\":[{{\"action\":\"update_existing|create_new|add_reference|none\",\"skillId\":\"existing skill id or empty\",\"title\":\"short class-level title\",\"summary\":\"what should change and why\",\"supportFile\":\"references/name.md or empty\",\"priority\":1-5}}]}}\nIf nothing should be saved, return {{\"recommendations\":[]}}.",
        agent.name,
        agent.id,
        persona.name,
        persona.id,
        if skill_summaries.trim().is_empty() { "(none)" } else { &skill_summaries },
        transcript
    );
    let review_persona = effective_llm_persona(&persona, &agent);
    let reply =
        complete_text_prompt_with_failover(store, &provider, &review_persona, system_prompt, user_prompt)
            .await?;
    let recommendations = skill_review_recommendations_from_reply(&reply.content);
    let created_skills = if config.background_skill_review_auto_create_enabled {
        apply_background_skill_creates(store, &agent, &recommendations)?
    } else {
        Vec::new()
    };
    let mut run = store.agent_run(run_id)?;
    record_agent_stage(
        store,
        Some(app),
        &mut run,
        "background_skill_review",
        json!({
            "recommendationCount": recommendations.len(),
            "recommendations": recommendations,
            "autoCreateEnabled": config.background_skill_review_auto_create_enabled,
            "createdSkills": created_skills
        }),
    )?;
    Ok(())
}

fn apply_background_skill_creates(
    store: &AppStore,
    agent: &AgentDefinition,
    recommendations: &[SkillReviewRecommendation],
) -> AppResult<Vec<Value>> {
    let mut created = Vec::new();
    for recommendation in recommendations
        .iter()
        .filter(|item| item.action == "create_new")
        .take(2)
    {
        let title = recommendation.title.trim();
        let summary = recommendation.summary.trim();
        if title.is_empty() || summary.is_empty() {
            continue;
        }
        let raw = background_skill_markdown(recommendation);
        let skill = skills::install_external_skill_content(
            store,
            &raw,
            title,
            Some(title),
            Some("background-review"),
            Some(&agent.id),
            false,
            true,
            "background-skill-review",
        )?;
        created.push(json!({
            "skillId": skill.id,
            "name": skill.name,
            "path": skill.path,
            "sourceRecommendation": recommendation
        }));
    }
    Ok(created)
}

fn background_skill_markdown(recommendation: &SkillReviewRecommendation) -> String {
    let title = recommendation.title.trim();
    let summary = recommendation.summary.trim();
    format!(
        "---\nname: {title}\ndescription: {description}\nauthor: SynthChat background review\nversion: 1.0.0\n---\n\n# {title}\n\n## When To Use\n\nUse this skill when a future task matches this durable workflow lesson from prior SynthChat sessions.\n\n## Guidance\n\n{summary}\n\n## Provenance\n\nCreated by SynthChat background skill review. Review before broad reuse.\n",
        description = yaml_safe_line(summary, 180)
    )
}

fn yaml_safe_line(value: &str, max_chars: usize) -> String {
    value
        .replace(['\r', '\n'], " ")
        .replace(':', " -")
        .chars()
        .take(max_chars)
        .collect::<String>()
        .trim()
        .to_string()
}

fn spawn_conversation_queue_drain(app_handle: AppHandle, conversation_id: String) {
    std::thread::spawn(move || {
        let store = app_handle.state::<AppStore>();
        let _ = tauri::async_runtime::block_on(drain_agent_queue(
            store.inner(),
            &conversation_id,
            Some(&app_handle),
        ));
    });
}

fn scheduled_job_runtime_prompt(prompt: &str) -> String {
    format!(
        "Scheduled agent job runtime policy:\n- Execute the scheduled task directly.\n- Do not create, update, delete, pause, resume, or trigger scheduled jobs from this run.\n- Do not wait for interactive clarification; if required information is missing, report the blocker in the final answer.\n- Do not ask the user to approve a follow-up unless the task cannot safely proceed.\n\nScheduled task:\n{}",
        prompt.trim()
    )
