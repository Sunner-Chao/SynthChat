struct AgentIterationBudget {
    max_total: u32,
    used: u32,
}

impl AgentIterationBudget {
    fn new(max_total: u32) -> Self {
        Self { max_total: max_total.max(1), used: 0 }
    }

    fn consume(&mut self) -> Option<u32> {
        if self.used >= self.max_total {
            None
        } else {
            let iteration = self.used;
            self.used += 1;
            Some(iteration)
        }
    }

    fn remaining(&self) -> u32 {
        self.max_total.saturating_sub(self.used)
    }
}

