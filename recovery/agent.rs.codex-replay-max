    #[test]
    fn session_search_finds_saved_tool_artifacts() {
        let dir = std::env::temp_dir().join(format!(
            "synthchat-session-search-artifact-test-{}",
            new_id("state")
        ));
        let path = dir.join("state.json");
        let store = AppStore::new(path).unwrap();
        let persona = store.persona(None).unwrap();
        let conversation = store
            .create_conversation(Some("artifact search".into()), Some(persona.id.clone()))
            .unwrap();
        let run = AgentRunRecord::new(
            conversation.id.clone(),
            persona.id.clone(),
            conversation.agent_id.clone(),
        );
        store.save_agent_run(run.clone()).unwrap();
        store
            .save_tool_artifact(
                &run.run_id,
                "browser_snapshot",
                "checkout form uses POST /api/orders",
            )
            .unwrap();

        let (text, raw) = execute_internal_session_search(
            &store,
            &conversation,
            &json!({"query": "POST /api/orders", "kind": "artifact", "limit": 5}),
        )
        .unwrap();

        assert!(text.contains("artifact"));
        assert!(text.contains("POST /api/orders"));
        assert_eq!(raw.get("total").and_then(Value::as_u64), Some(1));
        let metadata = raw
            .get("results")
            .and_then(Value::as_array)
            .and_then(|items| items.first())
            .and_then(|item| item.get("metadata"))
            .unwrap();
        assert_eq!(
            metadata.get("runId").and_then(Value::as_str),
            Some(run.run_id.as_str())
        );
        assert!(metadata
            .get("fileName")
            .and_then(Value::as_str)
            .unwrap_or_default()
            .contains("browser_snapshot"));

        let _ = std::fs::remove_dir_all(dir);
    }

