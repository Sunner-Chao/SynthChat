    })
}

fn render_static_browser_snapshot(snapshot: &Value) -> String {
    let mut lines = Vec::new();
    lines.push(format!(
        "Static browser snapshot: {}",
        snapshot.get("url").and_then(Value::as_str).unwrap_or("")
    ));
    if let Some(title) = snapshot.get("title").and_then(Value::as_str) {
        if !title.is_empty() {
            lines.push(format!("title: {title}"));
        }
    }
    for key in ["forms", "controls", "buttons", "links", "requestClues"] {
        lines.push(format!("\n{key}:"));
        if let Some(items) = snapshot.get(key).and_then(Value::as_array) {
            if items.is_empty() {
                lines.push("- none".into());
            }
            for (index, item) in items.iter().enumerate() {
                lines.push(format!("{}: {}", index + 1, compact_json(item)));
            }
        }
    }
    if let Some(preview) = snapshot.get("textPreview").and_then(Value::as_str) {
        if !preview.is_empty() {
            lines.push(format!("\ntextPreview:\n{}", truncate_for_prompt(preview, 1200)));
        }
    }
    lines.join("\n")
}

fn extract_static_forms(html: &str, base_url: &str, limit: usize) -> Vec<Value> {
    let mut forms = Vec::new();
    let lower = html.to_lowercase();
    let mut offset = 0usize;
    while let Some(start_rel) = lower[offset..].find("<form") {
        let start = offset + start_rel;
        let Some(tag_end_rel) = lower[start..].find('>') else {
            break;
        };
        let tag_end = start + tag_end_rel + 1;
        let end = lower[tag_end..]
            .find("</form>")
            .map(|rel| tag_end + rel)
            .unwrap_or(tag_end);
        let tag = &html[start..tag_end];
        let body = &html[tag_end..end];
        let action = attr_value(tag, "action").unwrap_or_default();
        let absolute_action = resolve_url(base_url, &action);
        forms.push(json!({
            "method": attr_value(tag, "method").unwrap_or_else(|| "GET".into()).to_uppercase(),
            "action": action,
            "absoluteAction": absolute_action,
            "id": attr_value(tag, "id").unwrap_or_default(),
            "name": attr_value(tag, "name").unwrap_or_default(),
            "inputs": extract_static_inputs(body, limit),
            "buttons": extract_static_buttons(body, limit),
        }));
        if forms.len() >= limit {
            break;
        }
        offset = end.saturating_add("</form>".len());
    }
    forms
}

fn extract_static_inputs(html: &str, limit: usize) -> Vec<Value> {
    let mut inputs = Vec::new();
    for tag_name in ["input", "textarea", "select"] {
        let mut offset = 0usize;
        let lower = html.to_lowercase();
        let needle = format!("<{tag_name}");
        while let Some(start_rel) = lower[offset..].find(&needle) {
            let start = offset + start_rel;
            let Some(end_rel) = lower[start..].find('>') else {
                break;
            };
            let tag = &html[start..start + end_rel + 1];
            inputs.push(json!({
                "tag": tag_name,
                "type": attr_value(tag, "type").unwrap_or_else(|| if tag_name == "input" { "text".into() } else { tag_name.into() }),
                "name": attr_value(tag, "name").unwrap_or_default(),
                "id": attr_value(tag, "id").unwrap_or_default(),
                "placeholder": attr_value(tag, "placeholder").unwrap_or_default(),
                "required": tag.to_lowercase().contains(" required"),
            }));
            if inputs.len() >= limit {
                return inputs;
            }
            offset = start + end_rel + 1;
        }
    }
    inputs
}

fn extract_static_controls(html: &str, limit: usize) -> Vec<Value> {
    let mut controls = Vec::new();
    for tag_name in ["input", "textarea", "select", "button"] {
        let mut offset = 0usize;
        let lower = html.to_lowercase();
        let needle = format!("<{tag_name}");
        while let Some(start_rel) = lower[offset..].find(&needle) {
            let start = offset + start_rel;
            let Some(tag_end_rel) = lower[start..].find('>') else {
                break;
            };
            let tag_end = start + tag_end_rel + 1;
            let tag = &html[start..tag_end];
            let text = if tag_name == "button" || tag_name == "textarea" || tag_name == "select" {
                let closing = format!("</{tag_name}>");
                lower[tag_end..]
                    .find(&closing)
                    .map(|rel| html_to_text(&html[tag_end..tag_end + rel]))
                    .unwrap_or_default()
            } else {
                String::new()
            };
            controls.push(json!({
                "tag": tag_name,
                "type": attr_value(tag, "type").unwrap_or_else(|| if tag_name == "input" { "text".into() } else { tag_name.into() }),
                "name": attr_value(tag, "name").unwrap_or_default(),
                "id": attr_value(tag, "id").unwrap_or_default(),
                "form": attr_value(tag, "form").unwrap_or_default(),
                "placeholder": attr_value(tag, "placeholder").unwrap_or_default(),
                "ariaLabel": attr_value(tag, "aria-label").unwrap_or_default(),
                "required": has_boolean_attr(tag, "required"),
                "disabled": has_boolean_attr(tag, "disabled"),
                "text": text,
            }));
            if controls.len() >= limit {
                return controls;
            }
            offset = tag_end;
        }
    }
    controls
}

