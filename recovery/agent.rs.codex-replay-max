fn failover_candidates(store: &AppStore, preferred_provider: &LlmProvider) -> AppResult<Vec<LlmProvider>> {
    let mut candidates = store.provider_candidates(Some(&preferred_provider.id))?;
    let preferred_is_echo = preferred_provider.provider_type == "echo" || preferred_provider.base_url.trim().is_empty();
    if !preferred_is_echo && candidates.iter().any(|provider| provider.provider_type != "echo" && !provider.base_url.trim().is_empty()) {
        candidates.retain(|provider| provider.provider_type != "echo" && !provider.base_url.trim().is_empty());
    }
    Ok(candidates)
}

fn classify_llm_failure(provider: &LlmProvider, error: &AppError) -> LlmFailure {
    let message = error.to_string();
    let lower = message.to_lowercase();
    let kind = if lower.contains("timed out") || lower.contains("timeout") {
        "timeout"
    } else if lower.contains("connect") || lower.contains("dns") || lower.contains("network") || lower.contains("connection") {
        "transport"
    } else if lower.contains("429") || lower.contains("rate limit") || lower.contains("too many requests") {
        "rate_limited"
    } else if lower.contains("401") || lower.contains("403") || lower.contains("unauthorized") || lower.contains("forbidden") {
        "auth"
    } else if lower.contains("400") || lower.contains("invalid") || lower.contains("missing") {
        "bad_response"
    } else {
        "provider_error"
    };
    LlmFailure { provider_id: provider.id.clone(), kind, message }
}

fn attach_llm_failover_metadata(
    reply: &mut crate::llm::LlmReply,
    provider: &LlmProvider,
    failures: &[LlmFailure],
) {
    reply.provider_id = Some(provider.id.clone());
    reply.failover_attempts = failures
        .iter()
        .map(|failure| crate::llm::LlmFailoverAttempt {
            provider_id: failure.provider_id.clone(),
            kind: failure.kind.to_string(),
            message: failure.message.clone(),
        })
        .collect();
}

fn record_llm_failover_stage_if_any(
    store: &AppStore,
