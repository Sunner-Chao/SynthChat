fn build_tool_planner_prompt(
    user_request: &str,
    tools: &[ToolDefinition],
    observations: &[String],
    iteration: u32,
    max_iterations: u32,
) -> String {
    let tool_lines = tools
        .iter()
        .take(32)
        .map(|tool| {
            format!(
                "- name: {}; serverId: {}; toolName: {}; description: {}; inputSchema: {}",
                tool.name,
                tool.server_id,
                tool.tool_name,
                tool.description,
                compact_json(&tool.input_schema)
            )
        })
        .collect::<Vec<_>>()
        .join("\n");
    let observation_text = if observations.is_empty() {
        "None yet.".to_string()
    } else {
        observations.join("\n\n")
    };
    let planner_rules = planner_rules_for_tools(tools).join("\n");
    format!(
        "Available tools:\n{}\n\nUser request:\n{}\n\nPrevious observations:\n{}\n\nIteration: {}/{}\n\nPlanner rules:\n{}\n\nReturn one of these shapes:\n{{\"action\":\"tool\",\"useTool\":true,\"tool\":\"serverId.toolName or registry name\",\"intent\":\"short label\",\"arguments\":{{}},\"reason\":\"short reason\"}}\n{{\"action\":\"tool\",\"useTool\":true,\"intent\":\"parallel evidence\",\"toolCalls\":[{{\"tool\":\"serverId.toolName\",\"arguments\":{{}}}},{{\"tool\":\"serverId.otherTool\",\"arguments\":{{}}}}],\"reason\":\"independent calls\"}}\n{{\"action\":\"final\",\"useTool\":false,\"tool\":\"\",\"intent\":\"answer\",\"arguments\":{{}},\"reason\":\"enough information\"}}",
        tool_lines,
        user_request,
        observation_text,
        iteration + 1,
        max_iterations,
        planner_rules,
    )
}

fn build_planner_repair_prompt(
    planner_prompt: &str,
    invalid_output: &str,
    tools: &[ToolDefinition],
) -> String {
    let tool_names = tools
        .iter()
        .map(|tool| format!("{} ({})", tool.name, tool.display_name))
        .collect::<Vec<_>>()
        .join(", ");
    format!(
        "The previous planner response did not contain a valid JSON object. Convert it into exactly one valid SynthChat planner JSON object using the original planner contract.\n\nAvailable tool names:\n{}\n\nOriginal planner contract and context:\n{}\n\nInvalid planner response:\n{}\n\nReturn JSON only. If the invalid response has enough intent to call a tool, choose the closest available tool and arguments. If it is clearly enough to answer without tools, return a final action.",
        tool_names,
        compact_text(planner_prompt, 12000),
        compact_text(invalid_output, 4000)
    )
}

async fn repair_planner_decision(
    store: &AppStore,
    provider: &LlmProvider,
    persona: &Persona,
    planner_prompt: &str,
    invalid_output: &str,
    tools: &[ToolDefinition],
) -> AppResult<Option<(String, Value, (usize, usize))>> {
    let repair_prompt = build_planner_repair_prompt(planner_prompt, invalid_output, tools);
    let reply = complete_text_prompt_with_failover(
        store,
        provider,
        persona,
        "You repair malformed agent planner outputs. Return compact JSON only.".into(),
        repair_prompt,
    )
    .await?;
    let Some(decision) = extract_json_object(&reply.content) else {
        return Ok(None);
    };
    Ok(Some((
        reply.content,
        decision,
        (reply.prompt_tokens, reply.completion_tokens),
    )))
}

fn planner_rules_for_tools(tools: &[ToolDefinition]) -> Vec<String> {
    let has_tool = |name: &str| tools.iter().any(|tool| tool.tool_name == name || tool.name == name);
    let mut rules = vec![
        "- Return JSON only.".to_string(),
        "- Use a tool when it can ground the answer, inspect local state, verify a claim, or complete the requested action.".to_string(),
    ];
    if has_tool("update_todo") {
        rules.push("- Use update_todo for long or complex multi-step tasks to make progress explicit.".into());
    }
    if has_tool("session_search") {
        rules.push("- Use session_search when relevant prior conversation, run, or tool evidence may be outside the visible context.".into());
    }
    if has_tool("delegate_task") {
        rules.push("- Use delegate_task tasks[] only for independent subtasks that benefit from isolated focused reasoning.".into());
    }
    if has_tool("clarify") {
        rules.push("- Use clarify only when required information is missing and no safe tool action or partial answer can move the task forward.".into());
    }
    if has_tool("recall_memory") {
        rules.push("- Use recall_memory when long-term persona facts/preferences may affect the answer and are not already visible in context.".into());
    }
    if has_tool("remember_fact") {
        rules.push("- Use remember_fact only for stable user facts/preferences that should persist across future conversations; do not store transient task notes.".into());
    }
    if has_tool("manage_memory") {
        rules.push("- Use manage_memory replace/remove when the user corrects or invalidates an existing long-term memory; use read before modifying if the target memory id is unknown.".into());
    }
    if has_tool("workspace_diagnostics") {
        rules.push("- Use workspace_diagnostics when the task mentions build failures, compiler errors, type errors, tests, lint, or code changes that should be verified against the local workspace.".into());
    }
    if has_tool("process") {
        rules.push("- Use process for long-running local services such as dev servers, desktop app processes, backend servers, watchers, or commands that need later status/log inspection; use list/status/read before starting duplicates and stop/kill only when requested or clearly necessary.".into());
    }
    if has_tool("execute_code") {
        rules.push("- Use execute_code for bounded local snippets that compute, parse, transform, or reduce data before returning a concise result; do not use it for long-running services, interactive programs, or ordinary shell commands.".into());
    }
    if has_tool("read_file") {
        rules.push("- Use read_file to inspect known local files before explaining, editing, or debugging their contents; use offset/limit for large files.".into());
    }
    if has_tool("search_files") {
        rules.push("- Use search_files to locate relevant local file paths or text before terminal commands when the file path is unknown.".into());
    }
    if has_tool("write_file") {
        rules.push("- Use write_file for deliberate workspace text edits only after reading or otherwise knowing the intended content; it requires approval and is limited to the workspace.".into());
    }
    if has_tool("patch") {
        rules.push("- Use patch for focused local text edits; prefer exact oldText/newText for small changes, replacements[] for multiple exact edits, and unified diff text in patch/diff for multi-hunk or multi-file edits. Prefer patch over write_file when preserving the rest of a file.".into());
    }
    if has_tool("terminal") {
        rules.push("- Use terminal only when a bounded local command is necessary and no narrower read/status/process/diagnostic tool is sufficient; include cwd and timeoutSeconds when relevant.".into());
    }
    if has_tool("web_search") {
        rules.push("- Use web_search for current facts, recent information, news, changing product/library details, or when discovering authoritative URLs would improve the answer.".into());
    }
    if has_tool("web_extract") {
        rules.push("- Use web_extract when the user gives specific HTTP(S) URLs or after web_search when page content, documentation, article text, or source evidence is needed.".into());
    }
    if has_tool("web_request") {
        rules.push("- Use web_request to verify HTTP endpoints discovered from forms, requestClues, fetch, XHR, or API docs; use browser_snapshot/web_extract first when the endpoint shape is unknown, and expect approval for non-read methods.".into());
    }
    if has_tool("image_generate") {
        rules.push("- Use image_generate when the user asks to create, generate, draw, render, or produce an image; include the generated artifact path in the final answer.".into());
    }
    if has_tool("cronjob") {
        rules.push("- Use cronjob only when the user asks to schedule, remind, recur, automate later, pause, resume, delete, list, or manually trigger scheduled work.".into());
    }
    if has_browser_page_tool(tools) {
        rules.push("- If a browser/page interaction is needed, prefer structured snapshot/page-state tools before click/type/fill and use returned refs when available.".into());
    }
    rules.extend([
        "- If several independent read/status/search calls are needed and none depends on another result, return toolCalls so they can run in parallel.".to_string(),
        "- Do not batch browser interactions, approvals, writes, deletes, submissions, shell commands, or dependent steps.".to_string(),
        "- Do not repeat a failed or no-progress tool call unchanged; use guardrail/assessment guidance from observations.".to_string(),
        "- If the observations are enough to answer, choose final.".to_string(),
        "- If blocked by missing credentials, unavailable services, or repeated tool failures, choose final and explain the blocker from evidence.".to_string(),
    ]);
    rules
}

fn has_browser_page_tool(tools: &[ToolDefinition]) -> bool {
    tools.iter().any(|tool| {
        let text = format!(
            "{} {} {} {} {}",
            tool.name.to_lowercase(),
            tool.display_name.to_lowercase(),
            tool.tool_name.to_lowercase(),
            tool.server_id.to_lowercase(),
            tool.description.to_lowercase()
        );
        contains_any(&text, &["browser", "page", "dom", "snapshot", "click", "scroll"])
    })
}

fn resolve_tool(name: &str, tools: &[ToolDefinition]) -> Option<ToolDefinition> {
    tools
        .iter()
        .find(|tool| tool.name == name || format!("{}.{}", tool.server_id, tool.tool_name) == name || tool.tool_name == name)
        .cloned()
}

fn tool_payload_for_definition(store: &AppStore, tool: &ToolDefinition, arguments: Value) -> AppResult<Value> {
    if tool.source != "capability" {
        return Ok(arguments);
    }
    let Some(adapter) = store
        .capability_adapters()?
        .into_iter()
        .find(|adapter| adapter.enabled && adapter.name == tool.name)
    else {
        return Ok(arguments);
    };

    let mut payload = match adapter.parameters {
        Value::Object(map) => map,
        _ => serde_json::Map::new(),
    };
    let arg_obj = arguments.as_object().cloned().unwrap_or_default();
    if adapter.param_mapping.is_empty() {
        for (key, value) in arg_obj {
            payload.insert(key, value);
        }
    } else {
        for (from, to) in adapter.param_mapping {
            if let Some(value) = arg_obj.get(&from) {
                payload.insert(to, value.clone());
            }
        }
    }
    for (key, value) in adapter.inject_fields {
        payload.insert(key, Value::String(value));
    }
    Ok(Value::Object(payload))
}

fn expand_delegate_payloads(payload: &Value) -> Vec<Value> {
    if let Some(tasks) = payload.get("tasks").and_then(Value::as_array) {
        return tasks
            .iter()
            .filter_map(|task| {
                if let Some(text) = task.as_str().map(str::trim).filter(|text| !text.is_empty()) {
                    return Some(json!({"task": text}));
                }
                if task.get("task").or_else(|| task.get("goal")).and_then(Value::as_str).is_some() {
                    let mut item = task.clone();
                    if item.get("task").is_none() {
                        if let Some(goal) = item.get("goal").cloned() {
                            if let Value::Object(map) = &mut item {
                                map.insert("task".into(), goal);
                            }
                        }
                    }
                    return Some(item);
                }
                None
            })
            .collect();
    }
    payload
        .get("task")
        .and_then(Value::as_str)
        .map(str::trim)
        .filter(|task| !task.is_empty())
        .map(|_| vec![payload.clone()])
        .unwrap_or_default()
}

async fn run_delegate_task(
    store: &AppStore,
    provider: &crate::models::LlmProvider,
    persona: &Persona,
    parent_request: &str,
    payload: &Value,
) -> AppResult<crate::llm::LlmReply> {
    let task = payload.get("task").and_then(Value::as_str).unwrap_or("").trim();
    let context = payload.get("context").and_then(Value::as_str).unwrap_or("").trim();
    let expected = payload
        .get("expectedOutput")
        .or_else(|| payload.get("expected_output"))
        .and_then(Value::as_str)
        .unwrap_or("")
        .trim();
    if task.is_empty() {
        return Err(AppError::BadRequest("delegate_task requires arguments.task".into()));
    }
    let user_prompt = format!(
        "Parent request:\n{}\n\nSubtask:\n{}\n\nContext:\n{}\n\nExpected output:\n{}\n\nReturn only the useful result for the parent agent. Be concise, cite uncertainty, and do not ask the user questions.",
        parent_request,
        task,
        if context.is_empty() { "(none)" } else { context },
        if expected.is_empty() { "Concise findings and next-step-ready answer." } else { expected },
    );
    complete_text_prompt_with_failover(
        store,
        provider,
        persona,
        "You are a focused SynthChat subagent. Solve only the delegated subtask. Do not use tools. Do not roleplay beyond the task.".into(),
        user_prompt,
    )
    .await
}

fn extract_json_object(text: &str) -> Option<Value> {
    if let Ok(value) = serde_json::from_str::<Value>(text.trim()) {
        if value.is_object() {
            return Some(value);
        }
    }
    for (start, ch) in text.char_indices() {
        if ch != '{' {
            continue;
        }
        let mut depth = 0i32;
        let mut in_string = false;
        let mut escaped = false;
        for (offset, current) in text[start..].char_indices() {
            if in_string {
                if escaped {
                    escaped = false;
                } else if current == '\\' {
                    escaped = true;
                } else if current == '"' {
                    in_string = false;
                }
                continue;
            }
            match current {
                '"' => in_string = true,
                '{' => depth += 1,
                '}' => {
                    depth -= 1;
                    if depth == 0 {
                        let end = start + offset + current.len_utf8();
                        if let Ok(value) = serde_json::from_str::<Value>(&text[start..end]) {
                            if value.is_object() {
                                return Some(value);
                            }
                        }
                        break;
                    }
                }
                _ => {}
            }
        }
    }
    None
}

fn compact_json(value: &Value) -> String {
    let text = value.to_string();
    if text.len() > 500 {
        format!("{}...", &text[..500])
    } else {
        text
    }
}

fn truncate_for_prompt(text: &str, max_chars: usize) -> String {
    if text.chars().count() <= max_chars {
        return text.to_string();
    }
    let mut out = text.chars().take(max_chars).collect::<String>();
    out.push_str("\n[truncated]");
    out
}

fn parse_tool_command(input: &str) -> Option<(String, String, serde_json::Value)> {
    let rest = input.trim().strip_prefix("/tool ")?;
    let (target, payload_text) = rest.split_once(' ').unwrap_or((rest, "{}"));
    let (server_id, tool_name) = target.split_once('.')?;
    if server_id.trim().is_empty() || tool_name.trim().is_empty() {
        return None;
    }
    let payload = serde_json::from_str(payload_text.trim()).unwrap_or_else(|_| json!({"text": payload_text.trim()}));
    Some((server_id.trim().to_string(), tool_name.trim().to_string(), payload))
}

fn parse_remember_command(input: &str) -> Option<&str> {
    let trimmed = input.trim();
    let summary = trimmed
        .strip_prefix("/remember ")
        .or_else(|| trimmed.strip_prefix("/记住 "))
        .or_else(|| trimmed.strip_prefix("记住："))
        .or_else(|| trimmed.strip_prefix("记住:"))?
        .trim();
    if summary.is_empty() { None } else { Some(summary) }
}

