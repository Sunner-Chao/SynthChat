fn handle_agent_queue_clear_control_command(
    store: &AppStore,
    conversation: &Conversation,
) -> AppResult<String> {
    let before = store
        .agent_queue()?
        .into_iter()
        .filter(|item| item.conversation_id == conversation.id)
        .count();
    let remaining = store.clear_finished_agent_queue_items_for_conversation(&conversation.id)?;
    let after = remaining.len();
    Ok(format!(
        "已清理终态 agent 队列项。当前会话队列：{} -> {}。",
        before, after
    ))
}

fn handle_agent_queue_control_command(
    store: &AppStore,
    conversation: &Conversation,
    persona: &Persona,
    argument_raw: &str,
) -> AppResult<String> {
    let prompt = argument_raw.trim();
    let prompt = if matches!(prompt.to_lowercase().as_str(), "list" | "ls" | "status") {
        ""
    } else {
        prompt
    };
    if !prompt.is_empty() {
        let synthetic_message = ChatMessage::new(conversation.id.clone(), "user", prompt.to_string(), "desktop-queue");
        let queued = store.enqueue_agent_request(conversation.id.clone(), persona.id.clone(), &synthetic_message)?;
        return Ok(format!(
            "已加入当前会话 agent 队列：{}。\n队列内容：{}",
            queued.id,
            truncate_for_prompt(&queued.content, 180)
        ));
    }

    let queue = store
        .agent_queue()?
        .into_iter()
        .filter(|item| item.conversation_id == conversation.id && matches!(item.status.as_str(), "pending" | "running" | "failed"))
        .take(8)
        .collect::<Vec<_>>();
    if queue.is_empty() {
        Ok("当前会话没有待处理的 agent 队列。".into())
    } else {
        let rows = queue
            .iter()
            .map(|item| format!("- {} [{}] {}", item.id, item.status, truncate_for_prompt(&item.content, 120)))
            .collect::<Vec<_>>()
            .join("\n");
        Ok(format!("当前会话 agent 队列：\n{rows}"))
    }
}

fn handle_agents_control_command(store: &AppStore) -> AppResult<String> {
    let conversation_titles = store
        .conversations()?
        .into_iter()
        .map(|conversation| (conversation.id, conversation.title))
        .collect::<HashMap<_, _>>();
    let active_runs = store
        .agent_runs()?
        .into_iter()
        .filter(|run| matches!(run.state.as_str(), "started" | "running" | "pendingApproval"))
        .take(12)
        .collect::<Vec<_>>();
    let queue = store.agent_queue()?;
    let pending_queue = queue.iter().filter(|item| item.status == "pending").count();
    let running_queue = queue.iter().filter(|item| item.status == "running").count();

    let mut lines = vec![format!("Agent 概况：activeRuns={} queuePending={} queueRunning={}", active_runs.len(), pending_queue, running_queue)];
    if active_runs.is_empty() {
        lines.push("当前没有活跃 agent run。".into());
    } else {
        lines.push("活跃 runs：".into());
        lines.extend(active_runs.iter().map(|run| {
            let title = conversation_titles
                .get(&run.conversation_id)
                .cloned()
                .unwrap_or_else(|| run.conversation_id.clone());
            format!(
                "- {} [{}] conversation={} request={}",
                run.run_id,
                run.state,
                title,
                truncate_for_prompt(&run.user_request, 120)
            )
        }));
    }
    Ok(lines.join("\n"))
}

fn handle_subagents_control_command(
    store: &AppStore,
    argument_raw: &str,
    app: Option<&AppHandle>,
) -> AppResult<String> {
    let mut parts = argument_raw.split_whitespace();
    let mode = parts.next().unwrap_or("active").to_lowercase();
    if matches!(mode.as_str(), "abort" | "stop" | "cancel" | "interrupt") {
        let prefix = parts.next().unwrap_or("").trim();
        if prefix.is_empty() {
            return Ok("用法：/subagents abort <runId前缀>".into());
        }
        let Some(run) = select_subagent_run_by_prefix(store, prefix)? else {
            return Ok(format!("未找到匹配的子智能体 run：{prefix}"));
        };
        let saved = abort_agent_run(
            store,
            run.run_id.clone(),
            Some("Subagent interrupted by control command.".into()),
            app,
        )?;
        return Ok(format!(
            "已中止子智能体 run：{}。状态：{}。parent={}",
            saved.run_id,
            saved.state,
            saved.parent_run_id.as_deref().unwrap_or("-")
        ));
    }
    let limit = parts
        .next()
        .and_then(|value| value.parse::<usize>().ok())
        .unwrap_or(12)
        .clamp(1, 50);
    let runs = store.agent_runs()?;
    let child_runs = runs
        .iter()
        .filter(|run| run.parent_run_id.is_some())
        .cloned()
        .collect::<Vec<_>>();
    let active_count = child_runs
        .iter()
        .filter(|run| is_active_run_state(&run.state))
        .count();
    let completed_count = child_runs
        .iter()
        .filter(|run| run.state == "completed")
        .count();
    let failed_count = child_runs
        .iter()
        .filter(|run| run.state == "failed")
        .count();
    let selected = match mode.as_str() {
        "all" => child_runs.iter().take(limit).collect::<Vec<_>>(),
        "recent" => child_runs.iter().take(limit).collect::<Vec<_>>(),
        "active" | "" => child_runs
            .iter()
            .filter(|run| is_active_run_state(&run.state))
            .take(limit)
            .collect::<Vec<_>>(),
        _ => {
            return Ok("用法：/subagents [active|recent|all] [limit]".into());
        }
    };
    let selected = if selected.is_empty() && matches!(mode.as_str(), "active" | "") {
        child_runs.iter().take(limit).collect::<Vec<_>>()
    } else {
        selected
    };
    let mut lines = vec![format!(
        "Subagent 概况：total={} active={} completed={} failed={} mode={} limit={}",
        child_runs.len(),
        active_count,
        completed_count,
        failed_count,
        mode,
        limit
    )];
    if selected.is_empty() {
        lines.push("暂无子智能体运行。".into());
    } else {
        lines.push("子智能体 runs：".into());
        lines.extend(selected.into_iter().map(|run| {
            let toolsets = if run.subagent_toolsets.is_empty() {
                "default".into()
            } else {
                run.subagent_toolsets.join(",")
            };
            format!(
                "- {} [{}] parent={} role={} index={} toolsets={} task={}",
                run.run_id,
                run.state,
                run.parent_run_id.as_deref().unwrap_or("-"),
                run.subagent_role.as_deref().unwrap_or("leaf"),
                run.subagent_index
                    .map(|value| value.to_string())
                    .unwrap_or_else(|| "-".into()),
                toolsets,
                truncate_for_prompt(
                    run.subagent_task
                        .as_deref()
                        .or_else(|| (!run.user_request.trim().is_empty()).then_some(run.user_request.as_str()))
                        .unwrap_or("子任务执行"),
                    140
                )
            )
        }));
    }
    Ok(lines.join("\n"))
}

fn select_subagent_run_by_prefix(
    store: &AppStore,
    prefix: &str,
) -> AppResult<Option<AgentRunRecord>> {
    let prefix = prefix.trim();
    if prefix.is_empty() {
        return Ok(None);
    }
    Ok(store
        .agent_runs()?
        .into_iter()
        .find(|run| run.parent_run_id.is_some() && run.run_id.starts_with(prefix)))
}

fn is_active_run_state(state: &str) -> bool {
    matches!(state, "started" | "running" | "pendingApproval")
}

fn handle_scheduled_jobs_control_command(
    store: &AppStore,
    conversation: &Conversation,
    persona: &Persona,
    command: &str,
    argument_raw: &str,
    app: Option<&AppHandle>,
) -> AppResult<String> {
    let mut parts = argument_raw.split_whitespace();
    let action = if command == "jobs" {
        parts.next().unwrap_or("list")
    } else {
        parts.next().unwrap_or("list")
    };
    let action = action.to_lowercase();
    match action.as_str() {
        "" | "list" => {
            let jobs = store
                .scheduled_agent_jobs()?
                .into_iter()
                .filter(|job| job.conversation_id.as_deref() == Some(conversation.id.as_str()))
                .take(12)
                .collect::<Vec<_>>();
            if jobs.is_empty() {
                return Ok("当前会话没有计划任务。".into());
            }
            let rows = jobs
                .iter()
                .map(|job| {
                    format!(
                        "- {} [{}] enabled={} next={} last={} prompt={}",
                        job.id,
                        job.status,
                        job.enabled,
                        job.next_run_at.as_deref().unwrap_or("-"),
                        job.last_run_status.as_deref().unwrap_or("-"),
                        truncate_for_prompt(&job.prompt, 100),
                    )
                })
                .collect::<Vec<_>>()
                .join("\n");
            Ok(format!("当前会话计划任务：\n{rows}"))
        }
        "tick" => {
            let Some(app_handle) = app.cloned() else {
                return Ok("当前运行环境不支持触发计划任务。".into());
            };
            let due = store.claim_due_scheduled_agent_jobs()?;
            let mut triggered = 0usize;
            for job in due.into_iter().filter(|job| job.conversation_id.as_deref() == Some(conversation.id.as_str())) {
                spawn_background_chat_turn_for_job(
                    app_handle.clone(),
                    job.conversation_id.clone().unwrap_or_else(|| conversation.id.clone()),
                    job.persona_id.clone(),
                    job.prompt.clone(),
                    Some(job),
                );
                triggered += 1;
            }
            Ok(format!("已触发当前会话到期计划任务：{} 个。", triggered))
        }
        "create" => {
            let create_body = argument_raw
                .trim()
                .get(action.len()..)
                .unwrap_or("")
                .trim();
            let Some((schedule_part, prompt_part)) = create_body.split_once('|')
            else {
                return Ok(cron_create_usage_text());
            };
            let prompt = prompt_part.trim();
            if prompt.is_empty() {
                return Ok("计划任务 prompt 不能为空。".into());
            }
            let parsed_schedule = match parse_schedule_input(schedule_part.trim(), Utc::now()) {
                Ok(schedule) => schedule,
                Err(error) => return Ok(error.to_string()),
            };
            let mut job = ScheduledAgentJob {
                id: String::new(),
                name: prompt.chars().take(48).collect(),
                conversation_id: Some(conversation.id.clone()),
                persona_id: persona.id.clone(),
                prompt: prompt.into(),
                schedule_kind: String::new(),
                interval_minutes: None,
                cron_expr: None,
                run_at: None,
                enabled_toolsets: vec![],
                disabled_toolsets: vec![],
                enabled: true,
                status: "scheduled".into(),
                next_run_at: None,
                last_run_at: None,
                last_completed_at: None,
                last_run_status: None,
                last_output: None,
                last_output_path: None,
                last_error: None,
                run_count: 0,
                created_at: String::new(),
                updated_at: String::new(),
            };
            apply_parsed_schedule_to_job(&mut job, parsed_schedule);
            let saved = store.save_scheduled_agent_job(job)?;
            Ok(format!(
                "已创建计划任务：{}，下一次执行：{}",
                saved.id,
                saved.next_run_at.as_deref().unwrap_or("-")
            ))
        }
        "pause" | "resume" => {
            let selector = parts.next().unwrap_or("").trim();
            let Some(job) = select_scheduled_job_for_conversation(store, &conversation.id, selector)? else {
                return Ok("未找到匹配的计划任务。".into());
            };
            let saved = store.set_scheduled_agent_job_enabled(&job.id, action == "resume")?;
            Ok(format!("计划任务 {} 已{}。", saved.id, if saved.enabled { "启用" } else { "暂停" }))
        }
        "delete" | "remove" => {
            let selector = parts.next().unwrap_or("").trim();
            let Some(job) = select_scheduled_job_for_conversation(store, &conversation.id, selector)? else {
                return Ok("未找到匹配的计划任务。".into());
            };
            store.delete_scheduled_agent_job(&job.id)?;
            Ok(format!("已删除计划任务：{}", job.id))
        }
        "trigger" | "run" => {
            let selector = parts.next().unwrap_or("").trim();
            let Some(job) = select_scheduled_job_for_conversation(store, &conversation.id, selector)? else {
                return Ok("未找到匹配的计划任务。".into());
            };
            let Some(app_handle) = app.cloned() else {
                return Ok("当前运行环境不支持触发计划任务。".into());
            };
            spawn_background_chat_turn_for_job(
                app_handle,
                job.conversation_id.clone().unwrap_or_else(|| conversation.id.clone()),
                job.persona_id.clone(),
                job.prompt.clone(),
                Some(job.clone()),
            );
            Ok(format!("已手动触发计划任务：{}。", job.id))
        }
        "help" => Ok(format!("用法：/jobs [list|tick|trigger|pause|resume|delete] [jobId前缀]\n{}", cron_create_usage_text())),
        _ => Ok("未知计划任务命令。用法：/jobs [list|tick|trigger|pause|resume|delete] [jobId前缀]，或 /cron create ...".into()),
    }
}

#[derive(Debug, Clone, PartialEq, Eq)]
struct ParsedScheduleInput {
    schedule_kind: String,
    run_at: Option<String>,
    interval_minutes: Option<u64>,
    cron_expr: Option<String>,
}

fn cron_create_usage_text() -> String {
    [
        "创建：/cron create <schedule> | <prompt>",
        "schedule 支持：30m、2h、1d（一次性延迟）；every 30m、every 2h（循环间隔）；0 9 * * *（cron）；once <RFC3339>、interval <minutes>、cron <expr>（兼容旧格式）。",
    ]
    .join("\n")
}

fn parse_schedule_input(schedule: &str, now: DateTime<Utc>) -> AppResult<ParsedScheduleInput> {
    let schedule = schedule.trim();
    if schedule.is_empty() {
        return Err(AppError::BadRequest(cron_create_usage_text()));
    }
    let lower = schedule.to_lowercase();
    if let Some(rest) = lower.strip_prefix("every ") {
        let minutes = parse_duration_minutes(rest.trim())?;
        return Ok(ParsedScheduleInput {
            schedule_kind: "interval".into(),
            run_at: None,
            interval_minutes: Some(minutes),
            cron_expr: None,
        });
    }
    let mut parts = schedule.split_whitespace();
    let first = parts.next().unwrap_or("").to_lowercase();
    match first.as_str() {
        "once" => {
            let rest = parts.collect::<Vec<_>>().join(" ");
            let run_at = parse_once_schedule_run_at(&rest, now)?;
            return Ok(ParsedScheduleInput {
                schedule_kind: "once".into(),
                run_at: Some(run_at),
                interval_minutes: None,
                cron_expr: None,
            });
        }
        "interval" => {
            let rest = parts.collect::<Vec<_>>().join(" ");
            let minutes = rest.trim().parse::<u64>().ok().filter(|value| *value > 0)
                .or_else(|| parse_duration_minutes(rest.trim()).ok())
                .ok_or_else(|| AppError::BadRequest("用法：/cron create interval <minutes|duration> | <prompt>".into()))?;
            return Ok(ParsedScheduleInput {
                schedule_kind: "interval".into(),
                run_at: None,
                interval_minutes: Some(minutes),
                cron_expr: None,
            });
        }
        "cron" => {
            let expr = parts.collect::<Vec<_>>().join(" ");
            if expr.split_whitespace().count() != 5 {
                return Err(AppError::BadRequest("用法：/cron create cron <minute hour day month weekday> | <prompt>".into()));
            }
            return Ok(ParsedScheduleInput {
                schedule_kind: "cron".into(),
                run_at: None,
                interval_minutes: None,
                cron_expr: Some(expr),
            });
        }
        _ => {}
    }
    if schedule.split_whitespace().count() == 5 && looks_like_cron_expr(schedule) {
        return Ok(ParsedScheduleInput {
            schedule_kind: "cron".into(),
            run_at: None,
            interval_minutes: None,
            cron_expr: Some(schedule.into()),
        });
    }
    if let Ok(minutes) = parse_duration_minutes(schedule) {
        return Ok(ParsedScheduleInput {
            schedule_kind: "once".into(),
            run_at: Some((now + ChronoDuration::minutes(minutes as i64)).to_rfc3339()),
            interval_minutes: None,
            cron_expr: None,
        });
    }
    let run_at = parse_once_schedule_run_at(schedule, now)?;
    Ok(ParsedScheduleInput {
        schedule_kind: "once".into(),
        run_at: Some(run_at),
        interval_minutes: None,
        cron_expr: None,
    })
}

fn parse_duration_minutes(value: &str) -> AppResult<u64> {
    let text = value.trim().to_lowercase();
    if text.is_empty() {
        return Err(AppError::BadRequest("duration cannot be empty".into()));
    }
    let digits = text.chars().take_while(|ch| ch.is_ascii_digit()).collect::<String>();
    let unit = text[digits.len()..].trim();
    let amount = digits.parse::<u64>().ok().filter(|value| *value > 0)
        .ok_or_else(|| AppError::BadRequest(format!("Invalid duration: {value}")))?;
    let multiplier = match unit {
        "m" | "min" | "mins" | "minute" | "minutes" => 1,
        "h" | "hr" | "hrs" | "hour" | "hours" => 60,
        "d" | "day" | "days" => 1440,
        _ => return Err(AppError::BadRequest(format!("Invalid duration: {value}"))),
    };
    Ok(amount.saturating_mul(multiplier))
}

fn parse_once_schedule_run_at(value: &str, now: DateTime<Utc>) -> AppResult<String> {
    let text = value.trim();
    if text.is_empty() {
        return Err(AppError::BadRequest("用法：/cron create once <RFC3339|duration> | <prompt>".into()));
    }
    if let Ok(minutes) = parse_duration_minutes(text) {
        return Ok((now + ChronoDuration::minutes(minutes as i64)).to_rfc3339());
    }
    DateTime::parse_from_rfc3339(text)
        .map(|time| time.with_timezone(&Utc).to_rfc3339())
        .map_err(|_| AppError::BadRequest(format!("Invalid schedule '{text}'. {}", cron_create_usage_text())))
}

fn looks_like_cron_expr(value: &str) -> bool {
    value
        .split_whitespace()
        .all(|part| !part.is_empty() && part.chars().all(|ch| ch.is_ascii_digit() || matches!(ch, '*' | '-' | ',' | '/')))
}

fn apply_parsed_schedule_to_job(job: &mut ScheduledAgentJob, schedule: ParsedScheduleInput) {
    job.schedule_kind = schedule.schedule_kind;
    job.run_at = schedule.run_at;
    job.interval_minutes = schedule.interval_minutes;
    job.cron_expr = schedule.cron_expr;
}

fn select_scheduled_job_for_conversation(
    store: &AppStore,
    conversation_id: &str,
    selector: &str,
) -> AppResult<Option<ScheduledAgentJob>> {
    let selector = selector.trim();
    let mut jobs = store
        .scheduled_agent_jobs()?
        .into_iter()
        .filter(|job| job.conversation_id.as_deref() == Some(conversation_id))
        .collect::<Vec<_>>();
    jobs.sort_by(|left, right| right.updated_at.cmp(&left.updated_at));
    if selector.is_empty() {
        return Ok(jobs.into_iter().next());
    }
    Ok(jobs.into_iter().find(|job| job.id.starts_with(selector) || job.name.contains(selector)))
}

fn select_pending_approval(
    store: &AppStore,
    conversation_id: &str,
    selector: &str,
) -> AppResult<Option<ToolApprovalRequest>> {
    let selector = selector.trim();
    let approvals = store.tool_approvals()?;
    Ok(approvals.into_iter().find(|approval| {
        approval.conversation_id.as_deref() == Some(conversation_id)
            && approval.status == "pending"
            && (selector.is_empty() || approval.id == selector || approval.id.starts_with(selector))
    }))
}

fn select_agent_run_for_conversation(
    store: &AppStore,
    conversation_id: &str,
    selector: &str,
) -> AppResult<Option<AgentRunRecord>> {
    let selector = selector.trim();
    Ok(store.agent_runs()?.into_iter().find(|run| {
        run.conversation_id == conversation_id
            && (selector.is_empty() || run.run_id == selector || run.run_id.starts_with(selector))
    }))
}

pub async fn drain_all_agent_queues(store: &AppStore, app: Option<&AppHandle>) -> AppResult<Vec<AgentQueuedRequest>> {
    let mut conversation_ids = Vec::new();
    let mut seen = HashSet::new();
    for item in store.agent_queue()? {
        if item.status == "pending" && seen.insert(item.conversation_id.clone()) {
            conversation_ids.push(item.conversation_id);
        }
    }
    for conversation_id in conversation_ids {
        drain_agent_queue(store, &conversation_id, app).await?;
    }
    store.agent_queue()
}

pub async fn approve_tool_call_and_resume(
    store: &AppStore,
    approval_id: String,
    timeout_seconds: Option<u64>,
    app: Option<&AppHandle>,
) -> AppResult<ToolApprovalRequest> {
    let approval = store.tool_approval(&approval_id)?;
    if approval.status != "pending" {
        return Ok(approval);
    }

    store.update_tool_approval(&approval_id, "approved", None, None)?;
    let retry_config = store.config()?.chat;
    let tool = store
        .tool_definitions()?
        .into_iter()
        .find(|tool| tool.server_id == approval.server_id && tool.tool_name == approval.tool_name)
        .unwrap_or_else(|| ToolDefinition {
            name: format!("{}.{}", approval.server_id, approval.tool_name),
            display_name: approval.tool_name.clone(),
            description: String::new(),
            source: "mcp".into(),
            server_id: approval.server_id.clone(),
            tool_name: approval.tool_name.clone(),
            input_schema: json!({"type": "object"}),
            requires_approval: false,
        });
    if let Some(hardline_reason) = tool_hardline_block_reason(&tool, &approval.payload) {
        let error_text = format!(
            "approved tool call blocked by hardline safety policy: {}.{}; {}",
            approval.server_id, approval.tool_name, hardline_reason
        );
        let blocked_approval =
            store.update_tool_approval(&approval_id, "denied", None, Some(error_text.clone()))?;
        if let Some(run_id) = approval.run_id.as_deref() {
            if let Ok(mut run) = store.agent_run(run_id) {
                let iteration = run.checkpoints.len() as u32 + 1;
                push_run_checkpoint(
                    &mut run,
                    iteration,
                    "tool_hardline_blocked",
                    error_text.clone(),
                    vec![approval.id.clone()],
                    Vec::new(),
                );
                run.state = "failed".into();
                run.error = Some(error_text);
                run.updated_at = now_iso();
                run.completed_at = Some(run.updated_at.clone());
                let saved_run = store.save_agent_run(run.clone())?;
                emit_agent_run_event(
                    app,
                    &saved_run,
                    "failed",
                    None,
                    None,
                    saved_run.error.as_deref(),
                );
                drain_agent_queue(store, &saved_run.conversation_id, app).await?;
            }
        }
        return Ok(blocked_approval);
    }
    let mut pre_tool_snapshot = None;
    if let Some(run_id) = approval.run_id.as_deref() {
        if let Ok(mut run) = store.agent_run(run_id) {
            let checkpoint_iteration = run.checkpoints.len() as u32;
            pre_tool_snapshot = maybe_checkpoint_before_tool_mutation(
                store,
                &mut run,
                checkpoint_iteration,
                &tool,
                &approval.payload,
            )?;
            if pre_tool_snapshot.is_some() {
                let saved_run = store.save_agent_run(run.clone())?;
                emit_agent_run_event(app, &saved_run, "running", None, None, None);
            }
        }
    }
    let call_result = match if approval.server_id == "__internal" && approval.tool_name == "terminal"
    {
        execute_internal_terminal(&approval.payload, timeout_seconds).await
    } else {
        call_mcp_tool_with_retry(
            store,
            approval.server_id.clone(),
            approval.tool_name.clone(),
            approval.payload.clone(),
            timeout_seconds,
            retry_config.tool_call_retry_count,
            retry_config.tool_call_retry_backoff_ms,
        )
        .await
    } {
        Ok(result) => result,
        Err(error) => {
            let error_text = error.to_string();
            let failed_approval = store.update_tool_approval(&approval_id, "failed", None, Some(error_text.clone()))?;
            if let Some(run_id) = approval.run_id.as_deref() {
                if let Ok(mut run) = store.agent_run(run_id) {
                    run.state = "failed".into();
                    run.error = Some(format!("approved tool call failed before completion: {error_text}"));
                    run.updated_at = now_iso();
                    run.completed_at = Some(run.updated_at.clone());
                    let saved_run = store.save_agent_run(run.clone())?;
                    emit_agent_run_event(app, &saved_run, "failed", None, None, saved_run.error.as_deref());
                    drain_agent_queue(store, &saved_run.conversation_id, app).await?;
                }
            }
            return Ok(failed_approval);
        }
    };

    let saved_approval = store.update_tool_approval(
        &approval_id,
        if call_result.ok { "completed" } else { "failed" },
        Some(serde_json::to_value(&call_result).unwrap_or_else(|_| json!({}))),
        call_result.error.clone(),
    )?;

    let Some(run_id) = approval.run_id.as_deref() else {
        return Ok(saved_approval);
    };
    let mut run = store.agent_run(run_id)?;
    emit_agent_run_event(app, &run, "running", None, None, None);
    let conversation = store.conversation(&run.conversation_id)?;
    let persona = store.persona(Some(&run.persona_id))?;
    let agent = store.agent(Some(&run.agent_id))?;

    let mut event = store
        .tool_traces()?
        .iter()
        .rev()
        .find(|trace| trace.server_id == approval.server_id && trace.tool_name == approval.tool_name)
        .map(|trace| trace.event.clone())
        .unwrap_or_else(|| ToolEvent {
            status: Some("completed".into()),
            reference_id: Some(approval.id.clone()),
            call_id: Some(new_id("call")),
            run_id: Some(run.run_id.clone()),
            checkpoint_id: None,
            event_type: "mcp_tool".into(),
            server_id: approval.server_id.clone(),
            tool_name: approval.tool_name.clone(),
            ok: call_result.ok,
            timed_out: call_result.timed_out,
            elapsed_ms: call_result.elapsed_ms,
            title: format!("{} · {}", approval.server_id, approval.tool_name),
            summary: if call_result.ok { "审批后工具调用完成".into() } else { "审批后工具调用失败".into() },
            path: None,
            exists: None,
            mime_type: None,
            text: if call_result.stdout.is_empty() { None } else { Some(call_result.stdout.clone()) },
            error: call_result.error.clone(),
            raw: None,
        });
    event.reference_id = Some(approval.id.clone());
    event.run_id = Some(run.run_id.clone());
    let assessment = assess_tool_result(&tool, &call_result);
    attach_pre_tool_checkpoint(&mut event, pre_tool_snapshot);
    attach_tool_assessment(&mut event, &assessment);
    persist_large_tool_result(store, &run, &mut event, &assessment, &call_result)?;
    let next_iteration = run.checkpoints.len() as u32 + 1;
    let checkpoint_id = push_run_checkpoint(
        &mut run,
        next_iteration,
        if assessment.failed { "approved_tool_failed" } else { "approved_tool_completed" },
        format!(
            "Approved call {}.{} completed; kind={}; ok={}. {}",
            tool.server_id, tool.tool_name, assessment.kind, event.ok, assessment.summary
        ),
        tool_event_call_ids(&event),
        tool_event_refs(&event),
    );
    event.checkpoint_id = Some(checkpoint_id);
    store.replace_latest_tool_trace_event(&tool.server_id, &tool.tool_name, event.clone())?;
    run.tool_events.push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));

    let tool_message = ChatMessage::new(
        conversation.id.clone(),
        "tool",
        json!({"type": "toolEvent", "event": event.clone()}).to_string(),
        "desktop",
    );
    store.append_message(tool_message.clone())?;
    emit_agent_run_event(app, &run, "running", None, Some(&event), None);

    let resumed_turn = continue_approval_with_planner(
        store,
        &conversation,
        &persona,
        &agent,
        &mut run,
        &tool,
        &event,
        &call_result,
        tool_message,
        app,
    )
    .await;

    match resumed_turn {
        Ok(Some(AgentTurn::WithTools { prompt_tokens, completion_tokens, .. })) => {
            store.add_usage(prompt_tokens, completion_tokens)?;
            run.state = if assessment.failed { "failed".into() } else { "completed".into() };
            run.error = if assessment.failed { call_result.error.clone() } else { None };
        }
        Ok(Some(AgentTurn::Plain(reply))) => {
            store.add_usage(reply.prompt_tokens, reply.completion_tokens)?;
            let assistant = ChatMessage::new(conversation.id.clone(), "assistant", reply.content, "desktop-stream");
            store.append_message(assistant)?;
            run.state = if assessment.failed { "failed".into() } else { "completed".into() };
            run.error = if assessment.failed { call_result.error.clone() } else { None };
        }
        Ok(None) | Err(_) => {
            match build_approval_resume_reply(store, &conversation, &persona, &agent, &tool, &event, &call_result).await {
                Ok(reply) => {
                    store.add_usage(reply.prompt_tokens, reply.completion_tokens)?;
                    let assistant = ChatMessage::new(conversation.id.clone(), "assistant", reply.content, "desktop-stream");
                    store.append_message(assistant.clone())?;
                    run.state = if assessment.failed { "failed".into() } else { "completed".into() };
                    run.error = if assessment.failed { call_result.error.clone() } else { None };
                }
                Err(error) => {
                    let assistant = ChatMessage::new(
                        conversation.id.clone(),
                        "assistant",
                        format!("审批后的工具调用已完成，但恢复生成最终回复失败：{error}"),
                        "desktop",
                    );
                    store.append_message(assistant.clone())?;
                    emit_agent_run_event(app, &run, "failed", Some(&assistant), None, Some(&error.to_string()));
                    run.state = "failed".into();
                    run.error = Some(error.to_string());
                }
            }
        }
    }
    run.updated_at = now_iso();
    run.completed_at = Some(run.updated_at.clone());
    store.save_agent_run(run.clone())?;
    emit_agent_run_event(app, &run, &run.state, None, None, run.error.as_deref());
    drain_agent_queue(store, &conversation.id, app).await?;

    Ok(saved_approval)
}

