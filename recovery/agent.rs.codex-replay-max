async fn maybe_run_auto_tool_with_context(
    store: &AppStore,
    conversation: &Conversation,
    persona: &Persona,
    agent: &AgentDefinition,
    run: &mut AgentRunRecord,
    provider: &crate::models::LlmProvider,
    system_prompt: &str,
    user_request: &str,
    history: &[ChatMessage],
    initial_observations: Vec<String>,
    initial_tool_messages: Vec<ChatMessage>,
    tool_context: ToolExecutionContext,
    persist_tool_messages: bool,
    app: Option<&AppHandle>,
) -> AppResult<Option<AgentTurn>> {
    if !agent.mcp_enabled || provider.provider_type == "echo" {
        return Ok(None);
    }

    let available_tools = available_tools_for_agent(store, agent, tool_context)?;
    if available_tools.is_empty() {
        return Ok(None);
    }

    let max_iterations = agent.max_tool_iterations.max(1).min(24);
    let mut budget = AgentIterationBudget::new(max_iterations);
    let mut observations = initial_observations;
    let mut tool_messages = initial_tool_messages;
    let mut prompt_tokens = 0usize;
    let mut completion_tokens = 0usize;
    let chat_config = store.config()?.chat;
    let mut guardrails = ToolLoopGuardrails::new(
        chat_config.tool_guardrail_exact_failure_limit,
        chat_config.tool_guardrail_same_tool_failure_limit,
        chat_config.tool_guardrail_no_progress_limit,
    );
    let mut delegated_count = 0u32;

    loop {
        if agent_run_aborted(store, run)? {
            return Ok(Some(aborted_agent_turn(
                store,
                conversation,
                run,
                tool_messages,
                prompt_tokens,
                completion_tokens,
                app,
            )?));
        }
        let Some(iteration) = budget.consume() else {
            let summary = format!(
                "Tool iteration budget exhausted after {} planner step(s).",
                max_iterations
            );
            record_agent_halt(
                store,
                run,
                conversation,
                persona,
                agent,
                HaltRecord {
                    iteration: max_iterations,
                    input: user_request,
                    output: String::new(),
                    parsed_step: "budget_exhausted",
                    error: Some(summary.clone()),
                    checkpoint_state: "budget_exhausted",
                    checkpoint_summary: summary.clone(),
                },
            )?;
            observations.push(summary);
            break;
        };
        let planner_prompt = build_tool_planner_prompt(user_request, &available_tools, &observations, iteration, max_iterations);
        record_agent_stage(
            store,
            app,
            run,
            "planner_started",
            json!({"iteration": iteration + 1, "maxIterations": max_iterations, "observationCount": observations.len()}),
        )?;
        let route_output = complete_text_prompt_with_failover(
            store,
            provider,
            persona,
            "You are SynthChat's agent planner and tool router. Return compact JSON only. Do not explain.".into(),
            planner_prompt.clone(),
        )
        .await;

        let (mut output, mut decision, error, planner_usage) = match route_output {
            Ok(reply) => {
                record_llm_failover_stage_if_any(
                    store,
                    app,
                    run,
                    "planner",
                    Some(iteration + 1),
                    &reply,
                )?;
                let decision = extract_json_object(&reply.content);
                let usage = (reply.prompt_tokens, reply.completion_tokens);
                (reply.content, decision, None, usage)
            }
            Err(err) => (String::new(), None, Some(err.to_string()), (0, 0)),
        };
        prompt_tokens += planner_usage.0;
        completion_tokens += planner_usage.1;

        if tool_use_enforcement_enabled(&chat_config.tool_use_enforcement)
            && decision.is_none()
            && error.is_none()
            && !output.trim().is_empty()
        {
            record_agent_stage(
                store,
                app,
                run,
                "planner_repair_started",
                json!({"iteration": iteration + 1, "outputPreview": truncate_for_prompt(&output, 1200)}),
            )?;
            match repair_planner_decision(
                store,
                provider,
                persona,
                &planner_prompt,
                &output,
                &available_tools,
            )
            .await
            {
                Ok(Some((repair_output, repaired_decision, repair_usage))) => {
                    prompt_tokens += repair_usage.0;
                    completion_tokens += repair_usage.1;
                    record_agent_stage(
                        store,
                        app,
                        run,
                        "planner_repaired",
                        json!({
                            "iteration": iteration + 1,
                            "repairOutputPreview": truncate_for_prompt(&repair_output, 1200),
                            "decision": repaired_decision.clone(),
                        }),
                    )?;
                    output = format!(
                        "Original planner output:\n{}\n\nRepair output:\n{}",
                        output, repair_output
                    );
                    decision = Some(repaired_decision);
                }
                Ok(None) => {
                    record_agent_stage(
                        store,
                        app,
                        run,
                        "planner_repair_ignored",
                        json!({"iteration": iteration + 1}),
                    )?;
                }
                Err(err) => {
                    record_agent_stage(
                        store,
                        app,
                        run,
                        "planner_repair_failed",
                        json!({"iteration": iteration + 1, "error": err.to_string()}),
                    )?;
                }
            }
        }

        let route_status = if error.is_some() {
            "failed"
        } else if decision.is_some() {
            "completed"
        } else {
            "ignored"
        };

        store.append_tool_router_trace(ToolRouterTraceRecord {
            id: new_id("router"),
            created_at: now_iso(),
            conversation_id: conversation.id.clone(),
            persona_id: persona.id.clone(),
            agent_id: agent.id.clone(),
            semantic_intent: decision
                .as_ref()
                .and_then(|d| d.get("intent").and_then(Value::as_str))
                .unwrap_or("unknown")
                .to_string(),
            user_request: user_request.to_string(),
            prompt: planner_prompt,
            output: output.clone(),
            decision: decision.clone(),
            status: route_status.into(),
            error: error.clone(),
        })?;
        record_agent_stage(
            store,
            app,
            run,
            "planner_decision",
            json!({
                "iteration": iteration + 1,
                "status": route_status,
                "decision": decision,
                "error": error,
                "outputPreview": truncate_for_prompt(&output, 1200),
            }),
        )?;

        let Some(decision) = decision else {
            let parsed_step = if error.is_some() { "planner_failed" } else { "planner_invalid_json" };
            let reason = error
                .clone()
                .unwrap_or_else(|| "planner did not return a JSON object".to_string());
            record_agent_halt(
                store,
                run,
                conversation,
                persona,
                agent,
                HaltRecord {
                    iteration,
                    input: user_request,
                    output,
                    parsed_step,
                    error: Some(reason.clone()),
                    checkpoint_state: parsed_step,
                    checkpoint_summary: format!("Planner stopped: {reason}"),
                },
            )?;
            if observations.is_empty() {
                return Ok(None);
            }
            break;
        };

        let action = planner_action(&decision);
        let use_tool = decision
            .get("useTool")
            .or_else(|| decision.get("use_tool"))
            .and_then(Value::as_bool)
            .unwrap_or_else(|| planner_tool_name(&decision).is_some() || planner_tool_calls_array(&decision).is_some());
        if planner_action_is_final(&action) || (!use_tool && action.is_empty()) {
            if observations.is_empty() {
                return Ok(None);
            }
            break;
        }
        if !use_tool && !planner_action_is_tool(&action) {
            if observations.is_empty() {
                return Ok(None);
            }
            break;
        }

        let planned_requests = planned_tool_requests(&decision);
        if planned_requests.len() > 1 {
            let config = store.config()?;
            if config.chat.tool_parallel_enabled {
                if let Some(batch_observations) = try_execute_parallel_tool_batch(
                    store,
                    conversation,
                    run,
                    &available_tools,
                    &mut guardrails,
                    &mut tool_messages,
                    &planned_requests,
                    iteration,
                    config.chat.tool_parallel_limit,
                    &config.chat.tool_approval_mode,
                    &config.chat.trusted_tool_patterns,
                    config.chat.tool_call_retry_count,
                    config.chat.tool_call_retry_backoff_ms,
                    persist_tool_messages,
                    app,
                )
                .await?
                {
                    record_agent_stage(
                        store,
                        app,
                        run,
                        "tool_batch_completed",
                        json!({"iteration": iteration + 1, "observationCount": batch_observations.len()}),
                    )?;
                    observations.extend(batch_observations);
                    continue;
                }
            }
        }

        let tool_name = planned_requests
            .first()
            .map(|request| request.tool_name.as_str())
            .unwrap_or_else(|| decision.get("tool").and_then(Value::as_str).unwrap_or("").trim());
        let Some(tool) = resolve_tool(tool_name, &available_tools) else {
            record_agent_halt(
                store,
                run,
                conversation,
                persona,
                agent,
                HaltRecord {
                    iteration,
                    input: user_request,
                    output,
                    parsed_step: "tool_not_found",
                    error: Some(format!("planner selected unavailable tool: {tool_name}")),
                    checkpoint_state: "tool_not_found",
                    checkpoint_summary: format!("Planner selected unavailable tool: {tool_name}"),
                },
            )?;
            if observations.is_empty() {
                return Ok(None);
            }
            break;
        };

        let arguments = planned_requests
            .first()
            .map(|request| request.arguments.clone())
            .unwrap_or_else(|| decision.get("arguments").cloned().unwrap_or_else(|| json!({})));
        let mut call_payload = tool_payload_for_definition(store, &tool, arguments.clone())?;
        if tool.source == "internal"
            && matches!(
                tool.tool_name.as_str(),
                "read_file" | "search_files" | "write_file" | "patch"
            )
            && call_payload.get("workspaceDir").is_none()
            && call_payload.get("workspace_dir").is_none()
            && call_payload.get("cwd").is_none()
            && call_payload.get("root").is_none()
            && !agent.workspace_dir.trim().is_empty()
        {
            call_payload["workspaceDir"] = json!(agent.workspace_dir.clone());
        }
        let call_signature = format!("{}.{}:{}", tool.server_id, tool.tool_name, compact_json(&arguments));
        if let Some(decision) = guardrails.before_call(&tool.tool_name, &call_signature) {
            record_agent_halt(
                store,
                run,
                conversation,
                persona,
                agent,
                HaltRecord {
                    iteration,
                    input: user_request,
                    output,
                    parsed_step: decision.code,
                    error: Some(decision.message.clone()),
                    checkpoint_state: "tool_guardrail_blocked",
                    checkpoint_summary: decision.message.clone(),
                },
            )?;
            observations.push(format!(
                "Iteration {}: tool guardrail {}; action={}; count={}; message={}",
                iteration + 1,
                decision.code,
                decision.action,
                decision.count,
                decision.message
            ));
            break;
        }

        if let Some(hardline_reason) = tool_hardline_block_reason(&tool, &call_payload) {
            let message = format!(
                "Tool call blocked by hardline safety policy: {}.{}; {}",
                tool.server_id, tool.tool_name, hardline_reason
            );
            record_agent_halt(
                store,
                run,
                conversation,
                persona,
                agent,
                HaltRecord {
                    iteration,
                    input: user_request,
                    output,
                    parsed_step: "tool_hardline_blocked",
                    error: Some(message.clone()),
                    checkpoint_state: "tool_hardline_blocked",
                    checkpoint_summary: message.clone(),
                },
            )?;
            observations.push(format!("Iteration {}: {message}", iteration + 1));
            break;
        }

        if let Some(runtime_approval_reason) = tool_approval_reason_for_policy(
            &tool,
            &call_payload,
            &chat_config.tool_approval_mode,
            &chat_config.trusted_tool_patterns,
        ) {
            if !persist_tool_messages {
                let reason = merge_approval_reasons(
                    decision
                        .get("reason")
                        .and_then(Value::as_str)
                        .unwrap_or("Tool requires approval before execution."),
                    &runtime_approval_reason,
                );
                record_agent_halt(
                    store,
                    run,
                    conversation,
                    persona,
                    agent,
                    HaltRecord {
                        iteration,
                        input: user_request,
                        output,
                        parsed_step: "subagent_approval_blocked",
                        error: Some(reason.clone()),
                        checkpoint_state: "subagent_approval_blocked",
                        checkpoint_summary: format!(
                            "Subagent tool call blocked by approval policy: {}.{}",
                            tool.server_id, tool.tool_name
                        ),
                    },
                )?;
                let assistant = ChatMessage::new(
                    conversation.id.clone(),
                    "assistant",
                    format!(
                        "子智能体无法进行交互式工具审批，已停止调用 {}.{}。原因：{}",
                        tool.server_id, tool.tool_name, reason
                    ),
                    "desktop-stream",
                );
                return Ok(Some(AgentTurn::WithTools {
                    tool_messages,
                    assistant,
                    prompt_tokens,
                    completion_tokens,
                    run_state: Some("failed".into()),
                }));
            }
            record_agent_stage(
                store,
                app,
                run,
                "approval_required",
                json!({"iteration": iteration + 1, "tool": format!("{}.{}", tool.server_id, tool.tool_name)}),
            )?;
            let approval = store.append_tool_approval(ToolApprovalRequest {
                id: new_id("approval"),
                created_at: now_iso(),
                updated_at: now_iso(),
                status: "pending".into(),
                conversation_id: Some(conversation.id.clone()),
                persona_id: Some(persona.id.clone()),
                agent_id: Some(agent.id.clone()),
                run_id: Some(run.run_id.clone()),
                server_id: tool.server_id.clone(),
                tool_name: tool.tool_name.clone(),
                payload: call_payload.clone(),
                reason: merge_approval_reasons(
                    decision
                    .get("reason")
                    .and_then(Value::as_str)
                    .unwrap_or("Tool requires approval before execution."),
                    &runtime_approval_reason,
                ),
                result: None,
                error: None,
            })?;
            store.append_planner_trace(PlannerTraceRecord {
                id: new_id("planner"),
                run_id: run.run_id.clone(),
                conversation_id: conversation.id.clone(),
                persona_id: persona.id.clone(),
                agent_id: agent.id.clone(),
                iteration,
                created_at: now_iso(),
                input: user_request.to_string(),
                output,
                parsed_step: format!("approval_required {}.{}", tool.server_id, tool.tool_name),
                error: None,
            })?;

            let mut event = ToolEvent {
                status: Some("pendingApproval".into()),
                reference_id: Some(approval.id.clone()),
                call_id: None,
                run_id: Some(run.run_id.clone()),
                checkpoint_id: None,
                event_type: "tool_approval".into(),
                server_id: tool.server_id.clone(),
                tool_name: tool.tool_name.clone(),
                ok: false,
                timed_out: false,
                elapsed_ms: 0,
                title: format!("等待审批 · {}.{}", tool.server_id, tool.tool_name),
                summary: format!("工具调用需要审批：{}", approval.reason),
                path: None,
                exists: None,
                mime_type: None,
                text: Some(approval.payload.to_string()),
                error: None,
                raw: Some(json!({"approvalId": approval.id, "status": "pending"})),
            };
            let checkpoint_id = push_run_checkpoint(
                run,
                iteration + 1,
                "approval_required",
                format!("Approval required for {}.{}", tool.server_id, tool.tool_name),
                tool_event_call_ids(&event),
                tool_event_refs(&event),
            );
            event.checkpoint_id = Some(checkpoint_id);
            store.append_tool_trace(ToolTraceEntry {
                id: new_id("trace"),
                created_at: now_iso(),
                server_id: tool.server_id.clone(),
                tool_name: tool.tool_name.clone(),
                ok: false,
                timed_out: false,
                elapsed_ms: 0,
                payload: call_payload,
                event: event.clone(),
                error: None,
            })?;
            run.tool_events.push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));
            let tool_message = ChatMessage::new(
                conversation.id.clone(),
                "tool",
                json!({"type": "toolEvent", "event": event}).to_string(),
                "desktop",
            );
            store.append_message(tool_message.clone())?;
            emit_agent_run_event(app, run, "pendingApproval", None, Some(&event), None);
            tool_messages.push(tool_message);
            let assistant = ChatMessage::new(
                conversation.id.clone(),
                "assistant",
                "这个工具调用需要审批，已暂停执行。请在工具审批列表中批准或拒绝后再继续。".into(),
                "desktop",
            );
            store.append_message(assistant.clone())?;
            return Ok(Some(AgentTurn::WithTools {
                tool_messages,
                assistant,
                prompt_tokens,
                completion_tokens,
                run_state: Some("pendingApproval".into()),
            }));
        }

        if tool.source == "internal" && tool.tool_name == "clarify" {
            store.append_planner_trace(PlannerTraceRecord {
                id: new_id("planner"),
                run_id: run.run_id.clone(),
                conversation_id: conversation.id.clone(),
                persona_id: persona.id.clone(),
                agent_id: agent.id.clone(),
                iteration,
                created_at: now_iso(),
                input: user_request.to_string(),
                output: output.clone(),
                parsed_step: "clarify".into(),
                error: None,
            })?;
            let question = call_payload
                .get("question")
                .and_then(Value::as_str)
                .unwrap_or("需要补充什么信息？")
                .trim()
                .to_string();
            let mut event = ToolEvent {
                status: Some("needsClarification".into()),
                reference_id: Some(format!("clarify-{}", iteration + 1)),
                call_id: Some(new_id("call")),
                run_id: Some(run.run_id.clone()),
                checkpoint_id: None,
                event_type: "internal_clarify".into(),
                server_id: "__internal".into(),
                tool_name: "clarify".into(),
                ok: true,
                timed_out: false,
                elapsed_ms: 0,
                title: "Clarify".into(),
                summary: truncate_for_prompt(&question, 180),
                path: None,
                exists: None,
                mime_type: None,
                text: Some(question.clone()),
                error: None,
                raw: Some(json!({"question": question.clone(), "payload": call_payload})),
            };
            let checkpoint_id = push_run_checkpoint(
                run,
                iteration + 1,
                "needsClarification",
                "Agent asked the user for missing information.",
                tool_event_call_ids(&event),
                tool_event_refs(&event),
            );
            event.checkpoint_id = Some(checkpoint_id);
            store.append_tool_trace(ToolTraceEntry {
                id: new_id("trace"),
                created_at: now_iso(),
                server_id: "__internal".into(),
                tool_name: "clarify".into(),
                ok: true,
                timed_out: false,
                elapsed_ms: 0,
                payload: call_payload,
                event: event.clone(),
                error: None,
            })?;
            run.tool_events.push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));
            let tool_message = ChatMessage::new(
                conversation.id.clone(),
                "tool",
                json!({"type": "toolEvent", "event": event}).to_string(),
                "desktop",
            );
            store.append_message(tool_message.clone())?;
            emit_agent_run_event(app, run, "needsClarification", None, Some(&event), None);
            tool_messages.push(tool_message);
            let assistant = ChatMessage::new(conversation.id.clone(), "assistant", question, "desktop");
            store.append_message(assistant.clone())?;
            return Ok(Some(AgentTurn::WithTools {
                tool_messages,
                assistant,
                prompt_tokens,
                completion_tokens,
                run_state: Some("needsClarification".into()),
            }));
        }

        if tool.source == "internal" && tool.tool_name == "cronjob" {
            store.append_planner_trace(PlannerTraceRecord {
                id: new_id("planner"),
                run_id: run.run_id.clone(),
                conversation_id: conversation.id.clone(),
                persona_id: persona.id.clone(),
                agent_id: agent.id.clone(),
                iteration,
                created_at: now_iso(),
                input: user_request.to_string(),
                output: output.clone(),
                parsed_step: "cronjob".into(),
                error: None,
            })?;
            let (text, raw) = execute_internal_cronjob(store, conversation, persona, &call_payload, app)?;
            let mut event = ToolEvent {
                status: Some("completed".into()),
                reference_id: raw.get("jobId").and_then(Value::as_str).map(str::to_string).or_else(|| Some(format!("cronjob-{}", iteration + 1))),
                call_id: Some(new_id("call")),
                run_id: Some(run.run_id.clone()),
                checkpoint_id: None,
                event_type: "internal_cronjob".into(),
                server_id: "__internal".into(),
                tool_name: "cronjob".into(),
                ok: true,
                timed_out: false,
                elapsed_ms: 0,
                title: "Cronjob".into(),
                summary: truncate_for_prompt(&text, 180),
                path: None,
                exists: None,
                mime_type: None,
                text: Some(text.clone()),
                error: None,
                raw: Some(raw),
            };
            let checkpoint_id = push_run_checkpoint(
                run,
                iteration + 1,
                "tool_completed",
                "Managed scheduled agent job.",
                tool_event_call_ids(&event),
                tool_event_refs(&event),
            );
            event.checkpoint_id = Some(checkpoint_id);
            store.append_tool_trace(ToolTraceEntry {
                id: new_id("trace"),
                created_at: now_iso(),
                server_id: "__internal".into(),
                tool_name: "cronjob".into(),
                ok: true,
                timed_out: false,
                elapsed_ms: 0,
                payload: call_payload,
                event: event.clone(),
                error: None,
            })?;
            run.tool_events.push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));
            let tool_message = ChatMessage::new(
                conversation.id.clone(),
                "tool",
                json!({"type": "toolEvent", "event": event}).to_string(),
                "desktop",
            );
            record_tool_message(
                store,
                &mut tool_messages,
                tool_message,
                persist_tool_messages,
            )?;
            emit_agent_run_event(app, run, "running", None, Some(&event), None);
            observations.push(format!(
                "Iteration {}: cronjob result; remainingBudget={}; result={}",
                iteration + 1,
                budget.remaining(),
                truncate_for_prompt(&text, 1600),
            ));
            continue;
        }

        if tool.source == "internal" && tool.tool_name == "session_search" {
            store.append_planner_trace(PlannerTraceRecord {
                id: new_id("planner"),
                run_id: run.run_id.clone(),
                conversation_id: conversation.id.clone(),
                persona_id: persona.id.clone(),
                agent_id: agent.id.clone(),
                iteration,
                created_at: now_iso(),
                input: user_request.to_string(),
                output: output.clone(),
                parsed_step: "session_search".into(),
                error: None,
            })?;
            let (text, raw) = execute_internal_session_search(store, conversation, &call_payload)?;
            let mut event = ToolEvent {
                status: Some("completed".into()),
                reference_id: Some(format!("session-search-{}", iteration + 1)),
                call_id: Some(new_id("call")),
                run_id: Some(run.run_id.clone()),
                checkpoint_id: None,
                event_type: "internal_session_search".into(),
                server_id: "__internal".into(),
                tool_name: "session_search".into(),
                ok: true,
                timed_out: false,
                elapsed_ms: 0,
                title: "Session Search".into(),
                summary: truncate_for_prompt(&text, 180),
                path: None,
                exists: None,
                mime_type: None,
                text: Some(text.clone()),
                error: None,
                raw: Some(raw),
            };
            let checkpoint_id = push_run_checkpoint(
                run,
                iteration + 1,
                "tool_completed",
                "Searched current session history.",
                tool_event_call_ids(&event),
                tool_event_refs(&event),
            );
            event.checkpoint_id = Some(checkpoint_id);
            store.append_tool_trace(ToolTraceEntry {
                id: new_id("trace"),
                created_at: now_iso(),
                server_id: "__internal".into(),
                tool_name: "session_search".into(),
                ok: true,
                timed_out: false,
                elapsed_ms: 0,
                payload: call_payload,
                event: event.clone(),
                error: None,
            })?;
            run.tool_events.push(serde_json::to_value(&event).unwrap_or_else(|_| json!({})));
            let tool_message = ChatMessage::new(
                conversation.id.clone(),
                "tool",
                json!({"type": "toolEvent", "event": event}).to_string(),
                "desktop",
            );
            record_tool_message(
                store,
                &mut tool_messages,
                tool_message,
                persist_tool_messages,
            )?;
            emit_agent_run_event(app, run, "running", None, Some(&event), None);
            observations.push(format!(
                "Iteration {}: session_search result; remainingBudget={}; result={}",
                iteration + 1,
                budget.remaining(),
                truncate_for_prompt(&text, 2400),
            ));
            continue;
        }

        if tool.source == "internal" && tool.tool_name == "web_search" {
            store.append_planner_trace(PlannerTraceRecord {
                id: new_id("planner"),
                run_id: run.run_id.clone(),
                conversation_id: conversation.id.clone(),
                persona_id: persona.id.clone(),
                agent_id: agent.id.clone(),
                iteration,
                created_at: now_iso(),
                input: user_request.to_string(),
                output: output.clone(),
                parsed_step: "web_search".into(),
                error: None,
            })?;
            let started = Instant::now();
            let (text, raw, ok) = execute_internal_web_search(store, &call_payload).await?;
            let elapsed_ms = started.elapsed().as_millis();
            let mut event = ToolEvent {
                status: Some("completed".into()),
                reference_id: Some(format!("web-search-{}", iteration + 1)),
                call_id: Some(new_id("call")),
                run_id: Some(run.run_id.clone()),
