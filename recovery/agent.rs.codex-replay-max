            "stdout:\n{}\n\nstderr:\n{}\n\nerror: {}",
            call_result.stdout,
            call_result.stderr,
            call_result.error.as_deref().unwrap_or("")
        )),
        error: call_result.error.clone(),
        raw: Some(json!({
            "payload": payload,
            "stdout": call_result.stdout,
            "stderr": call_result.stderr,
            "error": call_result.error,
            "timedOut": call_result.timed_out,
