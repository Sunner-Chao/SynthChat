fn matching_worldbook_blocks(store: &AppStore, persona: &Persona, user_request: &str) -> AppResult<Vec<String>> {
    let request = user_request.to_lowercase();
    let mut blocks = Vec::new();
    for book in store.static_list("worldbooks")? {
        let bound = book.get("boundPersonas").and_then(Value::as_array).cloned().unwrap_or_default();
        let applies_to_persona = bound.is_empty()
            || bound
                .iter()
                .filter_map(Value::as_str)
                .any(|id| id == persona.id);
        if !applies_to_persona {
            continue;
        }

        let book_name = book.get("name").and_then(Value::as_str).unwrap_or("Worldbook");
        let Some(sections) = book.get("sections").and_then(Value::as_array) else {
            continue;
        };
        for section in sections {
            if !section.get("enabled").and_then(Value::as_bool).unwrap_or(true) {
                continue;
            }
            let key = section.get("key").and_then(Value::as_str).unwrap_or("").trim();
            let content = section.get("content").and_then(Value::as_str).unwrap_or("").trim();
            if content.is_empty() {
                continue;
            }
            let key_matches = key.is_empty() || request.contains(&key.to_lowercase());
            if key_matches {
                blocks.push(format!("- [{} / {}] {}", book_name, if key.is_empty() { "general" } else { key }, content));
            }
        }
    }
    Ok(blocks)
}

#[allow(dead_code)]
fn context_token_estimate(messages: &[ChatMessage]) -> usize {
    messages.iter().map(|m| estimate_tokens(&m.content)).sum()
}

async fn prepare_short_context(
    store: &AppStore,
    conversation: &Conversation,
    persona: &Persona,
    provider: &LlmProvider,
    messages: &[ChatMessage],
    max_context_rounds: usize,
    token_budget: usize,
    mode: &str,
) -> AppResult<ShortContextState> {
    let mut state = store.short_context(&conversation.id)?;
    let mode = mode.trim().to_lowercase();
    if mode == "off" || mode == "disabled" || mode == "none" {
        return Ok(state);
    }

    let recent_limit = max_context_rounds.max(1) * 2 + 1;
    if messages.len() <= recent_limit + 2 || context_token_estimate(messages) <= token_budget.max(1) {
        return Ok(state);
    }

    let older_count = messages.len().saturating_sub(recent_limit);
    let Some(boundary_message) = messages.get(older_count.saturating_sub(1)) else {
        return Ok(state);
    };
    if state.boundary_id.as_deref() == Some(boundary_message.id.as_str()) {
        return Ok(state);
    }

    let start = state
        .boundary_id
        .as_deref()
        .and_then(|id| messages.iter().position(|message| message.id == id))
        .map(|idx| idx + 1)
        .unwrap_or(0);
    if start >= older_count {
        return Ok(state);
    }

    let transcript = render_messages_for_summary(&messages[start..older_count]);
    let summary = if provider.provider_type == "echo" || provider.base_url.trim().is_empty() {
        fallback_short_context_summary(state.summary.as_str(), &transcript, token_budget)
    } else {
        summarize_short_context(store, provider, persona, state.summary.as_str(), &transcript, token_budget).await?
    };

    state.boundary_id = Some(boundary_message.id.clone());
    state.summary_tokens = estimate_tokens(&summary);
    state.summary_messages = older_count;
    state.summary = summary;
    store.save_short_context(state)
}

fn context_window_messages(
    messages: &[ChatMessage],
    short_context: &ShortContextState,
    limit: usize,
) -> Vec<ChatMessage> {
    let mut start = short_context
        .boundary_id
        .as_deref()
        .and_then(|id| messages.iter().position(|message| message.id == id))
        .map(|idx| idx + 1)
        .unwrap_or(0);
    if messages.len().saturating_sub(start) > limit {
        start = messages.len().saturating_sub(limit);
    }
    messages[start..].to_vec()
}

fn render_messages_for_summary(messages: &[ChatMessage]) -> String {
    messages
        .iter()
        .filter(|message| message.role == "user" || message.role == "assistant" || message.role == "tool")
        .map(|message| {
            let content = compact_text(&message.content, 2400);
            format!("[{} at {}] {}", message.role, message.created_at, content)
        })
        .collect::<Vec<_>>()
        .join("\n")
}

async fn summarize_short_context(
    store: &AppStore,
    provider: &LlmProvider,
    persona: &Persona,
    previous_summary: &str,
    transcript: &str,
    token_budget: usize,
) -> AppResult<String> {
    let target_tokens = (token_budget / 4).clamp(500, 2400);
    let system_prompt = [
        "You compress chat history for an agent runtime.",
        "Preserve durable facts, user goals, decisions, constraints, tool outcomes, unresolved blockers, and file/path references.",
        "Remove pleasantries and duplicated details. Do not invent facts.",
    ].join("\n");
    let user_prompt = format!(
        "Update the rolling summary using the new transcript.\n\nTarget maximum: about {target_tokens} tokens.\n\nPrevious summary:\n{}\n\nNew transcript:\n{}\n\nReturn only the updated summary.",
        if previous_summary.trim().is_empty() { "(none)" } else { previous_summary.trim() },
        transcript
    );
    let reply = complete_text_prompt_with_failover(store, provider, persona, system_prompt, user_prompt).await?;
    Ok(compact_text(reply.content.trim(), token_budget.max(500) * 5))
}

fn fallback_short_context_summary(previous_summary: &str, transcript: &str, token_budget: usize) -> String {
    let mut parts = Vec::new();
    if !previous_summary.trim().is_empty() {
        parts.push(previous_summary.trim().to_string());
    }
    if !transcript.trim().is_empty() {
        parts.push(format!("Recent compressed transcript:\n{}", transcript.trim()));
    }
    compact_text(&parts.join("\n\n"), token_budget.max(500) * 4)
}

fn compact_text(value: &str, max_chars: usize) -> String {
    let trimmed = value.trim();
    if trimmed.chars().count() <= max_chars {
        return trimmed.to_string();
    }
    let keep = max_chars.saturating_sub(80).max(1);
    let mut output: String = trimmed.chars().take(keep).collect();
    output.push_str("\n[truncated during context compression]");
    output
}

fn tool_approval_risk_reason(tool: &ToolDefinition, payload: &Value) -> Option<String> {
    if tool.requires_approval {
        return Some("工具定义标记 requiresApproval=true。".into());
    }
    if tool.source == "internal" && tool.tool_name == "web_request" {
        let method = web_request_method(payload);
        if !matches!(method.as_str(), "GET" | "HEAD" | "OPTIONS") {
            return Some(format!("web_request 使用 {method} 方法，可能提交或修改远端状态。"));
        }
    }

    let tool_text = format!(
        "{} {} {}",
        tool.name.to_lowercase(),
        tool.display_name.to_lowercase(),
        tool.description.to_lowercase()
    );
    if contains_any(&tool_text, &["snapshot", "list", "read", "get", "search", "query", "find", "inspect"]) {
        return None;
    }

    if contains_any(
        &tool_text,
        &["shell", "terminal", "exec", "execute", "command", "delete", "remove", "write", "patch", "deploy", "payment"],
    ) {
        return Some("工具名称或描述包含执行、写入、删除、部署或支付等高风险语义。".into());
    }

    payload_risk_reason(payload, "$")
}

fn tool_hardline_block_reason(tool: &ToolDefinition, payload: &Value) -> Option<String> {
    let tool_text = format!(
        "{} {} {} {}",
        tool.server_id.to_lowercase(),
        tool.tool_name.to_lowercase(),
        tool.name.to_lowercase(),
        tool.description.to_lowercase()
    );
    let execute_like = contains_any(
        &tool_text,
        &["shell", "terminal", "exec", "execute", "command", "script"],
    ) || payload_contains_key(payload, &["command", "cmd", "script", "shell"]);
    if execute_like {
        if let Some(reason) = payload_command_hardline_reason(payload, "$") {
            return Some(reason);
        }
    }
    let write_like = contains_any(
        &tool_text,
        &["write", "patch", "delete", "remove", "edit"],
    ) || payload_contains_key(
        payload,
        &["write", "patch", "delete", "remove", "edit", "target", "path"],
    );
    if write_like {
        if let Some(reason) = payload_sensitive_path_hardline_reason(payload, "$") {
            return Some(reason);
        }
    }
    None
}

fn tool_call_requires_approval_for_policy(
    tool: &ToolDefinition,
    payload: &Value,
    mode: &str,
    trusted_patterns: &[String],
) -> bool {
    tool_approval_reason_for_policy(tool, payload, mode, trusted_patterns).is_some()
}

fn tool_call_may_mutate_state(tool: &ToolDefinition, payload: &Value) -> bool {
    let kind = tool_event_kind(&tool.server_id, &tool.tool_name, Some(&tool.description));
    match kind.as_str() {
        "edit" => true,
        "read" | "search" | "fetch" | "think" => false,
        _ => tool_approval_risk_reason(tool, payload).is_some(),
    }
}

fn maybe_checkpoint_before_tool_mutation(
    store: &AppStore,
    run: &mut AgentRunRecord,
    iteration: u32,
    tool: &ToolDefinition,
    payload: &Value,
) -> AppResult<Option<Value>> {
    if !store.config()?.chat.tool_mutation_checkpoint_enabled
        || !tool_call_may_mutate_state(tool, payload)
    {
        return Ok(None);
    }
    let label = format!(
        "pre-tool {}.{} run={} iteration={}",
        tool.server_id,
        tool.tool_name,
        run.run_id,
        iteration + 1
    );
    let state_snapshot = store.create_state_snapshot(&label)?;
    let workspace_root = workspace_root_for_tool_payload(payload);
    let workspace_snapshot = store.create_workspace_snapshot(&label, &workspace_root)?;
    let state_snapshot_id = state_snapshot
        .get("id")
        .and_then(Value::as_str)
        .unwrap_or("unknown")
        .to_string();
    let workspace_snapshot_id = workspace_snapshot
        .get("id")
        .and_then(Value::as_str)
        .unwrap_or("unknown")
        .to_string();
    push_run_checkpoint(
        run,
        iteration + 1,
        "pre_tool_mutation_checkpoint",
        format!(
            "Created state snapshot {state_snapshot_id} and workspace snapshot {workspace_snapshot_id} before calling {}.{}.",
            tool.server_id, tool.tool_name
        ),
        Vec::new(),
        vec![
            format!("stateSnapshot:{state_snapshot_id}"),
            format!("workspaceSnapshot:{workspace_snapshot_id}"),
        ],
    );
    Ok(Some(json!({
        "state": state_snapshot,
        "workspace": workspace_snapshot,
    })))
}

fn attach_pre_tool_checkpoint(event: &mut ToolEvent, snapshot: Option<Value>) {
    let Some(snapshot) = snapshot else {
        return;
    };
    let metadata = json!({ "preToolStateSnapshot": snapshot });
    match event.raw.take() {
        Some(Value::Object(mut map)) => {
            map.insert("synthchatCheckpoint".into(), metadata);
            event.raw = Some(Value::Object(map));
        }
        Some(raw) => {
            event.raw = Some(json!({
                "result": raw,
                "synthchatCheckpoint": metadata,
            }));
        }
        None => {
            event.raw = Some(json!({
                "synthchatCheckpoint": metadata,
            }));
        }
    }
}

fn workspace_root_for_tool_payload(payload: &Value) -> PathBuf {
    find_workspace_root_candidate(payload)
        .or_else(|| std::env::current_dir().ok())
        .unwrap_or_else(|| PathBuf::from("."))
}

fn find_workspace_root_candidate(value: &Value) -> Option<PathBuf> {
    match value {
        Value::Object(map) => {
            for key in ["cwd", "workdir", "workingDir", "working_dir", "root", "workspace"] {
                if let Some(path) = map
                    .get(key)
                    .and_then(Value::as_str)
                    .map(str::trim)
                    .filter(|path| !path.is_empty())
                {
                    let candidate = PathBuf::from(path);
                    return Some(if candidate.is_file() {
                        candidate
                            .parent()
                            .map(PathBuf::from)
                            .unwrap_or(candidate)
                    } else {
                        candidate
                    });
                }
            }
            for key in ["path", "file", "filePath", "file_path", "target", "targetPath"] {
                if let Some(path) = map
                    .get(key)
                    .and_then(Value::as_str)
                    .map(str::trim)
                    .filter(|path| !path.is_empty())
                {
                    let candidate = PathBuf::from(path);
                    if candidate.is_absolute() {
                        return Some(
                            candidate
                                .parent()
                                .map(PathBuf::from)
                                .unwrap_or(candidate),
                        );
                    }
                }
            }
            map.values().find_map(find_workspace_root_candidate)
        }
        Value::Array(items) => items.iter().find_map(find_workspace_root_candidate),
        _ => None,
    }
}

fn tool_approval_reason_for_policy(
    tool: &ToolDefinition,
    payload: &Value,
    mode: &str,
    trusted_patterns: &[String],
) -> Option<String> {
    if trusted_tool_pattern_matches(tool, trusted_patterns) {
        return None;
    }
    match mode.trim().to_lowercase().as_str() {
        "never" | "allow" | "auto_allow" => None,
        "always" | "strict" => Some("当前审批模式要求所有工具调用先审批。".into()),
        _ => tool_approval_risk_reason(tool, payload),
    }
}

fn trusted_tool_pattern_matches(tool: &ToolDefinition, trusted_patterns: &[String]) -> bool {
    let exact = format!("{}.{}", tool.server_id, tool.tool_name);
    let server_wildcard = format!("{}.*", tool.server_id);
    trusted_patterns.iter().any(|pattern| {
        let pattern = pattern.trim();
        pattern == exact || pattern == server_wildcard || pattern == "*"
    })
}

fn payload_risk_reason(value: &Value, path: &str) -> Option<String> {
    match value {
        Value::Object(map) => {
            for (key, value) in map {
                let lower_key = key.to_lowercase();
                let child_path = format!("{path}.{key}");
                if lower_key == "method" {
                    if let Some(method) = value.as_str().map(|method| method.trim().to_uppercase()) {
                        if !matches!(method.as_str(), "GET" | "HEAD" | "OPTIONS") {
                            return Some(format!("{child_path} 使用非只读 HTTP 方法 {method}。"));
                        }
                    }
                }
                if matches!(lower_key.as_str(), "command" | "cmd" | "script" | "shell") {
                    if value.as_str().map(|v| !v.trim().is_empty()).unwrap_or(false) {
                        return Some(format!("{child_path} 包含可执行命令或脚本。"));
                    }
                }
                if contains_any(&lower_key, &["delete", "remove", "write", "patch", "submit", "send", "deploy", "payment"]) {
                    return Some(format!("{child_path} 字段名包含写入、提交、发送、删除、部署或支付语义。"));
                }
                if let Some(reason) = payload_risk_reason(value, &child_path) {
                    return Some(reason);
                }
            }
            None
        }
        Value::Array(items) => items
            .iter()
            .enumerate()
            .find_map(|(index, item)| payload_risk_reason(item, &format!("{path}[{index}]"))),
        Value::String(text) => {
            let lower = text.to_lowercase();
            if contains_any(&lower, &["rm -rf", "del /", "format ", "shutdown", "reboot", "git reset --hard"]) {
                Some(format!("{path} 包含高风险命令片段。"))
            } else {
                None
            }
        }
        _ => None,
    }
}

fn payload_contains_key(value: &Value, keys: &[&str]) -> bool {
    match value {
        Value::Object(map) => map.iter().any(|(key, value)| {
            let lower_key = key.to_lowercase();
            keys.iter().any(|candidate| lower_key.contains(candidate))
                || payload_contains_key(value, keys)
        }),
        Value::Array(items) => items.iter().any(|item| payload_contains_key(item, keys)),
        _ => false,
    }
}

fn payload_command_hardline_reason(value: &Value, path: &str) -> Option<String> {
    match value {
        Value::Object(map) => {
            for (key, value) in map {
                let lower_key = key.to_lowercase();
                let child_path = format!("{path}.{key}");
                if matches!(lower_key.as_str(), "command" | "cmd" | "script" | "shell") {
                    if let Some(text) = value.as_str() {
                        if let Some(reason) = command_hardline_reason(text) {
                            return Some(format!("{child_path} {reason}"));
                        }
                    }
                }
                if let Some(reason) = payload_command_hardline_reason(value, &child_path) {
                    return Some(reason);
                }
            }
            None
        }
        Value::Array(items) => items.iter().enumerate().find_map(|(index, item)| {
            payload_command_hardline_reason(item, &format!("{path}[{index}]"))
        }),
        _ => None,
    }
}

fn payload_sensitive_path_hardline_reason(value: &Value, path: &str) -> Option<String> {
    match value {
        Value::Object(map) => {
            for (key, value) in map {
                let lower_key = key.to_lowercase();
                let child_path = format!("{path}.{key}");
                let path_like = contains_any(
                    &lower_key,
                    &["path", "file", "target", "dest", "destination"],
                );
                if path_like {
                    if let Some(text) = value.as_str() {
                        if let Some(reason) = sensitive_path_hardline_reason(text) {
                            return Some(format!("{child_path} {reason}"));
                        }
                    }
                }
                if let Some(reason) = payload_sensitive_path_hardline_reason(value, &child_path) {
                    return Some(reason);
                }
            }
            None
        }
        Value::Array(items) => items.iter().enumerate().find_map(|(index, item)| {
            payload_sensitive_path_hardline_reason(item, &format!("{path}[{index}]"))
        }),
        _ => None,
    }
}

fn command_hardline_reason(command: &str) -> Option<String> {
    let normalized = command.to_lowercase().replace('\\', "/");
    if contains_any(
        &normalized,
        &[
            "rm -rf /",
            "rm -fr /",
            "rm -rf ~",
            "rm -fr ~",
            "mkfs",
            "format c:",
            "shutdown",
            "reboot",
            "poweroff",
            "halt",
            "kill -9 -1",
            "kill -1",
            ":(){:|:&};:",
        ],
    ) {
        return Some("命中不可绕过的灾难性命令阻断规则。".into());
    }
    if normalized.contains("dd ") && normalized.contains("of=/dev/") {
        return Some("命中不可绕过的块设备写入阻断规则。".into());
    }
    None
}

fn sensitive_path_hardline_reason(path: &str) -> Option<String> {
    let normalized = path.to_lowercase().replace('\\', "/");
    if normalized == "/"
        || normalized.starts_with("/etc/")
        || normalized.starts_with("/boot/")
        || normalized.starts_with("/dev/")
        || normalized.contains("/.ssh/")
        || normalized.ends_with("/.ssh")
    {
        return Some("命中不可绕过的敏感路径写入阻断规则。".into());
    }
    None
}

fn contains_any(value: &str, needles: &[&str]) -> bool {
    needles.iter().any(|needle| value.contains(needle))
}

fn merge_approval_reasons(planner_reason: &str, runtime_reason: &str) -> String {
    let planner_reason = planner_reason.trim();
    let runtime_reason = runtime_reason.trim();
    if planner_reason.is_empty() || planner_reason == "Tool requires approval before execution." {
        return runtime_reason.to_string();
    }
    if runtime_reason.is_empty() || planner_reason.contains(runtime_reason) {
        return planner_reason.to_string();
    }
    format!("{planner_reason} Runtime risk: {runtime_reason}")
}

fn memory_relevance_score(summary: &str, query: &str) -> u32 {
    let summary = summary.to_lowercase();
    let query = query.to_lowercase();
    if query.trim().is_empty() {
        return 0;
    }
    let mut score = 0u32;
    if summary.contains(query.trim()) {
        score += 10;
    }
    for token in query.split_whitespace().filter(|token| token.chars().count() >= 2) {
        if summary.contains(token) {
            score += 1;
        }
    }
    score
}

