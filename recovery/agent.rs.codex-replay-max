}

fn extract_html_title(html: &str) -> String {
    let lower = html.to_lowercase();
    let Some(start) = lower.find("<title") else {
        return String::new();
    };
    let Some(open_end_rel) = lower[start..].find('>') else {
        return String::new();
    };
    let open_end = start + open_end_rel + 1;
    let Some(end_rel) = lower[open_end..].find("</title>") else {
        return String::new();
    };
    html_to_text(&html[open_end..open_end + end_rel])
}

fn attr_value(tag: &str, name: &str) -> Option<String> {
    let lower = tag.to_lowercase();
    let needle = format!("{}=", name.to_lowercase());
    let index = lower.find(&needle)?;
    let value_start = index + needle.len();
    let bytes = tag.as_bytes();
    let quote = *bytes.get(value_start)? as char;
    if quote == '"' || quote == '\'' {
        let rest = &tag[value_start + 1..];
        let end = rest.find(quote)?;
        Some(html_unescape(&rest[..end]))
    } else {
        let rest = &tag[value_start..];
        let end = rest
            .find(|ch: char| ch.is_whitespace() || ch == '>')
            .unwrap_or(rest.len());
        Some(html_unescape(&rest[..end]))
    }
}

fn has_boolean_attr(tag: &str, name: &str) -> bool {
    let lower = tag.to_lowercase();
    let assignment = format!("{name}=");
    lower
        .split(|ch: char| ch.is_whitespace() || ch == '<' || ch == '>' || ch == '/')
        .any(|part| part == name || part.starts_with(&assignment))
}

fn effective_static_base_url(page_url: &str, html: &str) -> String {
    let lower = html.to_lowercase();
    let mut offset = 0usize;
    while let Some(start_rel) = lower[offset..].find("<base") {
        let start = offset + start_rel;
        let Some(end_rel) = lower[start..].find('>') else {
            break;
        };
        let tag = &html[start..start + end_rel + 1];
        if let Some(href) = attr_value(tag, "href") {
            if !href.trim().is_empty() {
                return resolve_url(page_url, &href);
            }
        }
        offset = start + end_rel + 1;
    }
    page_url.to_string()
}

fn infer_request_method(snippet: &str) -> String {
    let lower = snippet.to_lowercase();
    for method in ["post", "put", "patch", "delete", "get"] {
        for pattern in [
            format!("method: '{method}'"),
            format!("method:\"{method}\""),
            format!("method: \"{method}\""),
            format!("method:'{method}'"),
            format!("method={method}"),
            format!("open('{method}'"),
            format!("open(\"{method}\""),
        ] {
            if lower.contains(&pattern) {
                return method.to_uppercase();
            }
        }
    }
    "GET".into()
}

fn infer_request_url(snippet: &str) -> Option<String> {
    let lower = snippet.to_lowercase();
    for marker in ["fetch(", ".open("] {
        let Some(index) = lower.find(marker) else {
            continue;
        };
        let rest = &snippet[index + marker.len()..];
        if marker == ".open(" {
            let (_, after_method) = extract_quoted(rest)?;
            let Some(comma) = after_method.find(',') else {
                continue;
            };
            let (url, _) = extract_quoted(&after_method[comma + 1..])?;
            return Some(url);
        }
        let (url, _) = extract_quoted(rest)?;
        return Some(url);
    }
    None
}

fn extract_quoted(input: &str) -> Option<(String, &str)> {
    let trimmed = input.trim_start();
    let quote = trimmed.chars().next()?;
    if quote != '\'' && quote != '"' {
        return None;
    }
    let rest = &trimmed[quote.len_utf8()..];
    let end = rest.find(quote)?;
    Some((html_unescape(&rest[..end]), &rest[end + quote.len_utf8()..]))
}

fn resolve_url(base_url: &str, raw_url: &str) -> String {
    let raw = raw_url.trim();
    if raw.is_empty()
        || raw.starts_with("http://")
        || raw.starts_with("https://")
        || raw.starts_with("data:")
        || raw.starts_with("mailto:")
        || raw.starts_with('#')
    {
        return raw.to_string();
    }
    let base = base_url.trim();
    if base.is_empty() {
        return raw.to_string();
    }
    if let Ok(base) = reqwest::Url::parse(base) {
        if let Ok(url) = base.join(raw) {
            return url.to_string();
        }
    }
    let Some((scheme, rest)) = base.split_once("://") else {
        return raw.to_string();
    };
    if raw.starts_with("//") {
        return format!("{scheme}:{raw}");
    }
    let host_end = rest.find('/').unwrap_or(rest.len());
    let origin = format!("{}://{}", scheme, &rest[..host_end]);
    if raw.starts_with('/') {
        return format!("{origin}{raw}");
    }
    let path = if host_end < rest.len() {
        &rest[host_end..]
    } else {
        "/"
    };
    let dir = path.rsplit_once('/').map(|(dir, _)| dir).unwrap_or("");
    if dir.is_empty() {
        format!("{origin}/{raw}")
    } else {
        format!("{origin}{dir}/{raw}")
    }
}

async fn execute_internal_image_generate(
    store: &AppStore,
    run_id: &str,
    payload: &Value,
) -> AppResult<(String, Value, bool)> {
    let provider = store
        .enabled_image_provider()?
        .ok_or_else(|| AppError::BadRequest("no enabled image provider".into()))?;
    let prompt = payload
        .get("prompt")
        .and_then(Value::as_str)
        .unwrap_or("")
        .trim();
    if prompt.is_empty() {
        return Ok((
            "image_generate requires prompt.".into(),
            json!({"ok": false, "error": "prompt required"}),
            false,
        ));
    }
    if provider.provider_type != "openai_image" {
        return Ok((
            format!(
                "image_generate provider type '{}' is not implemented by the internal tool yet.",
                provider.provider_type
            ),
            json!({
                "ok": false,
                "providerId": provider.id,
                "providerType": provider.provider_type,
                "error": "provider type not implemented"
            }),
            false,
        ));
    }
    let size = payload
        .get("size")
        .or_else(|| payload.get("image_size"))
        .and_then(Value::as_str)
        .unwrap_or("1024x1024")
        .trim();
    let result = call_openai_image_provider(&provider, prompt, size).await?;
    let path = store.save_tool_binary_artifact(run_id, "image_generate", &result.extension, &result.bytes)?;
    let text = format!(
        "Generated image artifact: {} ({} bytes)",
        path.display(),
        result.bytes.len()
    );
    Ok((
        text,
        json!({
            "ok": true,
            "providerId": provider.id,
            "providerType": provider.provider_type,
            "model": provider.model,
            "prompt": prompt,
            "size": size,
            "artifactPath": path.to_string_lossy().to_string(),
            "mimeType": result.mime_type,
            "bytes": result.bytes.len(),
            "source": result.source,
            "response": result.raw,
        }),
        true,
    ))
}

struct GeneratedImage {
    bytes: Vec<u8>,
    mime_type: String,
    extension: String,
    source: String,
    raw: Value,
}

async fn call_openai_image_provider(
    provider: &ImageProvider,
    prompt: &str,
    size: &str,
) -> AppResult<GeneratedImage> {
    let url = image_generation_url(provider);
    let mut headers = HeaderMap::new();
    headers.insert(CONTENT_TYPE, HeaderValue::from_static("application/json"));
    if let Some(key) = image_provider_api_key(provider) {
        let value = HeaderValue::from_str(&format!("Bearer {key}"))
            .map_err(|err| AppError::Llm(format!("invalid image auth header: {err}")))?;
        headers.insert(AUTHORIZATION, value);
    }
    let body = json!({
        "model": provider.model,
        "prompt": prompt,
        "size": size,
        "n": 1
    });
    let client = reqwest::Client::builder()
        .timeout(Duration::from_secs(provider.timeout_seconds.max(1)))
        .default_headers(headers)
        .build()
        .map_err(|err| AppError::Llm(err.to_string()))?;
    let response = client
        .post(&url)
        .json(&body)
        .send()
        .await
        .map_err(|err| AppError::Llm(err.to_string()))?;
    let status = response.status();
    let text = response
        .text()
        .await
        .map_err(|err| AppError::Llm(format!("failed to read image response: {err}")))?;
    if !status.is_success() {
        return Err(AppError::Llm(format!(
            "image provider returned {status}: {}",
            truncate_for_prompt(&text, 600)
        )));
    }
    let payload: Value = serde_json::from_str(&text).map_err(|err| {
        AppError::Llm(format!(
            "invalid image response: {err}; body: {}",
            truncate_for_prompt(&text, 600)
        ))
    })?;
    let first = payload
        .get("data")
        .and_then(Value::as_array)
        .and_then(|items| items.first())
        .ok_or_else(|| AppError::Llm(format!("image response missing data: {payload}")))?;
    if let Some(b64) = first.get("b64_json").and_then(Value::as_str) {
        let bytes = BASE64_STANDARD
            .decode(b64)
            .map_err(|err| AppError::Llm(format!("invalid generated image base64: {err}")))?;
        return Ok(GeneratedImage {
            bytes,
            mime_type: "image/png".into(),
            extension: "png".into(),
            source: "b64_json".into(),
            raw: payload,
        });
    }
    let image_url = first
        .get("url")
        .and_then(Value::as_str)
        .ok_or_else(|| AppError::Llm(format!("image response missing url/b64_json: {payload}")))?;
    let bytes = download_bytes(image_url, provider.timeout_seconds).await?;
    let extension = image_extension_from_url(image_url);
    Ok(GeneratedImage {
        bytes,
        mime_type: format!("image/{extension}"),
        extension,
        source: image_url.to_string(),
        raw: payload,
    })
}

async fn download_bytes(url: &str, timeout_seconds: u64) -> AppResult<Vec<u8>> {
    let client = reqwest::Client::builder()
        .timeout(Duration::from_secs(timeout_seconds.max(1)))
        .user_agent("SynthChat-Agent/1.0")
        .build()
        .map_err(|err| AppError::BadRequest(err.to_string()))?;
    let response = client
        .get(url)
        .send()
        .await
        .map_err(|err| AppError::BadRequest(err.to_string()))?;
    let status = response.status();
    if !status.is_success() {
        return Err(AppError::BadRequest(format!(
            "GET image {url} returned {status}"
        )));
    }
    let bytes = response
        .bytes()
        .await
        .map_err(|err| AppError::BadRequest(format!("failed to read image bytes: {err}")))?;
    Ok(bytes.to_vec())
}

fn image_generation_url(provider: &ImageProvider) -> String {
    let base = provider.base_url.trim().trim_end_matches('/');
    if base.ends_with("/images/generations") {
        base.to_string()
    } else if base.ends_with("/v1") {
        format!("{base}/images/generations")
    } else {
        format!("{base}/v1/images/generations")
    }
}

fn image_extension_from_url(url: &str) -> String {
    let path = url.split('?').next().unwrap_or(url).to_lowercase();
    if path.ends_with(".jpg") || path.ends_with(".jpeg") {
        "jpeg".into()
    } else if path.ends_with(".webp") {
        "webp".into()
    } else {
        "png".into()
    }
}

fn image_provider_api_key(provider: &ImageProvider) -> Option<String> {
    provider
        .api_key
        .as_deref()
        .map(str::trim)
        .filter(|value| !value.is_empty())
        .map(str::to_string)
        .or_else(|| {
            let key = provider.api_key_env.trim();
            if key.is_empty() {
                None
            } else {
                std::env::var(key).ok().filter(|value| !value.trim().is_empty())
            }
        })
}

async fn execute_internal_web_search(
    store: &AppStore,
    payload: &Value,
) -> AppResult<(String, Value, bool)> {
    let provider = store
        .enabled_search_provider()?
        .ok_or_else(|| AppError::BadRequest("no enabled search provider".into()))?;
    let query = payload
        .get("query")
        .and_then(Value::as_str)
        .unwrap_or("")
        .trim();
    if query.is_empty() {
        return Ok((
            "web_search requires query.".into(),
            json!({"ok": false, "error": "query required"}),
            false,
        ));
    }
    let limit = payload
        .get("limit")
        .and_then(Value::as_u64)
        .unwrap_or(5)
        .clamp(1, 10) as usize;
    let results = if provider.provider_type == "duckduckgo_html" {
        search_duckduckgo_html(&provider, query, limit).await?
    } else {
        search_searxng(&provider, query, limit).await?
    };
    let ok = !results.is_empty();
    let text = if ok {
        results
            .iter()
            .enumerate()
            .map(|(index, item)| {
                format!(
                    "{}. {}\n   url: {}\n   snippet: {}",
                    index + 1,
                    item.title,
                    item.url,
                    item.snippet
                )
            })
            .collect::<Vec<_>>()
            .join("\n")
    } else {
        "No search results returned.".into()
    };
    Ok((
        text,
        json!({
            "ok": ok,
            "providerId": provider.id,
            "providerType": provider.provider_type,
            "query": query,
            "limit": limit,
            "results": results.iter().map(|item| json!({
                "title": item.title,
                "url": item.url,
                "snippet": item.snippet,
            })).collect::<Vec<_>>()
        }),
        ok,
    ))
}

#[derive(Debug, Clone)]
struct WebSearchResult {
    title: String,
    url: String,
    snippet: String,
}

async fn search_searxng(
    provider: &SearchProvider,
    query: &str,
    limit: usize,
) -> AppResult<Vec<WebSearchResult>> {
    let base = provider.base_url.trim().trim_end_matches('/');
    let url = format!(
        "{base}/search?q={}&format=json&language=auto&safesearch=0",
        url_encode(query)
    );
    let payload = get_json_with_timeout(&url, provider.timeout_seconds).await?;
    let results = payload
        .get("results")
        .and_then(Value::as_array)
        .cloned()
        .unwrap_or_default()
        .into_iter()
        .filter_map(|item| {
            let url = item
                .get("url")
                .or_else(|| item.get("link"))
                .and_then(Value::as_str)?
                .trim()
                .to_string();
            if url.is_empty() {
                return None;
            }
            Some(WebSearchResult {
                title: item
                    .get("title")
                    .and_then(Value::as_str)
                    .unwrap_or(&url)
                    .trim()
                    .to_string(),
                url,
                snippet: item
                    .get("content")
                    .or_else(|| item.get("snippet"))
                    .and_then(Value::as_str)
                    .unwrap_or("")
                    .trim()
                    .to_string(),
            })
        })
        .take(limit)
        .collect();
    Ok(results)
}

async fn search_duckduckgo_html(
    provider: &SearchProvider,
    query: &str,
    limit: usize,
) -> AppResult<Vec<WebSearchResult>> {
    let base = provider
        .base_url
        .trim()
        .trim_end_matches('/')
        .trim_end_matches("/html")
        .trim_end_matches("/html/");
    let base = if base.is_empty() {
        "https://duckduckgo.com"
    } else {
        base
    };
    let url = format!("{base}/html/?q={}", url_encode(query));
    let html = get_text_with_timeout(&url, provider.timeout_seconds).await?;
    Ok(extract_duckduckgo_results(&html, limit))
}

async fn execute_internal_web_extract(payload: &Value) -> AppResult<(String, Value, bool)> {
    let mut urls = Vec::new();
    if let Some(url) = payload.get("url").and_then(Value::as_str) {
        urls.push(url.trim().to_string());
    }
    if let Some(items) = payload.get("urls").and_then(Value::as_array) {
        for item in items {
            if let Some(url) = item.as_str().map(str::trim).filter(|value| !value.is_empty()) {
                urls.push(url.to_string());
            }
        }
    }
    urls.sort();
    urls.dedup();
    urls.retain(|url| url.starts_with("http://") || url.starts_with("https://"));
    if urls.is_empty() {
        return Ok((
            "web_extract requires at least one HTTP(S) URL.".into(),
            json!({"ok": false, "error": "url required"}),
            false,
        ));
    }
    let max_chars = payload
        .get("maxChars")
        .or_else(|| payload.get("max_chars"))
        .and_then(Value::as_u64)
        .unwrap_or(6000)
        .clamp(500, 20000) as usize;
    let mut rows = Vec::new();
    for url in urls.iter().take(5) {
        let fetched = get_text_with_timeout(url, 20).await;
        let row = match fetched {
            Ok(body) => {
                let extracted = html_to_text(&body);
                json!({
                    "url": url,
                    "ok": true,
                    "content": truncate_for_prompt(&extracted, max_chars)
                })
            }
            Err(error) => json!({
                "url": url,
                "ok": false,
                "error": error.to_string()
            }),
        };
        rows.push(row);
    }
    let ok = rows
        .iter()
        .any(|row| row.get("ok").and_then(Value::as_bool).unwrap_or(false));
    let text = rows
        .iter()
        .map(|row| {
            let url = row.get("url").and_then(Value::as_str).unwrap_or("-");
            if row.get("ok").and_then(Value::as_bool).unwrap_or(false) {
                format!(
                    "URL: {url}\n{}",
                    row.get("content").and_then(Value::as_str).unwrap_or("")
                )
            } else {
                format!(
                    "URL: {url}\nERROR: {}",
                    row.get("error").and_then(Value::as_str).unwrap_or("failed")
                )
            }
        })
        .collect::<Vec<_>>()
        .join("\n\n---\n\n");
    Ok((text, json!({"ok": ok, "results": rows}), ok))
}

async fn execute_internal_web_request(payload: &Value) -> AppResult<(String, Value, bool)> {
    let url = payload
        .get("url")
        .or_else(|| payload.get("endpoint"))
        .and_then(Value::as_str)
        .unwrap_or("")
        .trim();
    if !(url.starts_with("http://") || url.starts_with("https://")) {
        return Ok((
            "web_request requires an HTTP(S) url.".into(),
            json!({"ok": false, "error": "HTTP(S) url required"}),
            false,
        ));
    }
    let method = web_request_method(payload);
    let timeout_secs = payload
        .get("timeoutSeconds")
        .or_else(|| payload.get("timeout_seconds"))
        .and_then(Value::as_u64)
        .unwrap_or(30)
        .clamp(1, 120);
    let max_chars = payload
        .get("maxChars")
        .or_else(|| payload.get("max_chars"))
        .and_then(Value::as_u64)
        .unwrap_or(8000)
        .clamp(500, 50000) as usize;
    let client = reqwest::Client::builder()
        .timeout(Duration::from_secs(timeout_secs))
        .user_agent("SynthChat-Agent/1.0")
        .build()
        .map_err(|err| AppError::BadRequest(err.to_string()))?;
    let method_value = reqwest::Method::from_bytes(method.as_bytes())
        .map_err(|err| AppError::BadRequest(format!("invalid HTTP method {method}: {err}")))?;
    let mut request = client.request(method_value, url);
    if let Some(headers) = payload.get("headers").and_then(Value::as_object) {
        for (key, value) in headers {
            if let Some(value) = value.as_str() {
                request = request.header(key, value);
            }
        }
    }
    if let Some(json_body) = payload.get("json") {
        request = request.json(json_body);
    } else if let Some(form) = payload.get("form").and_then(Value::as_object) {
        let form = form
            .iter()
            .map(|(key, value)| {
                (
                    key.clone(),
                    value
                        .as_str()
                        .map(str::to_string)
                        .unwrap_or_else(|| value.to_string()),
                )
            })
            .collect::<Vec<_>>();
        request = request.form(&form);
    } else if let Some(body) = payload.get("body").and_then(Value::as_str) {
        request = request.body(body.to_string());
    }
    let response = request
        .send()
        .await
        .map_err(|err| AppError::BadRequest(format!("web_request failed: {err}")))?;
    let status = response.status();
    let content_type = response
        .headers()
        .get(CONTENT_TYPE)
        .and_then(|value| value.to_str().ok())
        .unwrap_or("")
        .to_string();
    let body = response.text().await.map_err(|err| {
        AppError::BadRequest(format!("failed to read web_request response: {err}"))
    })?;
    let body_preview = truncate_for_prompt(&body, max_chars);
    let ok = status.is_success();
    let text = format!(
        "{} {url} -> {status}\ncontentType: {}\n\n{}",
        method,
        if content_type.is_empty() {
            "-"
        } else {
            content_type.as_str()
        },
        body_preview
    );
    Ok((
        text,
        json!({
            "ok": ok,
            "method": method,
            "url": url,
            "status": status.as_u16(),
            "contentType": content_type,
            "bodyPreview": body_preview,
            "bodyChars": body.chars().count(),
        }),
        ok,
    ))
}

fn web_request_method(payload: &Value) -> String {
    payload
        .get("method")
        .and_then(Value::as_str)
        .unwrap_or("GET")
        .trim()
        .to_uppercase()
}

async fn get_json_with_timeout(url: &str, timeout_seconds: u64) -> AppResult<Value> {
    let text = get_text_with_timeout(url, timeout_seconds).await?;
    serde_json::from_str(&text).map_err(|err| {
        AppError::BadRequest(format!(
            "invalid JSON from {url}: {err}; body: {}",
            truncate_for_prompt(&text, 400)
        ))
    })
}

async fn get_text_with_timeout(url: &str, timeout_seconds: u64) -> AppResult<String> {
    let client = reqwest::Client::builder()
        .timeout(Duration::from_secs(timeout_seconds.max(1)))
        .user_agent("SynthChat-Agent/1.0")
        .build()
        .map_err(|err| AppError::BadRequest(err.to_string()))?;
    let response = client
        .get(url)
        .send()
        .await
        .map_err(|err| AppError::BadRequest(err.to_string()))?;
    let status = response.status();
    let text = response
        .text()
        .await
        .map_err(|err| AppError::BadRequest(format!("failed to read response: {err}")))?;
    if !status.is_success() {
        return Err(AppError::BadRequest(format!(
            "GET {url} returned {status}: {}",
            truncate_for_prompt(&text, 400)
        )));
    }
    Ok(text)
}

fn extract_duckduckgo_results(html: &str, limit: usize) -> Vec<WebSearchResult> {
    let mut results = Vec::new();
    let mut rest = html;
    while let Some(index) = rest.find("result__a") {
        rest = &rest[index..];
        let Some(href_index) = rest.find("href=\"") else {
            break;
        };
        let href_start = href_index + "href=\"".len();
        let Some(href_end) = rest[href_start..].find('"') else {
            break;
        };
        let url = html_unescape(&rest[href_start..href_start + href_end]);
        let Some(text_start) = rest[href_start + href_end..].find('>') else {
            break;
        };
        let title_start = href_start + href_end + text_start + 1;
        let Some(title_end) = rest[title_start..].find("</a>") else {
            break;
        };
        let title = html_to_text(&rest[title_start..title_start + title_end]);
        if !url.is_empty() && !title.is_empty() {
            results.push(WebSearchResult {
                title,
                url,
                snippet: String::new(),
            });
        }
        if results.len() >= limit {
            break;
        }
        rest = &rest[title_start + title_end..];
    }
    results
}

fn html_to_text(input: &str) -> String {
    let mut output = String::with_capacity(input.len().min(8192));
    let mut in_tag = false;
    let mut last_space = false;
    for ch in input.chars() {
        match ch {
            '<' => in_tag = true,
            '>' => {
                in_tag = false;
                if !last_space {
                    output.push(' ');
                    last_space = true;
                }
            }
            _ if in_tag => {}
            _ if ch.is_whitespace() => {
                if !last_space {
                    output.push(' ');
                    last_space = true;
                }
            }
            _ => {
                output.push(ch);
                last_space = false;
            }
        }
    }
    html_unescape(output.trim())
}

fn html_unescape(input: &str) -> String {
    input
        .replace("&amp;", "&")
        .replace("&lt;", "<")
        .replace("&gt;", ">")
        .replace("&quot;", "\"")
        .replace("&#39;", "'")
        .replace("&nbsp;", " ")
}

fn url_encode(input: &str) -> String {
    let mut encoded = String::new();
    for byte in input.bytes() {
        match byte {
            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' | b'~' => {
                encoded.push(byte as char)
            }
            b' ' => encoded.push('+'),
            _ => encoded.push_str(&format!("%{byte:02X}")),
        }
    }
    encoded
}

async fn execute_internal_vision_analyze(
    store: &AppStore,
    payload: &Value,
) -> AppResult<(String, Value, bool)> {
    let provider = store
        .enabled_vision_provider()?
        .ok_or_else(|| AppError::BadRequest("no enabled vision provider".into()))?;
    let image_url = payload
        .get("image_url")
        .or_else(|| payload.get("imageUrl"))
        .or_else(|| payload.get("path"))
        .or_else(|| payload.get("imagePath"))
        .and_then(Value::as_str)
        .unwrap_or("")
        .trim();
    if image_url.is_empty() {
        return Ok((
            "vision_analyze requires image_url or path.".into(),
            json!({"ok": false, "error": "image_url required"}),
            false,
        ));
    }
    let question = payload
        .get("question")
        .or_else(|| payload.get("prompt"))
        .and_then(Value::as_str)
        .unwrap_or("Describe the image and extract any visible text.")
        .trim();
    let question = if question.is_empty() {
        "Describe the image and extract any visible text."
    } else {
        question
    };
    let resolved = resolve_vision_image(image_url)?;
    let response = if provider.provider_type.eq_ignore_ascii_case("ollama") {
        call_ollama_vision_provider(&provider, question, &resolved.base64).await?
    } else {
        call_openai_compatible_vision_provider(&provider, question, &resolved.data_url).await?
    };
    let text = if response.text.trim().is_empty() {
        "Vision provider returned no text.".into()
    } else {
        response.text
    };
    let ok = !text.starts_with("Vision provider returned no text.");
    Ok((
        text,
        json!({
            "ok": ok,
            "providerId": provider.id,
            "providerType": provider.provider_type,
            "model": provider.model,
            "imageUrl": image_url,
            "mimeType": resolved.mime_type,
            "localFileExists": resolved.local_file_exists,
            "bytes": resolved.bytes_len,
            "response": response.raw,
        }),
        ok,
    ))
}

struct ResolvedVisionImage {
    data_url: String,
    base64: String,
    mime_type: String,
    bytes_len: usize,
    local_file_exists: Option<bool>,
}

struct VisionProviderResponse {
    text: String,
    raw: Value,
}

fn resolve_vision_image(image_url: &str) -> AppResult<ResolvedVisionImage> {
    if image_url.starts_with("data:image/") {
        let (header, b64) = image_url.split_once(',').unwrap_or((image_url, ""));
        let mime_type = header
            .strip_prefix("data:")
            .and_then(|value| value.split(';').next())
            .unwrap_or("image/png")
            .to_string();
        return Ok(ResolvedVisionImage {
            data_url: image_url.to_string(),
            base64: b64.to_string(),
            mime_type,
            bytes_len: b64.len(),
            local_file_exists: None,
        });
    }
    if image_url.starts_with("http://") || image_url.starts_with("https://") {
        return Ok(ResolvedVisionImage {
            data_url: image_url.to_string(),
            base64: String::new(),
            mime_type: "image/*".into(),
            bytes_len: 0,
            local_file_exists: None,
        });
    }
    let path = image_url
        .strip_prefix("file://")
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from(image_url));
    if !path.exists() {
        return Err(AppError::NotFound(format!(
            "vision image not found: {}",
            path.display()
        )));
    }
    let bytes = fs::read(&path)?;
    let mime_type = mime_type_for_image_path(&path);
    let base64 = BASE64_STANDARD.encode(&bytes);
    Ok(ResolvedVisionImage {
        data_url: format!("data:{mime_type};base64,{base64}"),
        base64,
        mime_type,
        bytes_len: bytes.len(),
        local_file_exists: Some(true),
    })
}

fn mime_type_for_image_path(path: &Path) -> String {
    match path
        .extension()
        .and_then(|value| value.to_str())
        .unwrap_or("")
        .to_lowercase()
        .as_str()
    {
        "jpg" | "jpeg" => "image/jpeg",
        "webp" => "image/webp",
        "gif" => "image/gif",
        "bmp" => "image/bmp",
        _ => "image/png",
    }
    .into()
}

async fn call_openai_compatible_vision_provider(
    provider: &VisionProvider,
    question: &str,
    image_url: &str,
) -> AppResult<VisionProviderResponse> {
    let url = vision_chat_url(provider);
    let mut headers = HeaderMap::new();
    headers.insert(CONTENT_TYPE, HeaderValue::from_static("application/json"));
    if let Some(key) = vision_provider_api_key(provider) {
        let value = HeaderValue::from_str(&format!("Bearer {key}"))
            .map_err(|err| AppError::Llm(format!("invalid vision auth header: {err}")))?;
        headers.insert(AUTHORIZATION, value);
    }
    let body = json!({
        "model": provider.model,
        "messages": [{
            "role": "user",
            "content": [
                {"type": "text", "text": question},
                {"type": "image_url", "image_url": {"url": image_url}}
            ]
        }],
        "temperature": 0.1,
        "max_tokens": 1200
    });
    let payload = post_vision_json(provider, &url, headers, &body).await?;
    let text = payload
        .pointer("/choices/0/message/content")
        .and_then(Value::as_str)
        .or_else(|| payload.pointer("/message/content").and_then(Value::as_str))
        .unwrap_or("")
        .trim()
        .to_string();
    Ok(VisionProviderResponse { text, raw: payload })
}

async fn call_ollama_vision_provider(
    provider: &VisionProvider,
    question: &str,
    image_base64: &str,
) -> AppResult<VisionProviderResponse> {
    if image_base64.is_empty() {
        return Err(AppError::BadRequest(
            "ollama vision requires a local image path or data URL".into(),
        ));
    }
    let url = ollama_vision_chat_url(provider);
    let headers = HeaderMap::new();
    let body = json!({
        "model": provider.model,
        "stream": false,
        "messages": [{
            "role": "user",
            "content": question,
            "images": [image_base64]
        }]
    });
    let payload = post_vision_json(provider, &url, headers, &body).await?;
    let text = payload
        .pointer("/message/content")
        .and_then(Value::as_str)
        .or_else(|| payload.get("response").and_then(Value::as_str))
        .unwrap_or("")
        .trim()
        .to_string();
    Ok(VisionProviderResponse { text, raw: payload })
}

async fn post_vision_json(
    provider: &VisionProvider,
    url: &str,
    headers: HeaderMap,
    body: &Value,
) -> AppResult<Value> {
    let client = reqwest::Client::builder()
        .timeout(Duration::from_secs(provider.timeout_seconds.max(1)))
        .default_headers(headers)
        .build()
        .map_err(|err| AppError::Llm(err.to_string()))?;
    let response = client
        .post(url)
        .json(body)
        .send()
        .await
        .map_err(|err| AppError::Llm(err.to_string()))?;
    let status = response.status();
    let text = response
        .text()
        .await
        .map_err(|err| AppError::Llm(format!("failed to read vision response: {err}")))?;
    if !status.is_success() {
        return Err(AppError::Llm(format!(
            "vision provider returned {status}: {}",
            truncate_for_prompt(&text, 600)
        )));
    }
    serde_json::from_str(&text).map_err(|err| {
        AppError::Llm(format!(
            "invalid vision response: {err}; body: {}",
            truncate_for_prompt(&text, 600)
        ))
    })
}

fn vision_chat_url(provider: &VisionProvider) -> String {
    let base = provider.base_url.trim().trim_end_matches('/');
    if base.ends_with("/chat/completions") {
        base.to_string()
    } else if base.ends_with("/v1") {
        format!("{base}/chat/completions")
    } else {
        format!("{base}/v1/chat/completions")
    }
}

