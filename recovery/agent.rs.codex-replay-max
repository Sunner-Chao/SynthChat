            break;
        };
        let tag_end = start + tag_end_rel + 1;
        let tag = &html[start..tag_end];
        if let Some(src) = attr_value(tag, "src") {
            scripts.push(json!({
                "kind": "script",
                "url": resolve_url(base_url, &src),
                "rawUrl": src,
            }));
        }
        if scripts.len() >= limit {
