fn execute_internal_manage_memory(
    store: &AppStore,
    persona: &Persona,
    payload: &Value,
) -> AppResult<(String, Value, bool)> {
    let action = payload
        .get("action")
        .and_then(Value::as_str)
        .unwrap_or("read")
        .trim()
        .to_lowercase();
    let limit = payload
        .get("limit")
        .and_then(Value::as_u64)
        .unwrap_or(8)
        .clamp(1, 20) as usize;
    let mut memories = store.memories(Some(&persona.id))?;
    match action.as_str() {
        "read" | "list" => {
            let query = payload
                .get("query")
                .and_then(Value::as_str)
                .unwrap_or("")
                .trim()
                .to_string();
            if !query.is_empty() {
                let mut scored = memories
                    .into_iter()
                    .filter_map(|memory| {
                        let score = memory_relevance_score(&memory.summary, &query);
                        (score > 0).then_some((score, memory))
                    })
                    .collect::<Vec<_>>();
                scored.sort_by(|(left_score, left), (right_score, right)| {
                    right_score
                        .cmp(left_score)
                        .then_with(|| right.importance.cmp(&left.importance))
                        .then_with(|| right.updated_at.cmp(&left.updated_at))
                });
                memories = scored
                    .into_iter()
                    .map(|(_, memory)| memory)
                    .collect::<Vec<_>>();
            }
            memories.truncate(limit);
            let text = if memories.is_empty() {
                if query.is_empty() {
                    "当前 persona 暂无长期记忆。".into()
                } else {
                    format!("没有匹配 `{}` 的长期记忆。", query)
                }
            } else {
                memories
                    .iter()
                    .map(|memory| {
                        format!("- {} [{}] {}", memory.id, memory.importance, memory.summary)
                    })
                    .collect::<Vec<_>>()
                    .join("\n")
            };
            Ok((
                text,
                json!({"action": "read", "query": query, "memories": memories}),
                true,
            ))
        }
        "add" => {
            let summary = payload
                .get("summary")
                .or_else(|| payload.get("content"))
                .and_then(Value::as_str)
                .unwrap_or("")
                .trim();
            if summary.is_empty() {
                return Ok((
                    "manage_memory add 需要 summary。".into(),
                    json!({"action": "add", "error": "summary required"}),
                    false,
                ));
            }
            let importance = payload
                .get("importance")
                .and_then(Value::as_u64)
                .unwrap_or(4)
                .clamp(1, 5) as u8;
            let memory = store.save_memory(crate::models::MemoryEntry {
                id: String::new(),
                persona_id: persona.id.clone(),
                summary: summary.to_string(),
                importance,
                created_at: String::new(),
                updated_at: String::new(),
            })?;
            Ok((
                format!(
                    "已新增长期记忆：{} [{}] {}",
                    memory.id, memory.importance, memory.summary
                ),
                json!({"action": "add", "memoryId": memory.id, "memory": memory}),
                true,
            ))
        }
        "replace" | "update" => {
            let id = payload
                .get("id")
                .or_else(|| payload.get("memoryId"))
                .and_then(Value::as_str)
                .unwrap_or("")
                .trim();
            let summary = payload
                .get("summary")
                .or_else(|| payload.get("content"))
                .and_then(Value::as_str)
                .unwrap_or("")
                .trim();
            let Some(existing) = memories.iter().find(|memory| memory.id == id) else {
                return Ok((
                    format!("未找到当前 persona 的长期记忆：{id}"),
                    json!({"action": "replace", "memoryId": id, "error": "memory not found"}),
                    false,
                ));
            };
            if summary.is_empty() {
                return Ok((
                    "manage_memory replace 需要 summary。".into(),
                    json!({"action": "replace", "memoryId": id, "error": "summary required"}),
                    false,
                ));
            }
            let importance = payload
                .get("importance")
                .and_then(Value::as_u64)
                .unwrap_or(existing.importance as u64)
                .clamp(1, 5) as u8;
            let memory = store.save_memory(crate::models::MemoryEntry {
                id: existing.id.clone(),
                persona_id: persona.id.clone(),
                summary: summary.to_string(),
                importance,
                created_at: existing.created_at.clone(),
                updated_at: String::new(),
            })?;
            Ok((
                format!(
                    "已替换长期记忆：{} [{}] {}",
                    memory.id, memory.importance, memory.summary
                ),
                json!({"action": "replace", "memoryId": memory.id, "memory": memory}),
                true,
            ))
        }
        "remove" | "delete" => {
            let id = payload
                .get("id")
                .or_else(|| payload.get("memoryId"))
                .and_then(Value::as_str)
                .unwrap_or("")
                .trim();
            let Some(existing) = memories.iter().find(|memory| memory.id == id) else {
                return Ok((
                    format!("未找到当前 persona 的长期记忆：{id}"),
                    json!({"action": "remove", "memoryId": id, "error": "memory not found"}),
                    false,
                ));
            };
            store.delete_memory(&existing.id)?;
            Ok((
                format!("已删除长期记忆：{} {}", existing.id, existing.summary),
                json!({"action": "remove", "memoryId": existing.id, "memory": existing}),
                true,
            ))
        }
        _ => Ok((
            "用法：manage_memory action=read|add|replace|remove".into(),
            json!({"action": action, "error": "unsupported action"}),
            false,
        )),
    }
}

