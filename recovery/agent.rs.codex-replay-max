fn record_agent_stage(
    store: &AppStore,
    app: Option<&AppHandle>,
    run: &mut AgentRunRecord,
    phase: &str,
    detail: Value,
) -> AppResult<()> {
    let created_at = now_iso();
    run.phase_events.push(AgentRunPhaseRecord {
        phase: phase.into(),
        detail: detail.clone(),
        updated_at: created_at.clone(),
    });
    if run.phase_events.len() > 200 {
        let extra = run.phase_events.len() - 200;
        run.phase_events.drain(0..extra);
    }
    run.updated_at = created_at;
    store.save_agent_run(run.clone())?;
    emit_agent_stage_event(app, run, phase, detail);
    Ok(())
}

fn build_system_prompt(
    conversation: &Conversation,
    persona: &Persona,
    memories: &[crate::models::MemoryEntry],
    skills: &[SkillPromptBlock],
    worldbooks: &[String],
    short_context: &ShortContextState,
) -> String {
    let mut parts = vec![
        persona.system_prompt.clone(),
        persona.system_instructions.clone(),
        "## Current Session Context".into(),
        "**Source:** SynthChat desktop (local machine)".into(),
        format!("**Conversation ID:** {}", conversation.id),
        format!("**Persona:** {}", persona.name),
        "Keep responses aligned with the persona and the user's latest request.".into(),
        build_environment_hints(),
        build_tool_behavior_guidance(),
    ];
    if !short_context.summary.trim().is_empty() {
        parts.push("## Compressed Conversation Context".into());
        parts.push(format!(
            "This is a rolling summary of earlier messages before the current context window:\n{}",
            short_context.summary.trim()
        ));
    }

    if !persona.character_prompt.trim().is_empty() {
        parts.push("## Character".into());
        parts.push(persona.character_prompt.clone());
    }
    if !persona.output_examples.trim().is_empty() {
        parts.push("## Output Examples".into());
        parts.push(persona.output_examples.clone());
    }
    if !memories.is_empty() {
        parts.push("## Long-term Memory".into());
        for memory in memories.iter().take(8) {
            parts.push(format!("- {}", memory.summary));
        }
    }
    if !worldbooks.is_empty() {
        parts.push("## Worldbook Context".into());
        parts.extend(worldbooks.iter().take(12).cloned());
    }
    if !skills.is_empty() {
        parts.push("## Active Skills".into());
        parts.push(
            "Follow these skill instructions when they are relevant to the user's latest request. Skill instructions are local capability guides, not user content.".into(),
        );
        for skill in skills {
            parts.push(format!("### Skill: {} ({})\n{}", skill.name, skill.id, skill.content));
        }
    }
    parts.join("\n\n")
}

async fn continue_approval_with_planner(
    store: &AppStore,
    conversation: &Conversation,
    persona: &Persona,
    agent: &AgentDefinition,
    run: &mut AgentRunRecord,
    tool: &ToolDefinition,
    event: &ToolEvent,
    call_result: &crate::models::McpCallResult,
    tool_message: ChatMessage,
    app: Option<&AppHandle>,
) -> AppResult<Option<AgentTurn>> {
    let config = store.config()?;
    let provider_id = selected_provider_id(persona, agent);
    let provider = store.provider(provider_id)?;
    let effective_persona = effective_llm_persona(persona, agent);
    let messages = store.messages(&conversation.id, None)?;
    let original_request = latest_user_request(&messages);
    let short_context = prepare_short_context(
        store,
        conversation,
        &effective_persona,
        &provider,
        &messages,
        config.chat.max_context_rounds,
        config.chat.short_context_token_budget,
        &config.chat.short_context_mode,
    )
    .await?;
    let history = context_window_messages(&messages, &short_context, config.chat.max_context_rounds * 2 + 1);
    let memories = prompt_memories(store, persona)?;
    let skill_blocks = skills::prompt_blocks_for_request(store, agent, &original_request)?;
    let worldbook_blocks = matching_worldbook_blocks(store, persona, &original_request)?;
    let system_prompt = build_system_prompt(
        conversation,
        persona,
        &memories,
        &skill_blocks,
        &worldbook_blocks,
        &short_context,
    );
    let observation = approved_tool_observation(tool, event, call_result);
    maybe_run_auto_tool(
        store,
        conversation,
        &effective_persona,
        agent,
        run,
        &provider,
        &system_prompt,
        &original_request,
        &history,
        vec![observation],
        vec![tool_message],
        app,
    )
    .await
}

async fn build_approval_resume_reply(
    store: &AppStore,
    conversation: &Conversation,
    persona: &Persona,
    agent: &AgentDefinition,
    tool: &ToolDefinition,
    event: &ToolEvent,
    call_result: &crate::models::McpCallResult,
) -> AppResult<crate::llm::LlmReply> {
    let config = store.config()?;
    let provider_id = if !persona.llm_provider.trim().is_empty() {
        Some(persona.llm_provider.as_str())
    } else if !agent.llm_provider.trim().is_empty() {
        Some(agent.llm_provider.as_str())
    } else {
        None
    };
    let provider = store.provider(provider_id)?;
    let messages = store.messages(&conversation.id, None)?;
    let original_request = latest_user_request(&messages);
    let short_context = prepare_short_context(
        store,
        conversation,
        persona,
        &provider,
        &messages,
        config.chat.max_context_rounds,
        config.chat.short_context_token_budget,
        &config.chat.short_context_mode,
    )
    .await?;
    let mut history = context_window_messages(&messages, &short_context, config.chat.max_context_rounds * 2 + 1);
    let tool_result_text = event
        .text
        .as_deref()
        .filter(|text| !text.trim().is_empty())
        .or(call_result.error.as_deref())
        .unwrap_or("");
    let resume_instruction = format!(
        "Resume the paused task after an approved tool call.\n\nOriginal user request:\n{}\n\nApproved tool: {}.{}\nTool status: ok={}, timedOut={}\nTool summary: {}\nTool result:\n{}\n\nUse the tool result as evidence and answer the original request. If the tool failed, explain the failure and the useful evidence.",
        original_request,
        tool.server_id,
        tool.tool_name,
        call_result.ok,
        call_result.timed_out,
        event.summary,
        compact_text(tool_result_text, 8000)
    );
    history.push(ChatMessage::new(conversation.id.clone(), "user", resume_instruction.clone(), "internal"));

    let memories = prompt_memories(store, persona)?;
    let skill_blocks = skills::prompt_blocks_for_request(store, agent, &original_request)?;
    let worldbook_blocks = matching_worldbook_blocks(store, persona, &original_request)?;
    let system_prompt = build_system_prompt(
        conversation,
        persona,
        &memories,
        &skill_blocks,
        &worldbook_blocks,
        &short_context,
    );
    complete_chat_with_failover(store, &provider, persona, system_prompt, history, &resume_instruction).await
}

fn latest_user_request(messages: &[ChatMessage]) -> String {
    messages
        .iter()
        .rev()
        .find(|message| message.role == "user")
        .map(|message| message.content.clone())
        .unwrap_or_else(|| "Continue the approved tool task.".into())
}

fn prompt_memories(store: &AppStore, persona: &Persona) -> AppResult<Vec<crate::models::MemoryEntry>> {
    if persona
        .memory
        .get("enabled")
        .and_then(Value::as_bool)
        .unwrap_or(true)
        && persona
            .memory
            .get("includeInPrompt")
            .and_then(Value::as_bool)
            .unwrap_or(true)
    {
        let max = persona.memory.get("maxMemories").and_then(Value::as_u64).unwrap_or(50) as usize;
        let mut items = store.memories(Some(&persona.id))?;
        items.retain(|memory| crate::store::scan_memory_content(&memory.summary).is_none());
        items.truncate(max.max(1));
        Ok(items)
    } else {
        Ok(vec![])
    }
}

fn approved_tool_observation(
    tool: &ToolDefinition,
    event: &ToolEvent,
    call_result: &crate::models::McpCallResult,
) -> String {
    let result_text = if !call_result.stdout.trim().is_empty() {
        call_result.stdout.as_str()
    } else if let Some(error) = call_result.error.as_deref() {
        error
    } else {
        call_result.stderr.as_str()
    };
    format!(
        "Approved tool result: called {}.{} after user approval; ok={}; timedOut={}; summary={}; result={}",
        tool.server_id,
        tool.tool_name,
        call_result.ok,
        call_result.timed_out,
        event.summary,
        truncate_for_prompt(result_text, 4000),
    )
}

pub(crate) async fn call_mcp_tool_with_retry(
    store: &AppStore,
    server_id: String,
    tool_name: String,
    payload: Value,
    timeout_seconds: Option<u64>,
    retry_count: usize,
    retry_backoff_ms: usize,
) -> AppResult<crate::models::McpCallResult> {
    let mut attempt = 0usize;
    loop {
        let result = mcp::call_tool(
            store,
            server_id.clone(),
            tool_name.clone(),
            payload.clone(),
            timeout_seconds,
        )
        .await;
        let retryable = match &result {
            Ok(call_result) => is_retryable_tool_result(call_result),
            Err(error) => is_retryable_error(&error.to_string()),
        };
        if !retryable || attempt >= retry_count {
            return result;
        }
        attempt += 1;
        if retry_backoff_ms > 0 {
            sleep(Duration::from_millis(retry_backoff_ms as u64 * attempt as u64)).await;
        }
    }
}

fn is_retryable_tool_result(result: &crate::models::McpCallResult) -> bool {
    result.timed_out
        || result
            .error
            .as_deref()
            .map(is_retryable_error)
            .unwrap_or(false)
}

fn is_retryable_error(message: &str) -> bool {
    let lower = message.to_lowercase();
    lower.contains("timed out")
        || lower.contains("timeout")
        || lower.contains("connection")
        || lower.contains("connect")
        || lower.contains("broken pipe")
        || lower.contains("temporarily unavailable")
        || lower.contains("would block")
}

fn resume_observations(run: &AgentRunRecord, checkpoint_id: Option<&str>) -> AppResult<Vec<String>> {
    let checkpoint = if let Some(id) = checkpoint_id {
        Some(
            run.checkpoints
                .iter()
                .find(|checkpoint| checkpoint.checkpoint_id == id)
                .ok_or_else(|| AppError::NotFound(format!("checkpoint {id}")))?,
        )
    } else {
        run.checkpoints.last()
    };

    let mut observations = Vec::new();
    observations.push(format!(
        "Resuming agent run {}; previousState={}; checkpoint={}; runError={}",
        run.run_id,
        run.state,
        checkpoint
            .map(|checkpoint| format!("{} [{}]: {}", checkpoint.checkpoint_id, checkpoint.state, checkpoint.summary))
            .unwrap_or_else(|| "(none)".into()),
        run.error.as_deref().unwrap_or("(none)")
    ));

    for event in run.tool_events.iter().rev().take(8).collect::<Vec<_>>().into_iter().rev() {
        let server_id = event.get("serverId").or_else(|| event.get("server_id")).and_then(Value::as_str).unwrap_or("");
        let tool_name = event.get("toolName").or_else(|| event.get("tool_name")).and_then(Value::as_str).unwrap_or("");
        let ok = event.get("ok").and_then(Value::as_bool).unwrap_or(false);
        let summary = event.get("summary").and_then(Value::as_str).unwrap_or("");
        let text = event.get("text").and_then(Value::as_str).unwrap_or("");
        let error = event.get("error").and_then(Value::as_str).unwrap_or("");
        observations.push(format!(
            "Prior tool event: {}.{} ok={}; summary={}; text={}; error={}",
            server_id,
            tool_name,
            ok,
            summary,
            truncate_for_prompt(text, 2000),
            truncate_for_prompt(error, 1000),
        ));
    }

    Ok(observations)
}

